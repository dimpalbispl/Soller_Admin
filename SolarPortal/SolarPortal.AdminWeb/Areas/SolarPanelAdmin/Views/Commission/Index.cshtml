@model IEnumerable<SolarPortal.Domain.Entities.Commission>
@{
    ViewData["Title"] = "INC Commission";
    var filter = ViewBag.Filter as string ?? "all";
    var totalPending = (decimal)(ViewBag.TotalPending ?? 0m);
    var totalPaid    = (decimal)(ViewBag.TotalPaid ?? 0m);
    var autoCreated  = (int)(ViewBag.AutoCreated ?? 0);
    var waitingCount = (int)(ViewBag.WaitingForRate ?? 0);
    var incWorkers = (ViewBag.IncWorkers as List<SolarPortal.Domain.Entities.Worker>)
                     ?? new List<SolarPortal.Domain.Entities.Worker>();
    var plans = (ViewBag.Plans as List<SolarPortal.Domain.Entities.SolarProject>)
                ?? new List<SolarPortal.Domain.Entities.SolarProject>();
    var planAmounts = (ViewBag.PlanAmounts as Dictionary<int, decimal>) ?? new Dictionary<int, decimal>();

    var ratedCount = plans.Count(p => planAmounts.ContainsKey(p.Id));
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>INC Commission</span></div>
        <div class="ph-title">📈 INC Commission Management</div>
    </div>

    <!-- Summary -->
    <div class="g4" style="margin-bottom:14px">
        <div class="sc">
            <div class="sc-label">Total Records</div>
            <div class="sc-val blue">@Model.Count()</div>
        </div>
        <div class="sc">
            <div class="sc-label">Pending Payout</div>
            <div class="sc-val red">₹@totalPending.ToString("N0")</div>
        </div>
        <div class="sc">
            <div class="sc-label">Total Paid</div>
            <div class="sc-val green">₹@totalPaid.ToString("N0")</div>
        </div>
        <div class="sc">
            <div class="sc-label">Plans With Commission</div>
            <div class="sc-val gold">@ratedCount / @plans.Count</div>
            <div class="sc-sub">Commission ₹ set on these plans</div>
        </div>
    </div>

    @Html.AntiForgeryToken()

    @if (autoCreated > 0)
    {
        <div class="alert alert-success">
            ✓ @autoCreated payout record(s) generated automatically — the plan's commission amount has been applied.
        </div>
    }
    @if (waitingCount > 0)
    {
        <div class="alert alert-warning">
            ⚠ @waitingCount assigned project(s) are waiting for a payout — their plan has no commission amount set yet
            (or they are not linked to any plan). Set that plan's commission below.
        </div>
    }

    <div class="mb-3" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">
        <div>
            <a class="btn @(filter == "all" ? "btn-primary" : "btn-outline-primary")" asp-route-filter="all">All</a>
            <a class="btn @(filter == "pending" ? "btn-warning" : "btn-outline-warning")" asp-route-filter="pending">Pending</a>
            <a class="btn @(filter == "paid" ? "btn-success" : "btn-outline-success")" asp-route-filter="paid">Paid</a>
        </div>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#planCommissionModal">
            ➕ Set Plan Commission
        </button>
    </div>

    @* ── Plan-wise commission amounts ──────────────────────────────────── *@
    <div class="card mb-3">
        <div class="ct" style="display:flex;align-items:center;gap:8px">
            <span class="ct-dot"></span>
            <span>Solar Project Commission (@ratedCount of @plans.Count set)</span>
            @* Collapsed by default — the rate table is a master list the admin
               only opens when changing an amount, and leaving it expanded made
               the page very long. Last state is remembered per browser. *@
            <button type="button" id="btnTogglePlans" class="btn btn-sm btn-outline-primary"
                    style="margin-left:auto">&#9656; Show</button>
        </div>
        <div id="plansWrap" class="tbl-wrap" style="display:none">
            <table class="table">
                <thead>
                    <tr>
                        <th>Solar Project</th>
                        <th>Capacity</th>
                        <th>Connection</th>
                        <th style="text-align:right">Project Amount</th>
                        <th style="text-align:right">Commission ₹ / project</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in plans)
                    {
                        var hasAmt = planAmounts.TryGetValue(p.Id, out var amt);
                        <tr>
                            <td class="td-b">@p.Name</td>
                            <td>@p.SolarTypeKV.ToString("0.##") kV</td>
                            <td>@p.ConnectionType</td>
                            <td style="text-align:right">₹@p.ProjectAmount.ToString("N0")</td>
                            <td style="text-align:right">
                                @if (hasAmt)
                                {
                                    <span class="badge bg-success" style="font-size:12.5px">₹@amt.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not set</span>
                                }
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary btn-edit-rate"
                                        data-id="@p.Id" data-amt="@(hasAmt ? amt.ToString("0.##") : "")">
                                    @(hasAmt ? "Edit" : "Set")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Set-plan-commission modal -->
    <div class="modal fade" id="planCommissionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="planCommissionForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Set Commission for a Solar Project</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Solar Project <span class="text-danger">*</span></label>
                            <select class="form-select" name="solarProjectId" id="planSelect" required>
                                <option value="">-- pick a solar project --</option>
                                @foreach (var p in plans)
                                {
                                    var hasAmt = planAmounts.TryGetValue(p.Id, out var amt);
                                    <option value="@p.Id" data-project="@p.ProjectAmount"
                                            data-amt="@(hasAmt ? amt.ToString("0.##") : "")">
                                        @p.Name — @p.SolarTypeKV.ToString("0.##") kV (₹@p.ProjectAmount.ToString("N0"))@(hasAmt ? $" · currently ₹{amt:N0}" : "")
                                    </option>
                                }
                            </select>
                            <small class="form-text text-muted">
                                All active plans from the Solar Projects master. The commission is set on whichever plan you select.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Commission ₹ (per project) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="amount" id="planAmt"
                                   min="1" step="1" placeholder="e.g. 2000" required />
                            <small class="form-text text-muted">
                                Plain rupees — for example 2000, 100 or 30. This full amount is paid to every INC
                                worker on every project under this plan. It is not calculated from the project value.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Summary</label>
                            <div class="form-control-plaintext" id="planPreview"
                                 style="font-weight:700;color:var(--green)">—</div>
                        </div>
                        <div class="alert alert-info" style="font-size:12.5px">
                            On save, payout records are generated automatically for every project on this plan
                            that already has an INC worker assigned. Existing records are left unchanged.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Save Commission</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        @* Report filter — Member ID / City / State / Request date. *@

        ViewData["FilterTableId"] = "commissionTable";
        ViewData["FilterPlaceholder"] = "Search by Member ID, member name, request #, INC worker...";
        ViewData["FilterDateLabel"] = "Request Date";
        ViewData["FilterPageSize"] = 10;   // payouts grow unbounded — page them

        <partial name="_ReportFilterToolbar" />

        <div class="card">
            <div class="ct"><span class="ct-dot"></span>Commission Payouts (@Model.Count())</div>
            <div class="tbl-wrap">
                <table id="commissionTable" class="table table-hover">
                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Member ID</th>
                            <th>Member Name</th>
                            <th>City / State</th>
                            <th>Plan</th>
                            <th>INC Worker</th>
                            <th style="text-align:right">Project Amount</th>
                            <th style="text-align:right">Commission</th>
                            <th>Status</th>
                            <th>Request Date</th>
                            <th>Paid On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var req = c.SolarRequest;
                            var memberName = req == null ? "" :
                                (string.IsNullOrWhiteSpace(req.MemberFullName) ? req.ApplicantName : req.MemberFullName);
                            // Date filter runs on the request date; commissions whose request
                            // isn't loaded fall back to the commission's own creation date.
                            var rowDate = (req?.CreatedAt ?? c.CreatedAt).ToLocalTime().ToString("yyyy-MM-dd");
                            // Payout is gated on the project actually being finished.
                            var canPay = req == null || req.CurrentStage == ProjectStatus.Completed;
                            <tr data-search="@($"{c.UserId} {memberName} {req?.MobileNumber} {req?.City} {req?.State} {req?.RequestNumber} {c.Worker?.Name}".ToLower())"
                                data-mid="@c.UserId"
                                data-city="@req?.City"
                                data-state="@req?.State"
                                data-date="@rowDate">
                                <td>
                                    <strong>@(req?.RequestNumber ?? ("#" + c.SolarRequestId))</strong>
                                    @if (req != null)
                                    {
                                        <div class="cell-sub">@req.CurrentStage</div>
                                    }
                                </td>
                                <td><span class="mid-code">@c.UserId</span></td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(memberName) ? "—" : memberName)
                                    <div class="cell-sub">@req?.MobileNumber</div>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(req?.City) ? "—" : req.City)
                                    <div class="cell-sub">@req?.State</div>
                                </td>
                                <td>
                                    @if (req != null)
                                    {
                                        <partial name="_PlanCell" model="req" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (c.Worker != null)
                                    {
                                        @c.Worker.Name <small class="text-muted">(@c.Worker.MobileNumber)</small>
                                    }
                                    else if (!c.IsPaid)
                                    {
                                        <button class="btn btn-sm btn-outline-primary btn-assign" data-id="@c.Id">
                                            Assign...
                                        </button>
                                    }
                                    else
                                    {
                                        <small class="text-muted">—</small>
                                    }
                                </td>
                                <td style="text-align:right">₹@c.ProjectAmount.ToString("N0")</td>
                                <td style="text-align:right;color:var(--sun);font-weight:600">₹@c.CommissionAmount.ToString("N0")</td>
                                <td>
                                    @if (c.IsPaid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                                <td>@(req != null ? req.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") : "—")</td>
                                <td>@(c.PaidAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                <td>
                                    @if (c.IsPaid)
                                    {
                                        <small class="text-muted">Ref: @(c.PaymentReference ?? "—")</small>
                                    }
                                    else if (canPay)
                                    {
                                        <button class="btn btn-sm btn-success btn-mark-paid" data-id="@c.Id">
                                            Mark Paid
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled
                                                title="Payout unlocks when the project reaches Completed">
                                            🔒 Till Completed
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="ct"><span class="ct-dot"></span>No Commission Payouts</div>
            <div style="text-align:center;padding:40px;color:var(--text3)">
                <div style="font-size:48px;margin-bottom:16px">📈</div>
                <div style="font-size:18px;margin-bottom:8px">No payout records yet</div>
                <div>Set a commission amount on any solar project above — records are generated automatically for projects that already have an INC worker assigned.</div>
            </div>
        </div>
    }
</div>

@* Assign worker modal — opened on demand by .btn-assign *@
<div class="modal fade" id="assignWorkerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="assignWorkerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="assignCommissionId" />
                <div class="modal-header">
                    <h5 class="modal-title">Assign INC Worker</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">INC Worker <span class="text-danger">*</span></label>
                    <select class="form-select" name="workerId" required>
                        <option value="">-- pick a worker --</option>
                        @foreach (var w in incWorkers)
                        {
                            <option value="@w.Id">@w.Name (@(w.MobileNumber))</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const token = $('input[name="__RequestVerificationToken"]').first().val();

// ── Plan table show/hide ───────────────────────────────────────────────
// Kept collapsed by default so the page stays short; the choice sticks per
// browser so an admin who works in the rate table isn't re-opening it.
(function () {
    var KEY = 'incPlansOpen';
    var $wrap = document.getElementById('plansWrap');
    var $btn  = document.getElementById('btnTogglePlans');
    if (!$wrap || !$btn) return;

    function paint(open) {
        $wrap.style.display = open ? '' : 'none';
        $btn.innerHTML = open ? '▾ Hide' : '▸ Show';
    }
    var open = false;
    try { open = localStorage.getItem(KEY) === '1'; } catch (e) { /* private mode */ }
    paint(open);

    $btn.addEventListener('click', function () {
        open = !open;
        paint(open);
        try { localStorage.setItem(KEY, open ? '1' : '0'); } catch (e) { /* ignore */ }
    });
})();

// Toasts, never alert().
//
// _Toasts.cshtml (included from _Layout) wires a global $(document).ajaxSuccess
// handler that turns any { success, message } JSON response into a SweetAlert2
// toast, and ajaxError into an error toast. So AJAX callbacks here must NOT
// raise their own message — that would show it twice. `notify` exists only for
// client-side validation, which never touches the server.
function notify(kind, msg) {
    if (window.SolarToast && typeof window.SolarToast[kind] === 'function') {
        window.SolarToast[kind](msg);
    } else {
        // SweetAlert2 is CDN-loaded; fall back so a blocked CDN doesn't
        // swallow validation feedback entirely.
        alert(msg);
    }
}

function postJson(url, data, cb) {
    $.post(url, $.extend({ __RequestVerificationToken: token }, data), cb)
     .fail(() => cb({ success: false, message: 'Network error.' }));
}

// ── Plan commission (flat ₹ per project) ───────────────────────────────
function refreshPlanPreview() {
    const $opt = $('#planSelect').find('option:selected');
    const project = parseFloat($opt.data('project') || 0);
    const amt = parseFloat($('#planAmt').val() || 0);
    if (project > 0 && amt > 0) {
        $('#planPreview').text(
            'Project ₹' + project.toLocaleString('en-IN') +
            ' → commission ₹' + amt.toLocaleString('en-IN') + ' per project');
    } else if (amt > 0) {
        $('#planPreview').text('₹' + amt.toLocaleString('en-IN') + ' per project');
    } else {
        $('#planPreview').text('—');
    }
}

// Picking a plan pre-fills whatever amount it already has, so editing is a
// tweak rather than a re-entry.
$('#planSelect').on('change', function () {
    const existing = $(this).find('option:selected').data('amt');
    $('#planAmt').val(existing !== undefined && existing !== '' ? existing : '');
    refreshPlanPreview();
});
$('#planAmt').on('input', refreshPlanPreview);

// Row-level Set/Edit opens the same modal with that plan preselected.
$(document).on('click', '.btn-edit-rate', function () {
    $('#planSelect').val(String($(this).data('id')));
    const amt = $(this).data('amt');
    $('#planAmt').val(amt !== undefined && amt !== '' ? amt : '');
    refreshPlanPreview();
    new bootstrap.Modal(document.getElementById('planCommissionModal')).show();
});

// Single-flight guard. A double-click (or Enter pressed twice) used to fire two
// POSTs; the second could race the first and write a duplicate row. The flag is
// checked BEFORE anything async starts and is only cleared on failure — on
// success the page reloads, so it stays locked.
var planSaveInFlight = false;

$('#planCommissionForm').on('submit', function (e) {
    e.preventDefault();
    if (planSaveInFlight) return;

    var $form = $(this);
    var $btn  = $form.find('button[type="submit"]');

    var planId = $('#planSelect').val();
    if (!planId) { notify('error', 'Please select a solar project first.'); return; }

    var amt = parseFloat($('#planAmt').val());
    if (!(amt > 0)) { notify('error', 'Commission amount must be greater than 0.'); return; }

    var project = parseFloat($('#planSelect').find('option:selected').data('project') || 0);
    if (project > 0 && amt > project) {
        notify('error', 'Commission cannot exceed the project value (₹' + project.toLocaleString('en-IN') + ').');
        return;
    }

    planSaveInFlight = true;
    $btn.prop('disabled', true).data('label', $btn.text()).text('Saving…');
    $form.find('input, select').prop('disabled', true);

    postJson('@Url.Action("SavePlanCommission")', { solarProjectId: planId, amount: amt }, function (r) {
        // r.message is already toasted by the global ajaxSuccess/ajaxError handler.
        if (r.success) {
            location.reload();
        } else {
            planSaveInFlight = false;
            $form.find('input, select').prop('disabled', false);
            $btn.prop('disabled', false).text($btn.data('label') || 'Save Commission');
        }
    });
});

// ── Payouts ────────────────────────────────────────────────────────────
$('.btn-mark-paid').on('click', function () {
    var $btn = $(this);
    if ($btn.prop('disabled')) return;

    const id = $btn.data('id');
    const ref = prompt('Payment reference / UTR? (optional)') ?? '';
    if (!confirm('Mark this commission as paid? This cannot be undone.')) return;

    $btn.prop('disabled', true).text('Saving...');
    postJson('@Url.Action("MarkPaid")', { id: id, reference: ref }, function (r) {
        if (r.success) { location.reload(); }
        else { $btn.prop('disabled', false).text('Mark Paid'); }
    });
});

$(document).on('click', '.btn-assign', function () {
    $('#assignCommissionId').val($(this).data('id'));
    new bootstrap.Modal(document.getElementById('assignWorkerModal')).show();
});

var assignInFlight = false;

$('#assignWorkerForm').on('submit', function (e) {
    e.preventDefault();
    if (assignInFlight) return;

    var $form = $(this);
    var $btn  = $form.find('button[type="submit"]');
    if (!$form.find('select[name="workerId"]').val()) {
        notify('error', 'Please select an INC worker first.');
        return;
    }

    assignInFlight = true;
    $btn.prop('disabled', true).data('label', $btn.text()).text('Assigning…');

    const fd = $form.serializeArray().reduce((a, x) => (a[x.name] = x.value, a), {});
    postJson('@Url.Action("AssignWorker")', fd, function (r) {
        if (r.success) {
            location.reload();
        } else {
            assignInFlight = false;
            $btn.prop('disabled', false).text($btn.data('label') || 'Assign');
        }
    });
});
</script>
}
