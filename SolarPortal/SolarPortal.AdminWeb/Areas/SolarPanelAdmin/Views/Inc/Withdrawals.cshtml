@model List<SolarPortal.Domain.Entities.IncWithdrawal>
@{
    ViewData["Title"] = "INC Withdrawals";
    var workers = ViewBag.Workers as Dictionary<int,string> ?? new();
    string curStatus = ViewBag.Status as string ?? "";

    // Maps a withdrawal status onto the theme's status-pill modifiers
    // (solar-theme.css defines only: sts-act / sts-pend / sts-comp / sts-rej / sts-disp).
    string Pill(string s) => s switch
    {
        "Approved" => "sts-act",
        "Rejected" => "sts-rej",
        _          => "sts-pend"
    };
    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    bool hasFilter = !string.IsNullOrEmpty(curStatus);
}

<div class="page active">
    @Html.AntiForgeryToken()
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>INC Withdrawals</span></div>
        <div class="ph-title">💸 INC Withdrawals</div>
        <div class="ph-sub">Approve or reject installer withdrawal requests.</div>
    </div>

    <form method="get" class="card" style="padding:16px 18px;margin-bottom:18px">
        <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end">
            <div style="flex:0 1 200px;min-width:150px">
                <label for="status">Status</label>
                <select id="status" name="status" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    @foreach (var s in new[]{"Pending","Approved","Rejected"})
                    { <option value="@s" selected="@(curStatus==s)">@s</option> }
                </select>
            </div>
            @if (hasFilter)
            {
                <a href="@Url.Action("Withdrawals")" class="btn btn-s btn-sm" style="margin-bottom:1px">✕ Clear</a>
            }
        </div>
    </form>

    @if (Model.Any())
    {
        @* Client-side report filter — free text + request-date range. Withdrawals
           are raised by installers, not members, and carry no city/state, so those
           three fields are switched off. *@
        ViewData["FilterTableId"] = "incWdTable";
        ViewData["FilterPlaceholder"] = "Search by request #, installer, bank / UPI...";
        ViewData["FilterDateLabel"] = "Request Date";
        ViewData["FilterShowMemberId"] = false;
        ViewData["FilterShowCity"] = false;
        ViewData["FilterShowState"] = false;

        <partial name="_ReportFilterToolbar" />
    }

    <div class="card">
        <div class="ct"><span class="ct-dot"></span>Withdrawal Requests (@Model.Count)</div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="es-icon">💸</div>
                <div class="es-title">No withdrawal requests</div>
                <div class="es-sub">
                    @(hasFilter
                        ? "Nothing matches this filter — try clearing it."
                        : "Withdrawal requests raised by installers will appear here.")
                </div>
            </div>
        }
        else
        {
            <div class="tbl-wrap">
                <table id="incWdTable">
                    <thead>
                        <tr>
                            <th>Req #</th>
                            <th>Installer</th>
                            <th style="text-align:right">Amount</th>
                            <th>Bank Name</th>
                            <th>A/c No</th>
                            <th>IFSC Code</th>
                            <th>Branch</th>
                            <th>UPI / Note</th>
                            <th>Requested</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var w in Model)
                    {
                        var installerName = workers.TryGetValue(w.WorkerId, out var wn) ? wn : ("#" + w.WorkerId);
                        <tr data-search="@($"{w.RequestNumber} {installerName} {w.BankName} {w.AccountNo} {w.IFSCode} {w.BranchName} {w.BankDetails} {w.Status}".ToLower())"
                            data-date="@w.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd")">
                            <td class="td-b">@(w.RequestNumber ?? ("#" + w.Id))</td>
                            <td>@installerName</td>
                            <td style="text-align:right;font-weight:600">₹@w.Amount.ToString("N2")</td>
                            <td style="font-size:12.5px">@Dash(w.BankName)</td>
                            <td style="font-size:12.5px"><code>@Dash(w.AccountNo)</code></td>
                            <td style="font-size:12.5px"><code>@Dash(w.IFSCode)</code></td>
                            <td style="font-size:12.5px">@Dash(w.BranchName)</td>
                            <td style="font-size:12px;max-width:220px">@Dash(w.BankDetails)</td>
                            <td>@w.RequestedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="sts @Pill(w.Status)">@w.Status</span>
                                @if (w.Status == "Rejected" && !string.IsNullOrWhiteSpace(w.RejectionReason))
                                {
                                    <div class="hint" style="color:var(--red)">@w.RejectionReason</div>
                                }
                                @if (w.Status == "Approved" && !string.IsNullOrWhiteSpace(w.AdminNotes))
                                {
                                    <div class="hint">@w.AdminNotes</div>
                                }
                            </td>
                            <td style="white-space:nowrap">
                                @if (w.Status == "Pending")
                                {
                                    <button class="btn btn-g btn-sm" onclick="apvWd(@w.Id)">&#10003; Approve</button>
                                    <button class="btn btn-d btn-sm" style="margin-left:6px"
                                            onclick="rejWd(@w.Id)">✕ Reject</button>
                                }
                                else
                                {
                                    <span style="color:var(--text3)">—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function postForm(url, data) {
        var f = document.createElement('form');
        f.method = 'post'; f.action = url;
        for (var k in data) {
            var i = document.createElement('input');
            i.type = 'hidden'; i.name = k; i.value = data[k];
            f.appendChild(i);
        }
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (t) { f.appendChild(t.cloneNode(true)); }
        document.body.appendChild(f);
        f.submit();
    }

    // Approve also captures a remark, same as reject — the installer sees it
    // on their Withdraw page, so an approval is never a bare status flip.
    function apvWd(id) {
        Swal.fire({
            title: 'Approve Withdrawal?',
            input: 'text',
            inputLabel: 'Approval remark',
            inputPlaceholder: 'UTR / payment mode / any note for the installer',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Approve',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#059669',
            inputValidator: function (v) {
                if (!v || !v.trim()) { return 'Please enter a remark'; }
            }
        }).then(function (r) {
            if (r.isConfirmed) {
                postForm('@Url.Action("ApproveWithdrawal")', { id: id, remark: r.value });
            }
        });
    }

    function rejWd(id) {
        Swal.fire({
            title: 'Reject Withdrawal?',
            input: 'text',
            inputLabel: 'Rejection reason',
            inputPlaceholder: 'Why is this being rejected?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Reject',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#dc2626',
            inputValidator: function (v) {
                if (!v || !v.trim()) { return 'Please enter a reason'; }
            }
        }).then(function (r) {
            if (r.isConfirmed) {
                postForm('@Url.Action("RejectWithdrawal")', { id: id, reason: r.value });
            }
        });
    }
</script>
}
