    .pd-prog { height: 5px; background: var(--border); border-radius: 3px; overflow: hidden; margin-top: 7px; }
    .pd-prog > i { display: block; height: 100%; background: var(--green); border-radius: 3px; }

    /* Label/value pairs — pehle 16px values bahut bhaari lagti thi aur ek row
