        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        confirmButtonText: 'Upload DCR & Work',
        didOpen: () => {
        // One picker collects both files: Gallery can multi-select, Camera adds
        // one photo per shot. Capped at 2; ✕ removes a file to swap it.
        dcrPicked = [];
        const render = () => {
        const list = document.getElementById('f-dcr-list');
        if (!dcrPicked.length) { list.innerHTML = 'No file chosen (0 / 2)'; return; }
        list.innerHTML = dcrPicked.map((f, i) =>
        `<div>${i === 0 ? 'DCR' : 'Work'}: ${esc(f.name)}
        <a href="javascript:void(0)" data-rm="${i}" style="color:#dc2626;margin-left:6px">✕</a></div>`).join('')
        + `<div>(${dcrPicked.length} / 2)</div>`;
        list.querySelectorAll('[data-rm]').forEach(a => a.onclick = () => {
        dcrPicked.splice(+a.dataset.rm, 1); render();
        });
        };
        const add = (input) => {
        for (const f of Array.from(input.files)) {
        if (dcrPicked.length >= 2) { Swal.showValidationMessage('Only 2 files allowed — remove one first'); break; }
        dcrPicked.push(f);
        }
        input.value = '';
        render();
        };
        document.getElementById('f-dcr-cam').onchange = function () { add(this); };
        document.getElementById('f-dcr-gal').onchange = function () { add(this); };
