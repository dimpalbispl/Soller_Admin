@model IEnumerable<SolarPortal.Domain.Entities.SolarRequest>
@{
    ViewData["Title"] = ViewBag.Title ?? "Operations";
    var op = (string)(ViewBag.Op ?? "");           // meter | material | installation | dcr
    var states = (List<string>)(ViewBag.States ?? new List<string>());
    var workers = (List<SolarPortal.Domain.Entities.Worker>)(ViewBag.Workers ?? new List<SolarPortal.Domain.Entities.Worker>());
    var filterState = (string?)ViewBag.FilterState;
    var filterCity = (string?)ViewBag.FilterCity;
    var titleLower = ((string)ViewBag.Title ?? "operations").ToLower();
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>@ViewBag.Title</span></div>
        <div class="ph-title">@ViewBag.Title</div>
        <div class="ph-sub">Manage @titleLower operations — filter, take action, advance stage</div>
    </div>

    @{
        var opFilter = (ViewBag.Filter as string) ?? "all";
    }
    @* 4-tab status filter — Pending / Approved / Rejected / All.
       Per spec ("approve karta hu to pending se ht jata hai wha sb show
       karwao pending approve reject all") we now expose every state per
       operations queue. Approved here means "moved past this stage";
       Rejected only applies to DCR Verify (other dispatch ops don't have
       a reject step). *@
    @await Html.PartialAsync("_StatusTabs", (object)opFilter)

    <!-- Filter card — server-side, re-queries the whole queue -->
    <div class="card" style="margin-bottom:14px">
        <div class="ct"><span class="ct-dot"></span>Filter</div>
        <form method="get">
            <input type="hidden" name="filter" value="@opFilter" />
            <div class="fr3">
                <div class="fg">
                    <label>State</label>
                    <select name="state">
                        <option value="">All States</option>
                        @foreach (var s in states)
                        {
                            <option value="@s" selected="@(s == filterState)">@s</option>
                        }
                    </select>
                </div>
                <div class="fg">
                    <label>City</label>
                    <input type="text" name="city" value="@filterCity" placeholder="Filter by city" />
                </div>
                <div class="fg">
                    <label>&nbsp;</label>
                    <div style="display:flex;gap:8px">
                        <button type="submit" class="btn btn-primary btn-sm">🔍 Apply</button>
                        <a href="?" class="btn btn-s btn-sm">Reset</a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Any())
    {
        // Client-side report filter — Member ID + Request date + free text.
        // City / State are switched OFF here because the server-side filter card
        // above already owns those two; showing both would let the two filters
        // silently fight each other.
        ViewData["FilterTableId"] = "operationsTable";
        ViewData["FilterPlaceholder"] = "Search by Member ID, name, mobile, request #, city, state...";
        ViewData["FilterDateLabel"] = "Request Date";
        ViewData["FilterShowCity"] = false;
        ViewData["FilterShowState"] = false;

        // Assigned-person filter — only the two queues that actually carry a
        // person — dono jagah wahi installer hai jo Material Dispatch par assign hota hai.
        ViewData["FilterShowWorker"] = op == "material" || op == "installation";
        ViewData["FilterWorkerLabel"] = "Installer";

        <partial name="_ReportFilterToolbar" />

        // History mode: show extra "Details" column with the data admin filled
        // during the dispatch action. Pulled from ViewBag dictionaries that the
        // controller populated based on `op`.
        // Note: we're already inside a Razor C# block here (because of @if{...})
        // so plain `var` declarations work — no need for @{ } which is the
        // *transition* syntax from HTML to C#.
        var isHistoryMode = string.Equals((string)ViewBag.Filter, "all", StringComparison.OrdinalIgnoreCase);
        var meterMap = ViewBag.MeterDetails as Dictionary<int, SolarPortal.Domain.Entities.MeterDispatch>;
        var materialMap = ViewBag.MaterialDetails as Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>;
        var installMap = ViewBag.InstallationDetails as Dictionary<int, SolarPortal.Domain.Entities.Installation>;
        var dcrMap = ViewBag.DCRDetails as Dictionary<int, SolarPortal.Domain.Entities.DCRDocument>;

        // On the Installation queue this holds the MaterialDispatch row, so the
        // person assigned at dispatch time can be shown (and pre-selected in the
        // modal) even before an Installation record exists.
        var dispatchMap = ViewBag.DispatchAssignments as Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>;

        // Whether this queue shows the "assigned person" column at all.
        var showPersonCol = op == "material" || op == "installation";
        var personColTitle = "Installer";

        <div class="card">
            <div class="ct"><span class="ct-dot"></span>@ViewBag.Title Queue (@Model.Count())</div>
            <div class="tbl-wrap">
                <table id="operationsTable">
                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Member ID</th>
                            <th>Member Name</th>
                            <th>Plan</th>
                            <th>Type</th>
                            <th>Capacity</th>
                            <th>City / State</th>
                            <th>Request Date</th>
                            <th>Stage</th>
                            @if (showPersonCol)
                            {
                                <th>@personColTitle</th>
                            }
                            @if (isHistoryMode)
                            {
                                <th>Details</th>
                            }
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            // Live m_membermaster name when the admin controller has enriched
                            // it, otherwise the stored ApplicantName.
                            var memberName = string.IsNullOrWhiteSpace(r.MemberFullName) ? r.ApplicantName : r.MemberFullName;

                            // --- Assigned person for this row -----------------------------
                            // material      → the installer picked at dispatch time
                            // installation  → the installer on the Installation record; before
                            //                 that record exists we show (and pre-select) the
                            //                 person already assigned in Material Dispatch.
                            string? personName = null;
                            int? personId = null;
                            var personFromDispatch = false;   // true = inherited, not yet confirmed
                            int? personInstallId = null;      // set only when a row can be edited

                            if (op == "material" && materialMap != null
                                && materialMap.TryGetValue(r.Id, out var matPerson))
                            {
                                personName = matPerson.AssignedWorker?.Name;
                                personId = matPerson.AssignedWorkerId;
                            }
                            else if (op == "installation")
                            {
                                if (installMap != null && installMap.TryGetValue(r.Id, out var insPerson))
                                {
                                    personName = insPerson.AssignedWorker?.Name;
                                    personId = insPerson.AssignedWorkerId;
                                    personInstallId = insPerson.Id;
                                }
                                if (personName == null && dispatchMap != null
                                    && dispatchMap.TryGetValue(r.Id, out var dspPerson))
                                {
                                    personName = dspPerson.AssignedWorker?.Name;
                                    personId = dspPerson.AssignedWorkerId;
                                    personFromDispatch = true;
                                }
                            }

                            <tr data-search="@($"{r.UserId} {memberName} {r.MobileNumber} {r.City} {r.State} {r.RequestNumber} {personName}".ToLower())"
                                data-mid="@r.UserId"
                                data-city="@r.City"
                                data-state="@r.State"
                                data-worker="@personName"
                                data-date="@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")">
                                <td class="td-b">
                                    <a asp-area="SolarPanelAdmin" asp-controller="Projects" asp-action="Details"
                                       asp-route-id="@r.Id" style="color:var(--sun)">@r.RequestNumber</a>
                                </td>
                                <td><span class="mid-code">@r.UserId</span></td>
                                <td>
                                    @memberName
                                    <div style="font-size:11px;color:var(--text3)">@r.MobileNumber</div>
                                </td>
                                @* Plan cell missing tha — header mein Plan/Type/Capacity
                                   3 columns hain, body mein sirf 2 cells the. Isse poori
                                   row ek column left shift ho jati thi (Processed badge
                                   Details ke neeche, Action khali). *@
                                <td><partial name="_PlanCell" model="r" /></td>
                                <td>@r.ConnectionType</td>
                                <td>@r.KVCapacity kV</td>
                                <td>@r.City<div style="font-size:11px;color:var(--text3)">@r.State</div></td>
                                <td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="sts sts-disp">@r.CurrentStage.ToString().Replace("_", " ")</span>
                                </td>
                                @if (showPersonCol)
                                {
                                    <td style="font-size:12px">
                                        @if (!string.IsNullOrWhiteSpace(personName))
                                        {
                                            <div class="td-b">👷 @personName</div>
                                            if (personFromDispatch)
                                            {
                                                <div style="font-size:11px;color:var(--text3)">from Material Dispatch</div>
                                            }
                                            if (personInstallId.HasValue)
                                            {
                                                <button type="button" class="btn btn-s btn-sm" style="margin-top:4px"
                                                        onclick="openChangeInstaller(@personInstallId.Value, @(personId ?? 0), '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(personName))')">
                                                    ✏️ Change
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">— Not assigned —</span>
                                        }
                                    </td>
                                }
                                @if (isHistoryMode)
                                {
                                    <td style="font-size:12px;max-width:240px">
                                        @* Render whatever dispatch record exists for this request, based on op. *@
                                        @switch (op)
                                        {
                                            case "meter":
                                                if (meterMap != null && meterMap.TryGetValue(r.Id, out var m))
                                                {
                                                    <div><strong>#</strong> @m.MeterNumber</div>
                                                    if (!string.IsNullOrWhiteSpace(m.MeterType))
                                                    {

                                                        <div><strong>Type:</strong> @m.MeterType</div>
                                                    }
                                                    if (m.DispatchDate.HasValue)
                                                    {

                                                        <div><strong>Date:</strong> @m.DispatchDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(m.Remark))
                                                    {

                                                        <div style="color:var(--text3)">@m.Remark</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(m.DispatchDocumentPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@m.DispatchDocumentPath')" style="color:var(--sun)">📄 Document</a></div>
                                                    }
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                            case "material":
                                                if (materialMap != null && materialMap.TryGetValue(r.Id, out var mat))
                                                {
                                                    if (!string.IsNullOrWhiteSpace(mat.MaterialDetails))
                                                    {

                                                        <div>@mat.MaterialDetails</div>
                                                    }
                                                    if (mat.DispatchDate.HasValue)
                                                    {

                                                        <div><strong>Date:</strong> @mat.DispatchDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(mat.VehicleDetails))
                                                    {

                                                        <div><strong>Vehicle:</strong> @mat.VehicleDetails</div>
                                                    }
                                                    if (mat.AssignedWorker != null)
                                                    {

                                                        <div><strong>Worker:</strong> @mat.AssignedWorker.Name</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(mat.Remark))
                                                    {

                                                        <div style="color:var(--text3)">@mat.Remark</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(mat.DispatchDocumentPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@mat.DispatchDocumentPath')" style="color:var(--sun)">📄 Document</a></div>
                                                    }
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                            case "installation":
                                                if (installMap != null && installMap.TryGetValue(r.Id, out var inst))
                                                {
                                                    if (inst.InstallationDate.HasValue)
                                                    {

                                                        <div><strong>Date:</strong> @inst.InstallationDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                    }
                                                    if (inst.AssignedWorker != null)
                                                    {

                                                        <div><strong>Worker:</strong> @inst.AssignedWorker.Name</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(inst.Notes))
                                                    {

                                                        <div>@inst.Notes</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(inst.Remark))
                                                    {

                                                        <div style="color:var(--text3)">@inst.Remark</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(inst.CompletionPhotoPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@inst.CompletionPhotoPath')" style="color:var(--sun)">📷 Photo</a></div>
                                                    }
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                            case "dcr":
                                                if (dcrMap != null && dcrMap.TryGetValue(r.Id, out var dcr))
                                                {
                                                    if (!string.IsNullOrWhiteSpace(dcr.DCRNumber))
                                                    {

                                                        <div><strong>#</strong> @dcr.DCRNumber</div>
                                                    }
                                                    if (dcr.DCRDate.HasValue)
                                                    {

                                                        <div><strong>Date:</strong> @dcr.DCRDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(dcr.Remark))
                                                    {

                                                        <div style="color:var(--text3)">@dcr.Remark</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(dcr.DocumentPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@dcr.DocumentPath')" style="color:var(--sun)">📄 Document</a></div>
                                                    }
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                        }
                                    </td>
                                }
                                <td>
                                    @{
                                        // Map the page's "op" to the stage it acts on
                                        var actStage =
                                            op == "meter" ? SolarPortal.Domain.Enums.ProjectStatus.MeterDispatch :
                                            op == "material" ? SolarPortal.Domain.Enums.ProjectStatus.MaterialDispatch :
                                            op == "installation" ? SolarPortal.Domain.Enums.ProjectStatus.Installation :
                                            op == "dcr" ? SolarPortal.Domain.Enums.ProjectStatus.DCRUpdate :
                                                                   SolarPortal.Domain.Enums.ProjectStatus.Registration;
                                        var isActiveRow = r.CurrentStage == actStage;
                                    }
                                    @if (isActiveRow)
                                    {
                                        @switch (op)
                                        {
                                            case "meter":
                                                <button class="btn btn-primary btn-sm" onclick="openMeterForm(@r.Id, '@r.RequestNumber')">📦 Dispatch Meter</button>
                                                break;
                                            case "material":
                                                <button class="btn btn-primary btn-sm" onclick="openMaterialForm(@r.Id, '@r.RequestNumber')">📦 Dispatch Material</button>
                                                break;
                                            case "installation":
                                                <button class="btn btn-primary btn-sm" onclick="openInstallForm(@r.Id, '@r.RequestNumber')">📝 Remark / Check Installer</button>
                                                break;
                                            case "dcr":
                                                <button class="btn btn-primary btn-sm" onclick="openDCRForm(@r.Id, '@r.RequestNumber')">📄 Submit DCR</button>
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        <span class="sts sts-act">✅ Processed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="ct"><span class="ct-dot"></span>No @ViewBag.Title Queue</div>
            <div style="text-align:center;padding:40px;color:var(--text3)">
                <div style="font-size:48px;margin-bottom:16px">@GetEmptyIcon((string)ViewBag.Title)</div>
                <div style="font-size:18px;margin-bottom:8px">No @titleLower pending</div>
                <div>All eligible requests in the previous stage have been processed.</div>
            </div>
        </div>
    }
</div>

@functions {
    string GetEmptyIcon(string title) => title switch
    {
        "Meter Dispatch" => "📦",
        "Material Dispatch" => "📦",
        "Installation" => "🔧",
        "DCR Update" => "📄",
        _ => "📋"
    };
}

@* Hidden CSRF token holder for fetch() based form posts *@
<form id="csrfForm" style="display:none">@Html.AntiForgeryToken()</form>

@* Worker options reused in modals *@
@{
    var workerJson = System.Text.Json.JsonSerializer.Serialize(
        workers.Select(w => new { id = w.Id, name = w.Name, type = w.Type.ToString(), city = w.City ?? "" }));
}
<script id="workerOptions" type="application/json">@Html.Raw(workerJson)</script>

@* Existing user-submitted DCR details — used to pre-fill the admin DCR modal so the
   admin verifies what the user already entered instead of typing it again. *@
@{
    var dcrDetailsForJson = ViewBag.DCRDetails as Dictionary<int, SolarPortal.Domain.Entities.DCRDocument>;
    var dcrJson = System.Text.Json.JsonSerializer.Serialize(
        (dcrDetailsForJson ?? new Dictionary<int, SolarPortal.Domain.Entities.DCRDocument>())
        .ToDictionary(
            kv => kv.Key.ToString(),
            kv => new
            {
                number = kv.Value.DCRNumber ?? "",
                date = kv.Value.DCRDate.HasValue ? kv.Value.DCRDate.Value.ToString("yyyy-MM-dd") : "",
                remark = kv.Value.Remark ?? "",
                docPath = kv.Value.DocumentPath ?? ""
            }));
}
<script id="dcrData" type="application/json">@Html.Raw(dcrJson)</script>

@* Person assigned during Material Dispatch, keyed by SolarRequestId. The
   Installation modal reads this to pre-select the installer instead of asking
   the admin to pick the same person a second time. *@
@{
    var dispatchForJson = ViewBag.DispatchAssignments as Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>;
    var dispatchJson = System.Text.Json.JsonSerializer.Serialize(
        (dispatchForJson ?? new Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>())
        .Where(kv => kv.Value.AssignedWorkerId.HasValue)
        .ToDictionary(
            kv => kv.Key.ToString(),
            kv => new
            {
                workerId = kv.Value.AssignedWorkerId!.Value,
                workerName = kv.Value.AssignedWorker?.Name ?? ""
            }));
}
<script id="dispatchAssignData" type="application/json">@Html.Raw(dispatchJson)</script>

@* Existing Installation rows, keyed by SolarRequestId — the admin modal shows the
   saved remark and the installer already on record (falling back to the dispatch
   assignment when no Installation row exists yet). *@
@{
    var installForJson = ViewBag.InstallationDetails as Dictionary<int, SolarPortal.Domain.Entities.Installation>;
    var installJson = System.Text.Json.JsonSerializer.Serialize(
        (installForJson ?? new Dictionary<int, SolarPortal.Domain.Entities.Installation>())
        .ToDictionary(
            kv => kv.Key.ToString(),
            kv => new
            {
                installationId = kv.Value.Id,
                workerId = kv.Value.AssignedWorkerId,
                workerName = kv.Value.AssignedWorker?.Name ?? "",
                remark = kv.Value.Remark ?? "",
                isCompleted = kv.Value.IsCompleted
            }));
}
<script id="installData" type="application/json">@Html.Raw(installJson)</script>

@section Scripts {
    <script>
        const workerData = JSON.parse(document.getElementById('workerOptions').textContent || '[]');
        const dcrData = JSON.parse(document.getElementById('dcrData').textContent || '{}');
        const dispatchAssign = JSON.parse(document.getElementById('dispatchAssignData').textContent || '{}');
        const installData = JSON.parse(document.getElementById('installData').textContent || '{}');
        const csrfToken = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]')?.value || '';
        const today = new Date().toISOString().split('T')[0];

        // Escape for safely injecting values into the SweetAlert HTML string.
        const esc = s => (s == null ? '' : String(s))
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');

        // `selectedId` pre-selects a worker (used to carry the Material Dispatch
        // assignment into Installation). `fallbackName` covers the case where that
        // worker is no longer in the available list — we still show them selected
        // instead of silently dropping the existing assignment.
        function workerOptionsHtml(includeBlank=true, selectedId=null, fallbackName='') {
        const sel = selectedId ? String(selectedId) : '';
        const blank = includeBlank ? `<option value="" ${sel ? '' : 'selected'}>— Not assigned —</option>` : '';
        const known = workerData.some(w => String(w.id) === sel);
        const extra = (sel && !known)
        ? `<option value="${esc(sel)}" selected>${esc(fallbackName || 'Currently assigned')}</option>`
        : '';
        return blank + extra + workerData.map(w =>
        `<option value="${w.id}" ${String(w.id) === sel ? 'selected' : ''}>${esc(w.name)} (${esc(w.type)}, ${esc(w.city || '')})</option>`
        ).join('');
        }

        async function postForm(url, formData, msgOnFail='Failed') {
        formData.append('__RequestVerificationToken', csrfToken);
        try {
        const r = await fetch(url, { method: 'POST', body: formData });
        const d = await r.json();
        return d;
        } catch (e) {
        return { success: false, message: msgOnFail };
        }
        }

        function openMeterForm(requestId, requestNumber) {
        Swal.fire({
        title: '📦 Meter Dispatch — ' + requestNumber,
        html: `
        <div style="text-align:left;font-size:13px">
        <label>Meter Number *</label>
        <input id="f-meter-num" type="text" class="swal2-input" required>
        <label>Meter Type *</label>
        <select id="f-meter-type" class="swal2-input">
        <option value="Single Phase">Single Phase</option>
        <option value="Three Phase">Three Phase</option>
        </select>
        <label>Dispatch Date *</label>
        <input id="f-meter-date" type="date" class="swal2-input" value="${today}">
        <label>Remark</label>
        <textarea id="f-meter-remark" class="swal2-textarea" placeholder="Courier / tracking / notes"></textarea>
        <label>Document (optional)</label>
        <input id="f-meter-doc" type="file" accept=".pdf,.jpg,.png" class="swal2-file">
        </div>`,
        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        confirmButtonText: 'Dispatch',
        preConfirm: async () => {
        const num = document.getElementById('f-meter-num').value.trim();
        if (!num) { Swal.showValidationMessage('Meter number is required'); return false; }
        const fd = new FormData();
        fd.append('requestId', requestId);
        fd.append('meterNumber', num);
        fd.append('meterType', document.getElementById('f-meter-type').value);
        fd.append('dispatchDate', document.getElementById('f-meter-date').value);
        fd.append('remark', document.getElementById('f-meter-remark').value);
        const file = document.getElementById('f-meter-doc').files[0];
        if (file) fd.append('dispatchDoc', file);
        return await postForm('/SolarPanelAdmin/Operations/SubmitMeterDispatch', fd);
        }
        }).then(r => {
        if (r.isConfirmed && r.value && r.value.success) {
        Swal.fire('Done', r.value.message, 'success').then(() => location.reload());
        } else if (r.isConfirmed) {
        Swal.fire('Error', (r.value && r.value.message) || 'Failed', 'error');
        }
        });
        }

        function openMaterialForm(requestId, requestNumber) {
        Swal.fire({
        title: '📦 Material Dispatch — ' + requestNumber,
        html: `
        <div style="text-align:left;font-size:13px">
        <label>Material Details</label>
        <textarea id="f-mat-detail" class="swal2-textarea" placeholder="Solar panels, inverter, wiring, mounts..."></textarea>
        <label>Dispatch Date *</label>
        <input id="f-mat-date" type="date" class="swal2-input" value="${today}">
        <label>Vehicle / Courier</label>
        <input id="f-mat-veh" type="text" class="swal2-input" placeholder="RJ-14-AB-1234 / DTDC AWB...">
        <label>Installer (Worker) *</label>
        <select id="f-mat-worker" class="swal2-input">${workerOptionsHtml()}</select>
        <label>Remark</label>
        <textarea id="f-mat-remark" class="swal2-textarea"></textarea>
        <label>Document (optional)</label>
        <input id="f-mat-doc" type="file" accept=".pdf,.jpg,.png" class="swal2-file">
        </div>`,
        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        confirmButtonText: 'Dispatch',
        preConfirm: async () => {
        // Worker assignment is mandatory — block submit until assigned.
        const w = document.getElementById('f-mat-worker').value;
        if (!w) { Swal.showValidationMessage('Please assign an installer before dispatching.'); return false; }
        const fd = new FormData();
        fd.append('requestId', requestId);
        fd.append('materialDetails', document.getElementById('f-mat-detail').value);
        fd.append('dispatchDate', document.getElementById('f-mat-date').value);
        fd.append('vehicleDetails', document.getElementById('f-mat-veh').value);
        fd.append('remark', document.getElementById('f-mat-remark').value);
        fd.append('workerId', w);
        const file = document.getElementById('f-mat-doc').files[0];
        if (file) fd.append('dispatchDoc', file);
        return await postForm('/SolarPanelAdmin/Operations/SubmitMaterialDispatch', fd);
        }
        }).then(r => {
        if (r.isConfirmed && r.value && r.value.success) {
        Swal.fire('Done', r.value.message, 'success').then(() => location.reload());
        } else if (r.isConfirmed) {
        Swal.fire('Error', (r.value && r.value.message) || 'Failed', 'error');
        }
        });
        }

        // Admin ki Installation screen par ab sirf Remark + assigned installer ka
        // check hai. Actual "Mark Installation" INC panel (SolarPanelInstaller area)
        // par hota hai, isliye yahan installer dobara nahi poocha jaata — jo
        // Material Dispatch mein assign hua tha wahi read-only dikhta hai.
        //
        // Complete karne wala button deny-action ke roop mein hai — sirf fallback,
        // jab tak INC panel se completion na ho jaye.
        function openInstallForm(requestId, requestNumber) {
        const assigned = dispatchAssign[requestId] || {};
        const existing = installData[requestId] || {};
        const who = existing.workerName || assigned.workerName || '';
        const whoSrc = existing.workerName ? 'Installation record' : 'Material Dispatch';

        const assignedBox = who
        ? `<div style="border:1px solid #bbf7d0;background:#f0fdf4;border-radius:8px;padding:10px;margin-bottom:10px">
        <div style="font-size:11px;color:#15803d;text-transform:uppercase;letter-spacing:.4px">Assigned Installer</div>
        <div style="font-weight:700;color:#166534;font-size:15px">&#128119; ${esc(who)}</div>
        <div style="font-size:11px;color:#6b7280">source: ${esc(whoSrc)}</div>
        </div>`
        : `<div style="border:1px solid #fecaca;background:#fef2f2;border-radius:8px;padding:10px;margin-bottom:10px;color:#b91c1c">
        &#9888; Koi installer assign nahi hai. Pehle Material Dispatch mein installer assign kijiye.
        </div>`;

        Swal.fire({
        title: '&#128295; Installation — ' + requestNumber,
        html: `
        <div style="text-align:left;font-size:13px">
        ${assignedBox}
        <label>Remark</label>
        <textarea id="f-ins-remark" class="swal2-textarea" placeholder="Admin remark for this installation">${esc(existing.remark)}</textarea>
        <div style="font-size:11px;color:#6b7280;margin-top:6px">
        Installation "Mark Complete" INC panel se hoti hai. Neeche wala button sirf fallback hai.
        </div>
        </div>`,
        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        showDenyButton: true,
        confirmButtonText: 'Save Remark',
        denyButtonText: 'Complete (fallback)',
        preConfirm: async () => {
        const fd = new FormData();
        fd.append('requestId', requestId);
        fd.append('remark', document.getElementById('f-ins-remark').value);
        return await postForm('/SolarPanelAdmin/Operations/SaveInstallationRemark', fd);
        },
        preDeny: async () => {
        const w = existing.workerId || assigned.workerId;
        if (!w) { Swal.showValidationMessage('Installer assign nahi hai — Material Dispatch se assign kijiye.'); return false; }
        const fd = new FormData();
        fd.append('requestId', requestId);
        fd.append('installationDate', today);
        fd.append('remark', document.getElementById('f-ins-remark').value);
        fd.append('workerId', w);
        return await postForm('/SolarPanelAdmin/Operations/SubmitInstallation', fd);
        }
        }).then(r => {
        const acted = r.isConfirmed || r.isDenied;
        if (acted && r.value && r.value.success) {
        Swal.fire('Done', r.value.message, 'success').then(() => location.reload());
        } else if (acted) {
        Swal.fire('Error', (r.value && r.value.message) || 'Failed', 'error');
        }
        });
        }

        // Installation report se installer badalna — Installation row aur uska
        // WorkerAssignment dono server par sync hote hain.
        function openChangeInstaller(installationId, currentWorkerId, currentWorkerName) {
        Swal.fire({
        title: '✏️ Change Installer',
        html: `
        <div style="text-align:left;font-size:13px">
        <div style="margin-bottom:8px">Current: <strong>${esc(currentWorkerName)}</strong></div>
        <label>New Installer *</label>
        <select id="f-chg-worker" class="swal2-input">${workerOptionsHtml(false, currentWorkerId, currentWorkerName)}</select>
        <label>Reason / Note</label>
        <textarea id="f-chg-note" class="swal2-textarea" placeholder="Why the installer changed"></textarea>
        </div>`,
        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        confirmButtonText: 'Update Installer',
        preConfirm: async () => {
        const w = document.getElementById('f-chg-worker').value;
        if (!w) { Swal.showValidationMessage('Please choose an installer.'); return false; }
        if (String(w) === String(currentWorkerId)) {
        Swal.showValidationMessage('That is already the assigned installer.'); return false;
        }
        const fd = new FormData();
        fd.append('installationId', installationId);
        fd.append('workerId', w);
        fd.append('note', document.getElementById('f-chg-note').value);
        return await postForm('/SolarPanelAdmin/Operations/ChangeInstaller', fd);
        }
        }).then(r => {
        if (r.isConfirmed && r.value && r.value.success) {
        Swal.fire('Done', r.value.message, 'success').then(() => location.reload());
        } else if (r.isConfirmed) {
        Swal.fire('Error', (r.value && r.value.message) || 'Failed', 'error');
        }
        });
        }

        function openDCRForm(requestId, requestNumber) {
        // Pre-fill from the DCR the user already submitted (if any) so the admin
        // verifies it instead of re-typing.
        const ex = dcrData[requestId] || {};
        const docLink = ex.docPath
        ? `<div style="margin:4px 0 8px"><a href="${ex.docPath.charAt(0) === '/' ? ex.docPath : '/' + ex.docPath}" target="_blank">📄 View user-uploaded DCR document</a></div>`
        : '';
        Swal.fire({
        title: '📄 DCR Update — ' + requestNumber,
        html: `
        <div style="text-align:left;font-size:13px">
        <label>DCR Number *</label>
        <input id="f-dcr-num" type="text" class="swal2-input" value="${esc(ex.number)}" required>
        <label>DCR Date *</label>
        <input id="f-dcr-date" type="date" class="swal2-input" value="${ex.date || today}">
        <label>Remark</label>
        <textarea id="f-dcr-remark" class="swal2-textarea">${esc(ex.remark)}</textarea>
        ${docLink}
        <label>DCR Document (optional — re-upload to replace user's)</label>
        <input id="f-dcr-doc" type="file" accept=".pdf,.jpg,.png" class="swal2-file">
        </div>`,
        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        confirmButtonText: 'Submit DCR',
        preConfirm: async () => {
        const num = document.getElementById('f-dcr-num').value.trim();
        if (!num) { Swal.showValidationMessage('DCR number is required'); return false; }
        const fd = new FormData();
        fd.append('requestId', requestId);
        fd.append('dcrNumber', num);
        fd.append('dcrDate', document.getElementById('f-dcr-date').value);
        fd.append('remark', document.getElementById('f-dcr-remark').value);
        const file = document.getElementById('f-dcr-doc').files[0];
        if (file) fd.append('dcrDoc', file);
        return await postForm('/SolarPanelAdmin/Operations/SubmitDCR', fd);
        }
        }).then(r => {
        if (r.isConfirmed && r.value && r.value.success) {
        Swal.fire('Done', r.value.message, 'success').then(() => location.reload());
        } else if (r.isConfirmed) {
        Swal.fire('Error', (r.value && r.value.message) || 'Failed', 'error');
        }
        });
        }
    </script>
}

@* In-page file preview modal (no new tab) *@
@await Html.PartialAsync("_FileModal")
