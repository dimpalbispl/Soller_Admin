@model IEnumerable<SolarPortal.Domain.Entities.SolarRequest>
@{
    ViewData["Title"] = ViewBag.Title ?? "Operations";
    // meter | prepare | final | installation | dcr
    // ("material" was the old single-step Material Dispatch; point 6 split it into
    //  "prepare" and "final", which both act on the same MaterialDispatch row.)
    var op = (string)(ViewBag.Op ?? "");
    var isMaterialOp = op == "material" || op == "prepare" || op == "final";
    var states = (List<string>)(ViewBag.States ?? new List<string>());
    var workers = (List<SolarPortal.Domain.Entities.Worker>)(ViewBag.Workers ?? new List<SolarPortal.Domain.Entities.Worker>());
    var filterState = (string?)ViewBag.FilterState;
    var filterCity = (string?)ViewBag.FilterCity;
    var titleLower = ((string)ViewBag.Title ?? "operations").ToLower();
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>@ViewBag.Title</span></div>
        <div class="ph-title">@ViewBag.Title</div>
        <div class="ph-sub">Manage @titleLower operations — filter, take action, advance stage</div>
    </div>

    @{
        var opFilter = (ViewBag.Filter as string) ?? "all";
    }
    @* 4-tab status filter — Pending / Approved / Rejected / All.
       Per spec ("approve karta hu to pending se ht jata hai wha sb show
       karwao pending approve reject all") we now expose every state per
       operations queue. Approved here means "moved past this stage";
       Rejected only applies to DCR Verify (other dispatch ops don't have
       a reject step). *@
    @await Html.PartialAsync("_StatusTabs", (object)opFilter)

    <!-- Filter card — server-side, re-queries the whole queue -->
    <div class="card" style="margin-bottom:14px">
        <div class="ct"><span class="ct-dot"></span>Filter</div>
        <form method="get">
            <input type="hidden" name="filter" value="@opFilter" />
            <div class="fr3">
                <div class="fg">
                    <label>State</label>
                    <select name="state">
                        <option value="">All States</option>
                        @foreach (var s in states)
                        {
                            <option value="@s" selected="@(s == filterState)">@s</option>
                        }
                    </select>
                </div>
                <div class="fg">
                    <label>City</label>
                    <input type="text" name="city" value="@filterCity" placeholder="Filter by city" />
                </div>
                <div class="fg">
                    <label>&nbsp;</label>
                    <div style="display:flex;gap:8px">
                        <button type="submit" class="btn btn-primary btn-sm">🔍 Apply</button>
                        <a href="?" class="btn btn-s btn-sm">Reset</a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Any())
    {
        // Client-side report filter — Member ID + Request date + free text.
        // City / State are switched OFF here because the server-side filter card
        // above already owns those two; showing both would let the two filters
        // silently fight each other.
        ViewData["FilterTableId"] = "operationsTable";
        ViewData["FilterPlaceholder"] = "Search by Member ID, name, mobile, request #, city, state...";
        ViewData["FilterDateLabel"] = "Request Date";
        ViewData["FilterShowCity"] = false;
        ViewData["FilterShowState"] = false;

        // Assigned-person filter — only the two queues that actually carry a
        // person — dono jagah wahi installer hai jo Material Dispatch par assign hota hai.
        ViewData["FilterShowWorker"] = isMaterialOp || op == "installation";
        ViewData["FilterWorkerLabel"] = "Installer";

        <partial name="_ReportFilterToolbar" />

        // History mode: show extra "Details" column with the data admin filled
        // during the dispatch action. Pulled from ViewBag dictionaries that the
        // controller populated based on `op`.
        // Note: we're already inside a Razor C# block here (because of @if{...})
        // so plain `var` declarations work — no need for @{ } which is the
        // *transition* syntax from HTML to C#.
        var isHistoryMode = string.Equals((string)ViewBag.Filter, "all", StringComparison.OrdinalIgnoreCase);
        var meterMap = ViewBag.MeterDetails as Dictionary<int, SolarPortal.Domain.Entities.MeterDispatch>;
        var materialMap = ViewBag.MaterialDetails as Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>;
    var matLines = ViewBag.MaterialDispatchItems as Dictionary<int, List<SolarPortal.Domain.Entities.MaterialDispatchItem>>;
    var matTotal = (ViewBag.MaterialItemMaster as List<SolarPortal.Domain.Entities.MaterialItem>)?.Count ?? 0;

    // Leading number of a quantity ("8", "20 m" → 20), or null — mirrors the controller.
    decimal? QtyNum(string? s)
    {
        var m = System.Text.RegularExpressions.Regex.Match(s ?? "", @"^\s*(\d+(?:\.\d+)?)");
        return m.Success ? decimal.Parse(m.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture) : null;
    }
    // What is still owed per line once the project has been dispatched
    // (prepared − sent; items prepared later count in full until sent).
    List<(string Name, decimal Owed)> PendingLines(int requestId)
    {
        if (matLines == null || !matLines.TryGetValue(requestId, out var ls)) return new();
        if (materialMap == null || !materialMap.TryGetValue(requestId, out var md) || !md.IsDispatched) return new();
        return ls.Select(l => (l.ItemName, Owed: (QtyNum(l.Quantity) ?? 0) - (l.DispatchedQuantity ?? 0)))
                 .Where(x => x.Owed > 0).ToList();
    }
    // Items of the master list not yet on this project's dispatch.
    int RemainingItems(int requestId) =>
        Math.Max(0, matTotal - (matLines != null && matLines.TryGetValue(requestId, out var ls2) ? ls2.Count : 0));
        var installMap = ViewBag.InstallationDetails as Dictionary<int, SolarPortal.Domain.Entities.Installation>;
        var dcrMap = ViewBag.DCRDetails as Dictionary<int, SolarPortal.Domain.Entities.DCRDocument>;

        // On the Installation queue this holds the MaterialDispatch row, so the
        // person assigned at dispatch time can be shown (and pre-selected in the
        // modal) even before an Installation record exists.
        var dispatchMap = ViewBag.DispatchAssignments as Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>;

        // Whether this queue shows the "assigned person" column at all.
        var showPersonCol = isMaterialOp || op == "installation";
        var personColTitle = "Installer";

        <div class="card">
            <div class="ct"><span class="ct-dot"></span>@ViewBag.Title Queue (@Model.Count())</div>
            <div class="tbl-wrap">
                <table id="operationsTable">
                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Member ID</th>
                            <th>Member Name</th>
                            <th>Plan</th>
                            <th>Type</th>
                            <th>Capacity</th>
                            <th>City / State</th>
                            <th>Request Date</th>
                            <th>Stage</th>
                            @if (showPersonCol)
                            {
                                <th>@personColTitle</th>
                            }
                            @if (isHistoryMode)
                            {
                                <th>Details</th>
                            }
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            // Live m_membermaster name when the admin controller has enriched
                            // it, otherwise the stored ApplicantName.
                            var memberName = string.IsNullOrWhiteSpace(r.MemberFullName) ? r.ApplicantName : r.MemberFullName;

                            // --- Assigned person for this row -----------------------------
                            // material      → the installer picked at dispatch time
                            // installation  → the installer on the Installation record; before
                            //                 that record exists we show (and pre-select) the
                            //                 person already assigned in Material Dispatch.
                            string? personName = null;
                            int? personId = null;
                            var personFromDispatch = false;   // true = inherited, not yet confirmed
                            int? personInstallId = null;      // set only when a row can be edited

                            // Point 10: "INC change ka option nahi aa raha hai."
                            // The Change button used to render ONLY when an
                            // Installation row already existed, so on the material
                            // queues — and on an Installation row that had merely
                            // inherited its installer from the dispatch — there was
                            // no way to change the INC at all. Both queues now carry
                            // the dispatch id (personDispatchId) so the assignment
                            // can be changed wherever it is shown.
                            int? personDispatchId = null;

                            if (isMaterialOp && materialMap != null
                                && materialMap.TryGetValue(r.Id, out var matPerson))
                            {
                                personName = matPerson.AssignedWorker?.Name;
                                personId = matPerson.AssignedWorkerId;
                                personDispatchId = matPerson.Id;
                            }
                            else if (op == "installation")
                            {
                                if (installMap != null && installMap.TryGetValue(r.Id, out var insPerson))
                                {
                                    personName = insPerson.AssignedWorker?.Name;
                                    personId = insPerson.AssignedWorkerId;
                                    personInstallId = insPerson.Id;
                                }
                                if (dispatchMap != null && dispatchMap.TryGetValue(r.Id, out var dspPerson))
                                {
                                    personDispatchId = dspPerson.Id;
                                    if (personName == null)
                                    {
                                        personName = dspPerson.AssignedWorker?.Name;
                                        personId = dspPerson.AssignedWorkerId;
                                        personFromDispatch = true;
                                    }
                                }
                            }

                            <tr data-search="@($"{r.UserId} {memberName} {r.MobileNumber} {r.City} {r.State} {r.RequestNumber} {personName}".ToLower())"
                                data-mid="@r.UserId"
                                data-city="@r.City"
                                data-state="@r.State"
                                data-worker="@personName"
                                data-date="@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")">
                                <td class="td-b">
                                    <a asp-area="SolarPanelAdmin" asp-controller="Projects" asp-action="Details"
                                       asp-route-id="@r.Id" style="color:var(--sun)">@r.RequestNumber</a>
                                </td>
                                <td><span class="mid-code">@r.UserId</span></td>
                                <td>
                                    @memberName
                                    <div style="font-size:11px;color:var(--text3)">@r.MobileNumber</div>
                                </td>
                                @* Plan cell missing tha — header mein Plan/Type/Capacity
                                   3 columns hain, body mein sirf 2 cells the. Isse poori
                                   row ek column left shift ho jati thi (Processed badge
                                   Details ke neeche, Action khali). *@
                                <td><partial name="_PlanCell" model="r" /></td>
                                <td>@r.ConnectionType</td>
                                <td>@r.KVCapacity kV</td>
                                <td>@r.City<div style="font-size:11px;color:var(--text3)">@r.State</div></td>
                                <td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="sts sts-disp">@r.CurrentStage.ToString().Replace("_", " ")</span>
                                    @if (op == "meter")
                                    {
                                        // The project stage says nothing about the meter - spell the
                                        // meter out so a "Completed" project cannot be read as
                                        // "meter done".
                                        SolarPortal.Domain.Entities.MeterDispatch? stageMeter = null;
                                        meterMap?.TryGetValue(r.Id, out stageMeter);
                                        <div style="font-size:11px;margin-top:4px;color:var(--text3)">
                                            @(stageMeter?.IsDispatched == true ? "meter dispatched" : "meter pending")
                                        </div>
                                    }
                                </td>
                                @if (showPersonCol)
                                {
                                    <td style="font-size:12px">
                                        @if (!string.IsNullOrWhiteSpace(personName))
                                        {
                                            <div class="td-b">👷 @personName</div>
                                            if (personFromDispatch)
                                            {
                                                <div style="font-size:11px;color:var(--text3)">from Material Dispatch</div>
                                            }
                                            @* Point 10: offer Change wherever an installer is shown.
                                               Whichever id we have decides which record gets updated —
                                               the Installation row when one exists, otherwise the
                                               MaterialDispatch row the assignment actually lives on. *@
                                            <button type="button" class="btn btn-s btn-sm" style="margin-top:4px"
                                                    onclick="openChangeInstaller(@(personInstallId ?? 0), @(personDispatchId ?? 0), @r.Id, @(personId ?? 0), '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(personName))')">
                                                &#9999;&#65039; Change
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">— Not assigned —</span>
                                            @* Not assigned yet is exactly when this is most needed, so
                                               it is offered unconditionally - the server resolves (or
                                               creates) the record to hang the assignment on. *@
                                            <div>
                                                <button type="button" class="btn btn-s btn-sm" style="margin-top:4px"
                                                        onclick="openChangeInstaller(@(personInstallId ?? 0), @(personDispatchId ?? 0), @r.Id, 0, '')">
                                                    &#10133; Assign
                                                </button>
                                            </div>
                                        }
                                    </td>
                                }
                                @if (isHistoryMode)
                                {
                                    <td style="font-size:12px;max-width:240px">
                                        @* Render whatever dispatch record exists for this request, based on op.
                                           Both material steps read the same MaterialDispatch row. *@
                                        @switch (isMaterialOp ? "material" : op)
                                        {
                                            case "meter":
                                                if (meterMap != null && meterMap.TryGetValue(r.Id, out var m))
                                                {
                                                    <div><strong>#</strong> @m.MeterNumber</div>
                                                    if (!string.IsNullOrWhiteSpace(m.MeterType))
                                                    {

                                                        <div><strong>Type:</strong> @m.MeterType</div>
                                                    }
                                                    if (m.DispatchDate.HasValue)
                                                    {

                                                        <div><strong>Date:</strong> @m.DispatchDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(m.Remark))
                                                    {

                                                        <div style="color:var(--text3)">@m.Remark</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(m.DispatchDocumentPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@m.DispatchDocumentPath')" style="color:var(--sun)">📄 Document</a></div>
                                                    }
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                            case "material":
                                                if (materialMap != null && materialMap.TryGetValue(r.Id, out var mat))
                                                {
                                                    @* Point 6: which of the two steps this row has reached. *@
                                                    <div>
                                                        @if (mat.IsDispatched)
                                                        {
                                                            <span class="sts sts-act">🚚 Dispatched</span>
                                                        }
                                                        else if (mat.IsPrepared)
                                                        {
                                                            <span class="sts sts-disp">📋 Prepared</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted" style="font-size:11px">Not prepared</span>
                                                        }
                                                    </div>
                                                    @* Full details (items, quantities, history) live on the
                                                       dispatch View page — the cell only says where it stands. *@
                                                    var rowItemCount = matLines != null && matLines.TryGetValue(r.Id, out var rowLines) ? rowLines.Count : 0;
                                                    var owedCount = PendingLines(r.Id).Count;
                                                    if (rowItemCount > 0)
                                                    {
                                                        <div style="margin-top:4px;color:var(--text2)">@rowItemCount@(matTotal > 0 ? $" of {matTotal}" : "") items</div>
                                                    }
                                                    if (owedCount > 0)
                                                    {
                                                        <div style="color:var(--red);font-weight:600">⚠ @owedCount item(s) pending</div>
                                                    }
                                                    <a class="btn btn-s btn-sm" style="margin-top:6px"
                                                       asp-action="MaterialDispatchDetails" asp-route-id="@r.Id" asp-route-from="@op">👁 View</a>
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                            case "installation":
                                                if (installMap != null && installMap.TryGetValue(r.Id, out var inst))
                                                {
                                                    if (inst.InstallationDate.HasValue)
                                                    {

                                                        <div><strong>Date:</strong> @inst.InstallationDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                    }
                                                    if (inst.AssignedWorker != null)
                                                    {

                                                        <div><strong>Worker:</strong> @inst.AssignedWorker.Name</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(inst.Notes))
                                                    {

                                                        <div>@inst.Notes</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(inst.Remark))
                                                    {

                                                        <div style="color:var(--text3)">@inst.Remark</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(inst.CompletionPhotoPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@inst.CompletionPhotoPath')" style="color:var(--sun)">📷 Photo</a></div>
                                                    }
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                            case "dcr":
                                                if (dcrMap != null && dcrMap.TryGetValue(r.Id, out var dcr))
                                                {
                                                    if (!string.IsNullOrWhiteSpace(dcr.DCRNumber))
                                                    {

                                                        <div><strong>#</strong> @dcr.DCRNumber</div>
                                                    }
                                                    if (dcr.DCRDate.HasValue)
                                                    {

                                                        <div><strong>Date:</strong> @dcr.DCRDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(dcr.Remark))
                                                    {

                                                        <div style="color:var(--text3)">@dcr.Remark</div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(dcr.DocumentPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@dcr.DocumentPath')" style="color:var(--sun)">📄 DCR Document</a></div>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(dcr.WorkDocumentPath))
                                                    {
                                                        <div><a href="javascript:void(0)" onclick="openFileModal('@dcr.WorkDocumentPath')" style="color:var(--sun)">📄 Work Document</a></div>
                                                    }
                                                }
                                                else
                                                {

                                                    <span class="text-muted">—</span>
                                                }
                                                break;
                                        }
                                    </td>
                                }
                                <td>
                                    @{
                                        // Map the page's "op" to the stage it acts on. Both material
                                        // steps act on the MaterialDispatch stage.
                                        var actStage =
                                            op == "meter" ? SolarPortal.Domain.Enums.ProjectStatus.MeterDispatch :
                                            isMaterialOp ? SolarPortal.Domain.Enums.ProjectStatus.MaterialDispatch :
                                            op == "installation" ? SolarPortal.Domain.Enums.ProjectStatus.Installation :
                                            op == "dcr" ? SolarPortal.Domain.Enums.ProjectStatus.DCRUpdate :
                                                                   SolarPortal.Domain.Enums.ProjectStatus.Registration;
                                        var isActiveRow = r.CurrentStage == actStage;

                                        // The meter is NOT part of the stage chain - it can be
                                        // recorded before or after the survey moves the project on
                                        // (the same rule the MeterDispatch action filters Pending by).
                                        // Keying this column off the stage said "Processed" for any
                                        // project that had simply moved past MeterDispatch, so a
                                        // request whose meter was never dispatched looked done here
                                        // while the customer's own panel still said "awaiting meter".
                                        SolarPortal.Domain.Entities.MeterDispatch? rowMeter = null;
                                        meterMap?.TryGetValue(r.Id, out rowMeter);
                                        var meterDone = rowMeter?.IsDispatched == true;
                                        if (op == "meter") { isActiveRow = !meterDone; }

                                        // Point 6: the two material steps show different buttons, and
                                        // Final only offers itself once Prepare has been done.
                                        SolarPortal.Domain.Entities.MaterialDispatch? rowDispatch = null;
                                        materialMap?.TryGetValue(r.Id, out rowDispatch);
                                        var isPrepared = rowDispatch?.IsPrepared == true;
                                        var isDispatched = rowDispatch?.IsDispatched == true;
                                    }
                                    @* Items sent short at Final Dispatch can follow later, whatever
                                       stage the project has moved on to. *@
                                    @if (op == "final" && isDispatched && PendingLines(r.Id).Any())
                                    {
                                        <button class="btn btn-primary btn-sm" style="margin-bottom:4px"
                                                onclick="openPendingDispatchForm(@r.Id, '@r.RequestNumber')">🚚 Dispatch Pending</button>
                                    }
                                    @* After the first dispatch, items not prepared then (e.g. the other
                                       16 of 32) can be prepared now and sent from Final Dispatch. *@
                                    @if (op == "prepare" && isDispatched && RemainingItems(r.Id) > 0)
                                    {
                                        <button class="btn btn-primary btn-sm" style="margin-bottom:4px"
                                                onclick="openPrepareMoreForm(@r.Id, '@r.RequestNumber')">➕ Prepare Remaining (@RemainingItems(r.Id))</button>
                                    }
                                    @if (isActiveRow)
                                    {
                                        @switch (op)
                                        {
                                            case "meter":
                                                <button class="btn btn-primary btn-sm" onclick="openMeterForm(@r.Id, '@r.RequestNumber')">📦 Dispatch Meter</button>
                                                break;
                                            case "material":
                                                <button class="btn btn-primary btn-sm" onclick="openMaterialForm(@r.Id, '@r.RequestNumber')">📦 Dispatch Material</button>
                                                break;
                                            case "prepare":
                                                if (isDispatched)
                                                {
                                                    <span class="sts sts-act">✅ Dispatched</span>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-primary btn-sm" onclick="openPrepareForm(@r.Id, '@r.RequestNumber')">
                                                        @(isPrepared ? "✏️ Edit Preparation" : "📋 Prepare for Dispatch")
                                                    </button>
                                                }
                                                break;
                                            case "final":
                                                if (isDispatched)
                                                {
                                                    <span class="sts sts-act">✅ Dispatched</span>
                                                }
                                                else if (isPrepared)
                                                {
                                                    <button class="btn btn-primary btn-sm" onclick="openFinalDispatchForm(@r.Id, '@r.RequestNumber')">🚚 Final Dispatch</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size:12px">Prepare it first</span>
                                                }
                                                break;
                                            case "installation":
                                                <button class="btn btn-primary btn-sm" onclick="openInstallForm(@r.Id, '@r.RequestNumber')">📝 Remark / Check Installer</button>
                                                @* Point 11: review the INC's photo batch and, on approval, credit them. *@
                                                @if (installMap != null && installMap.TryGetValue(r.Id, out var instForPhotos))
                                                {
                                                    var photoDict = ViewBag.InstallationPhotos as Dictionary<int, List<SolarPortal.Domain.Entities.InstallationPhoto>>;
                                                    var count = photoDict != null && photoDict.TryGetValue(r.Id, out var plist) ? plist.Count : 0;
                                                    var pStatus = instForPhotos.ApprovalStatus;
                                                    <button class="btn @(pStatus == SolarPortal.Domain.Enums.ApprovalStatus.Approved ? "btn-s" : "btn-primary") btn-sm"
                                                            onclick="openInstallPhotos(@instForPhotos.Id, '@r.RequestNumber')">
                                                        📷 Photos (@count)
                                                        @if (pStatus == SolarPortal.Domain.Enums.ApprovalStatus.Approved)
                                                        {
                                                            <text>✅</text>
                                                        }
                                                        else if (pStatus == SolarPortal.Domain.Enums.ApprovalStatus.Rejected)
                                                        {
                                                            <text>❌</text>
                                                        }
                                                    </button>
                                                    <a class="btn btn-s btn-sm" asp-action="InstallationDetails" asp-route-id="@instForPhotos.Id">👁 View</a>
                                                }
                                                break;
                                            case "dcr":
                                                @* Admin ka upload hi approval hai - alag approve button nahi. *@
                                                <button class="btn btn-primary btn-sm" onclick="openDCRForm(@r.Id, '@r.RequestNumber')">📄 Upload DCR &amp; Work</button>
                                                break;
                                        }
                                    }
                                    else if (op == "meter")
                                    {
                                        <span class="sts sts-act">✅ Meter dispatched</span>
                                    }
                                    else
                                    {
                                        <span class="sts sts-act">✅ Processed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="ct"><span class="ct-dot"></span>No @ViewBag.Title Queue</div>
            <div style="text-align:center;padding:40px;color:var(--text3)">
                <div style="font-size:48px;margin-bottom:16px">@GetEmptyIcon((string)ViewBag.Title)</div>
                <div style="font-size:18px;margin-bottom:8px">No @titleLower pending</div>
                <div>All eligible requests in the previous stage have been processed.</div>
            </div>
        </div>
    }
</div>

@functions {
    string GetEmptyIcon(string title) => title switch
    {
        "Meter Dispatch" => "📦",
        "Material Dispatch" => "📦",
        "Prepare for Dispatch" => "📋",
        "Final Dispatch" => "🚚",
        "Installation" => "🔧",
        "DCR & Work Upload" => "📄",
        _ => "📋"
    };
}

@* Hidden CSRF token holder for fetch() based form posts *@
<form id="csrfForm" style="display:none">@Html.AntiForgeryToken()</form>

@* Worker options reused in modals *@
@{
    var workerJson = System.Text.Json.JsonSerializer.Serialize(
        workers.Select(w => new { id = w.Id, name = w.Name, type = w.Type.ToString(), city = w.City ?? "" }));
}
<script id="workerOptions" type="application/json">@Html.Raw(workerJson)</script>

@* Existing DCR details (an admin's earlier upload, or a legacy user-submitted row)
   — used to pre-fill the DCR modal instead of typing it again. *@
@{
    var dcrDetailsForJson = ViewBag.DCRDetails as Dictionary<int, SolarPortal.Domain.Entities.DCRDocument>;
    var dcrJson = System.Text.Json.JsonSerializer.Serialize(
        (dcrDetailsForJson ?? new Dictionary<int, SolarPortal.Domain.Entities.DCRDocument>())
        .ToDictionary(
            kv => kv.Key.ToString(),
            kv => new
            {
                number = kv.Value.DCRNumber ?? "",
                date = kv.Value.DCRDate.HasValue ? kv.Value.DCRDate.Value.ToString("yyyy-MM-dd") : "",
                remark = kv.Value.Remark ?? "",
                docPath = kv.Value.DocumentPath ?? "",
                workDocPath = kv.Value.WorkDocumentPath ?? ""
            }));
}
<script id="dcrData" type="application/json">@Html.Raw(dcrJson)</script>

@* Person assigned during Material Dispatch, keyed by SolarRequestId. The
   Installation modal reads this to pre-select the installer instead of asking
   the admin to pick the same person a second time. *@
@{
    var dispatchForJson = ViewBag.DispatchAssignments as Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>;
    var dispatchJson = System.Text.Json.JsonSerializer.Serialize(
        (dispatchForJson ?? new Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>())
        .Where(kv => kv.Value.AssignedWorkerId.HasValue)
        .ToDictionary(
            kv => kv.Key.ToString(),
            kv => new
            {
                workerId = kv.Value.AssignedWorkerId!.Value,
                workerName = kv.Value.AssignedWorker?.Name ?? ""
            }));
}
<script id="dispatchAssignData" type="application/json">@Html.Raw(dispatchJson)</script>

@* Existing Installation rows, keyed by SolarRequestId — the admin modal shows the
   saved remark and the installer already on record (falling back to the dispatch
   assignment when no Installation row exists yet). *@
@{
    var installForJson = ViewBag.InstallationDetails as Dictionary<int, SolarPortal.Domain.Entities.Installation>;
    var installJson = System.Text.Json.JsonSerializer.Serialize(
        (installForJson ?? new Dictionary<int, SolarPortal.Domain.Entities.Installation>())
        .ToDictionary(
            kv => kv.Key.ToString(),
            kv => new
            {
                installationId = kv.Value.Id,
                workerId = kv.Value.AssignedWorkerId,
                workerName = kv.Value.AssignedWorker?.Name ?? "",
                remark = kv.Value.Remark ?? "",
                isCompleted = kv.Value.IsCompleted
            }));
}
<script id="installData" type="application/json">@Html.Raw(installJson)</script>

@* Plan commission state per request, so the Material Dispatch modal can warn
   when the project's plan has no INC commission configured. *@
@{
    var plansById = ViewBag.PlansById as Dictionary<int, SolarPortal.Domain.Entities.SolarProject>;
    var planCommJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ToDictionary(
            r => r.Id.ToString(),
            r =>
            {
                SolarPortal.Domain.Entities.SolarProject? p = null;
                if (r.SolarProjectId.HasValue && plansById != null)
                    plansById.TryGetValue(r.SolarProjectId.Value, out p);
                var amt = p?.IncCommissionAmount ?? 0m;
                return new { planName = p?.Name ?? r.SelectedPlan ?? "", amount = amt, isSet = amt > 0m };
            }));
}
<script id="planCommData" type="application/json">@Html.Raw(planCommJson)</script>

@* Point 6: what step-1 already recorded, so the Prepare modal re-opens with the
   saved values instead of a blank form, and Final can show what is going out. *@
@{
    var matForJson = ViewBag.MaterialDetails as Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>;
    var matLinesForJson = ViewBag.MaterialDispatchItems as Dictionary<int, List<SolarPortal.Domain.Entities.MaterialDispatchItem>>
                          ?? new Dictionary<int, List<SolarPortal.Domain.Entities.MaterialDispatchItem>>();
    var matMasterJson = System.Text.Json.JsonSerializer.Serialize(
        ((ViewBag.MaterialItemMaster as List<SolarPortal.Domain.Entities.MaterialItem>) ?? new List<SolarPortal.Domain.Entities.MaterialItem>())
        .Select(i => new { id = i.Id, name = i.Name }));
    var matJson = System.Text.Json.JsonSerializer.Serialize(
        (matForJson ?? new Dictionary<int, SolarPortal.Domain.Entities.MaterialDispatch>())
        .ToDictionary(
            kv => kv.Key.ToString(),
            kv => new
            {
                materialDetails = kv.Value.MaterialDetails ?? "",
                vehicleDetails = kv.Value.VehicleDetails ?? "",
                prepareRemark = kv.Value.PrepareRemark ?? "",
                remark = kv.Value.Remark ?? "",
                workerId = kv.Value.AssignedWorkerId,
                workerName = kv.Value.AssignedWorker?.Name ?? "",
                isPrepared = kv.Value.IsPrepared,
                isDispatched = kv.Value.IsDispatched,
                preparedAt = kv.Value.PreparedAt.HasValue ? kv.Value.PreparedAt.Value.ToLocalTime().ToString("dd MMM yyyy") : "",
                items = (matLinesForJson.TryGetValue(kv.Key, out var ls) ? ls : new List<SolarPortal.Domain.Entities.MaterialDispatchItem>())
                        .Select(l => new { id = l.MaterialItemId, name = l.ItemName, qty = l.Quantity, sent = l.DispatchedQuantity })
            }));
}
<script id="materialData" type="application/json">@Html.Raw(matJson)</script>
<script id="materialMaster" type="application/json">@Html.Raw(matMasterJson)</script>

@* Point 11: the INC's mark-installed photos, keyed by InstallationId so the
   review modal can render the whole batch, plus the batch's approval state. *@
@{
    var photoMap = ViewBag.InstallationPhotos as Dictionary<int, List<SolarPortal.Domain.Entities.InstallationPhoto>>
                   ?? new Dictionary<int, List<SolarPortal.Domain.Entities.InstallationPhoto>>();
    var installsForPhotos = ViewBag.InstallationDetails as Dictionary<int, SolarPortal.Domain.Entities.Installation>
                            ?? new Dictionary<int, SolarPortal.Domain.Entities.Installation>();

    var photosJson = System.Text.Json.JsonSerializer.Serialize(
        installsForPhotos.ToDictionary(
            kv => kv.Value.Id.ToString(),
            kv => (photoMap.TryGetValue(kv.Key, out var list) ? list : new List<SolarPortal.Domain.Entities.InstallationPhoto>())
                  .Select(p => new { path = p.FilePath, name = p.FileName })));

    var photoMetaJson = System.Text.Json.JsonSerializer.Serialize(
        installsForPhotos.ToDictionary(
            kv => kv.Value.Id.ToString(),
            kv => new
            {
                status = kv.Value.ApprovalStatus.ToString(),
                remark = kv.Value.RejectionReason ?? "",
                credited = kv.Value.CommissionCredited
            }));
}
<script id="installPhotoData" type="application/json">@Html.Raw(photosJson)</script>
<script id="installPhotoMetaData" type="application/json">@Html.Raw(photoMetaJson)</script>

@section Scripts {
    <script>
        const workerData = JSON.parse(document.getElementById('workerOptions').textContent || '[]');
        const dcrData = JSON.parse(document.getElementById('dcrData').textContent || '{}');
        const dispatchAssign = JSON.parse(document.getElementById('dispatchAssignData').textContent || '{}');
        const installData = JSON.parse(document.getElementById('installData').textContent || '{}');
        const planComm = JSON.parse(document.getElementById('planCommData')?.textContent || '{}');
        const materialData = JSON.parse(document.getElementById('materialData')?.textContent || '{}');
        const materialMaster = JSON.parse(document.getElementById('materialMaster')?.textContent || '[]');

        // Material list (Solar Module, Inverter, ...) with a quantity box per item.
        // No checkboxes at Prepare — every listed item goes; quantity defaults to 1.
        // excludeIds: items to leave out (already on the dispatch — "Prepare Remaining").
        function materialItemsTableHtml(saved, excludeIds) {
        const skip = new Set(excludeIds || []);
        const list = materialMaster.filter(m => !skip.has(m.id));
        if (!materialMaster.length) return '<div style="color:#6b7280;font-size:12px">No material items set up yet.</div>';
        if (!list.length) return '<div style="color:#6b7280;font-size:12px">Every item on the list is already prepared.</div>';
        const qtyOf = {};
        (saved || []).forEach(s => qtyOf[s.id] = s.qty);
        return `<div style="max-height:260px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:8px;margin:4px 0 8px">
        <table style="width:100%;border-collapse:collapse;font-size:12.5px">
        <thead><tr style="background:#f9fafb;position:sticky;top:0;z-index:1">
        <th style="padding:6px 8px;text-align:left;width:32px">#</th>
        <th style="padding:6px 8px;text-align:left">Particular</th>
        <th style="padding:6px 8px;text-align:left;width:110px">Quantity</th></tr></thead>
        <tbody>${list.map((m, i) => `
        <tr style="border-top:1px solid #f3f4f6">
        <td style="padding:4px 8px;color:#6b7280">${i + 1}</td>
        <td style="padding:4px 8px">${esc(m.name)}</td>
        <td style="padding:4px 8px"><input type="number" min="0" step="any" class="mat-qty" data-id="${m.id}" value="${qtyNum(qtyOf[m.id]) ?? 1}"
             placeholder="Qty" style="width:100%;padding:4px 6px;border:1px solid #d1d5db;border-radius:6px;font-size:12.5px"></td>
        </tr>`).join('')}</tbody></table></div>`;
        }

        // Leading number of a quantity ("8", "20 m" → 20), or null.
        const qtyNum = s => { const m = /^\s*(\d+(?:\.\d+)?)/.exec(s == null ? '' : String(s)); return m ? +m[1] : null; };
        const fmtQ = n => (Math.round(n * 100) / 100).toString();
        const pendingOf = s => { const p = qtyNum(s.qty); return p == null ? 0 : Math.max(0, p - (+s.sent || 0)); };

        // Prepare for Dispatch no longer asks which products go: every active item
        // on the material list is prepared together. A quantity an earlier
        // preparation recorded is kept; anything else counts as 1, so an item
        // unticked at Final Dispatch has something left to show as pending.
        function allMaterialItems(saved) {
        const qtyOf = {};
        (saved || []).forEach(s => qtyOf[s.id] = s.qty);
        return materialMaster.map(m => ({ id: m.id, qty: qtyNum(qtyOf[m.id]) != null ? String(qtyOf[m.id]) : '1' }));
        }

        // Checklist shared by Final Dispatch and Dispatch Pending. Every row starts
        // ticked; untick what is not going out now. A ticked item is sent in full,
        // an unticked one stays pending for Dispatch Pending.
        //   mode 'final'   — every prepared item.
        //   mode 'pending' — only items still owed.
        function sendItemsTableHtml(saved, mode) {
        const rows = (saved || []).filter(s => mode === 'final' || pendingOf(s) > 0);
        if (!rows.length)
        return `<div style="color:#6b7280;font-size:12px;margin:4px 0 8px">${mode === 'final'
        ? 'No material list was recorded at Prepare for Dispatch.' : 'Nothing is pending.'}</div>`;
        const head = mode === 'final'
        ? '<th style="padding:6px 8px;text-align:left;width:80px">Qty</th>'
        : '<th style="padding:6px 8px;text-align:left;width:70px">Pending</th>';
        return `<div style="max-height:300px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:8px;margin:4px 0 8px">
        <table style="width:100%;border-collapse:collapse;font-size:12.5px">
        <thead><tr style="background:#f9fafb;position:sticky;top:0;z-index:1">
        <th style="padding:6px 8px;text-align:center;width:34px"><input type="checkbox" id="send-all" checked title="Select all" style="width:16px;height:16px;cursor:pointer"></th>
        <th style="padding:6px 8px;text-align:left;width:32px">#</th>
        <th style="padding:6px 8px;text-align:left">Particular</th>${head}</tr></thead>
        <tbody>${rows.map((s, i) => {
        const prep = qtyNum(s.qty), pend = pendingOf(s);
        const full = mode === 'final' ? (prep != null ? fmtQ(prep) : '') : fmtQ(pend);
        const shown = mode === 'final' ? (esc(s.qty) || '—') : fmtQ(pend);
        return `<tr style="border-top:1px solid #f3f4f6">
        <td style="padding:6px 8px;text-align:center"><input type="checkbox" class="send-chk" id="send-chk-${s.id}" data-id="${s.id}"
             data-full="${full}" checked style="width:17px;height:17px;cursor:pointer"></td>
        <td style="padding:6px 8px;color:#6b7280">${i + 1}</td>
        <td style="padding:6px 8px"><label for="send-chk-${s.id}" style="cursor:pointer;margin:0">${esc(s.name)}</label></td>
        <td style="padding:6px 8px;color:#6b7280">${shown}</td></tr>`;
        }).join('')}</tbody></table></div>`;
        }

        // "Select all" box of the dispatch checklist. Call from the modal's didOpen.
        function wireSendChecks() {
        const all = document.getElementById('send-all');
        const chks = () => Array.from(document.querySelectorAll('.send-chk'));
        if (!all) return;
        all.addEventListener('change', () => chks().forEach(c => c.checked = all.checked));
        chks().forEach(c => c.addEventListener('change', () => { all.checked = chks().every(x => x.checked); }));
        }

        // Ticked = sent in full, unticked = 0 (stays pending). Returns { items, ticked }.
        function collectSendItems() {
        const items = [];
        let ticked = 0;
        for (const el of document.querySelectorAll('.send-chk')) {
        if (el.checked) ticked++;
        items.push({ id: +el.dataset.id, qty: el.checked ? el.dataset.full : '0' });
        }
        return { items, ticked };
        }

        // Every listed item goes, with the quantity typed against it.
        function collectMaterialItems() {
        return Array.from(document.querySelectorAll('.mat-qty')).map(q =>
        ({ id: +q.dataset.id, qty: q.value.trim() }));
        }

        const installPhotos = JSON.parse(document.getElementById('installPhotoData')?.textContent || '{}');
        const installPhotoMeta = JSON.parse(document.getElementById('installPhotoMetaData')?.textContent || '{}');
        const maxInstallPhotos = @SolarPortal.AdminWeb.Areas.SolarPanelAdmin.Controllers.OperationsController.MaxInstallationPhotos;
        const csrfToken = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]')?.value || '';
        const today = new Date().toISOString().split('T')[0];

        // ── Point 5: Camera / Gallery on every photo upload ────────────────
        // A bare <input type="file"> lets the phone OS decide, and on several
        // Android builds that means the gallery only — no way to shoot the photo
        // on the spot. capture="environment" forces the camera, but then a file
        // already on the device cannot be picked. So each upload renders BOTH
        // inputs behind two buttons, and pickedFile() reads whichever was used
        // (camera wins when, unusually, both hold a file).
        function photoPickerHtml(id, accept) {
        accept = accept || 'image/*,.pdf';
        return `
        <div class="file-pick" data-for="${id}">
          <div style="display:flex;gap:8px;margin:4px 0">
            <button type="button" class="swal2-styled file-pick-btn"
                    style="background:#0d9488;font-size:12px;padding:6px 12px;margin:0"
                    onclick="document.getElementById('${id}-cam').click()">📷 Camera</button>
            <button type="button" class="swal2-styled file-pick-btn"
                    style="background:#475569;font-size:12px;padding:6px 12px;margin:0"
                    onclick="document.getElementById('${id}-gal').click()">🖼️ Gallery</button>
          </div>
          <input id="${id}-cam" type="file" accept="image/*" capture="environment" style="display:none"
                 onchange="filePicked('${id}','cam')">
          <input id="${id}-gal" type="file" accept="${accept}" style="display:none"
                 onchange="filePicked('${id}','gal')">
          <div id="${id}-name" style="font-size:11px;color:#6b7280">No file chosen</div>
        </div>`;
        }

        // Show what was picked, and make the two inputs mutually exclusive so the
        // last choice is unambiguously the one that gets uploaded.
        function filePicked(id, which) {
        const other = which === 'cam' ? 'gal' : 'cam';
        const chosen = document.getElementById(id + '-' + which);
        const otherEl = document.getElementById(id + '-' + other);
        if (otherEl) otherEl.value = '';
        const label = document.getElementById(id + '-name');
        if (label) {
        label.textContent = chosen && chosen.files[0]
        ? (which === 'cam' ? '📷 ' : '🖼️ ') + chosen.files[0].name
        : 'No file chosen';
        }
        }

        function pickedFile(id) {
        const cam = document.getElementById(id + '-cam');
        const gal = document.getElementById(id + '-gal');
        return (cam && cam.files[0]) || (gal && gal.files[0]) || null;
        }


        // Escape for safely injecting values into the SweetAlert HTML string.
        const esc = s => (s == null ? '' : String(s))
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');

        // `selectedId` pre-selects a worker (used to carry the Material Dispatch
        // assignment into Installation). `fallbackName` covers the case where that
        // worker is no longer in the available list — we still show them selected
        // instead of silently dropping the existing assignment.
        function workerOptionsHtml(includeBlank=true, selectedId=null, fallbackName='') {
        const sel = selectedId ? String(selectedId) : '';
        const blank = includeBlank ? `<option value="" ${sel ? '' : 'selected'}>— Not assigned —</option>` : '';
        const known = workerData.some(w => String(w.id) === sel);
        const extra = (sel && !known)
        ? `<option value="${esc(sel)}" selected>${esc(fallbackName || 'Currently assigned')}</option>`
        : '';
        return blank + extra + workerData.map(w =>
        `<option value="${w.id}" ${String(w.id) === sel ? 'selected' : ''}>${esc(w.name)} (${esc(w.type)}, ${esc(w.city || '')})</option>`
        ).join('');
        }

        async function postForm(url, formData, msgOnFail='Failed') {
        formData.append('__RequestVerificationToken', csrfToken);
        try {
        const r = await fetch(url, { method: 'POST', body: formData });
        const d = await r.json();
        return d;
        } catch (e) {
        return { success: false, message: msgOnFail };
        }
        }

        function openMeterForm(requestId, requestNumber) {
        Swal.fire({
        title: '📦 Meter Dispatch — ' + requestNumber,
        html: `
        <div style="text-align:left;font-size:13px">
        <label>Meter Number *</label>
        <input id="f-meter-num" type="text" class="swal2-input" required>
        <label>Meter Type *</label>
        <select id="f-meter-type" class="swal2-input">
        <option value="Single Phase">Single Phase</option>
        <option value="Three Phase">Three Phase</option>
        </select>
        <label>Dispatch Date *</label>
        <input id="f-meter-date" type="date" class="swal2-input" value="${today}">
        <label>Remark</label>
        <textarea id="f-meter-remark" class="swal2-textarea" placeholder="Courier / tracking / notes"></textarea>
        <label>Document / Photo (optional)</label>
        ${photoPickerHtml('f-meter-doc', '.pdf,.jpg,.jpeg,.png')}
        </div>`,
        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        confirmButtonText: 'Dispatch',
        preConfirm: async () => {
        const num = document.getElementById('f-meter-num').value.trim();
        if (!num) { Swal.showValidationMessage('Meter number is required'); return false; }
        const fd = new FormData();
        fd.append('requestId', requestId);
        fd.append('meterNumber', num);
        fd.append('meterType', document.getElementById('f-meter-type').value);
        fd.append('dispatchDate', document.getElementById('f-meter-date').value);
        fd.append('remark', document.getElementById('f-meter-remark').value);
        const file = pickedFile('f-meter-doc');
        if (file) fd.append('dispatchDoc', file);
        return await postForm('/SolarPanelAdmin/Operations/SubmitMeterDispatch', fd);
        }
        }).then(r => {
        if (r.isConfirmed && r.value && r.value.success) {
        Swal.fire('Done', r.value.message, 'success').then(() => location.reload());
        } else if (r.isConfirmed) {
        Swal.fire('Error', (r.value && r.value.message) || 'Failed', 'error');
        }
        });
        }

        // Commission only matters for INC installers — they are the ones who earn
        // it. A JOB worker is salaried, so a plan with no commission amount is
        // irrelevant there and must not block the dispatch.
        //
        // For an INC installer on a plan with no amount configured, dispatching
        // would silently create an assignment that can never pay out, so that
        // combination is blocked here and again server-side.
        function matWorkerType(id) {
        const w = workerData.find(x => String(x.id) === String(id));
        return w ? String(w.type || '').toUpperCase() : '';
        }

        function matCommNote(requestId) {
        const pc = planComm[requestId] || {};
        const sel = document.getElementById('f-mat-worker');
        const type = matWorkerType(sel ? sel.value : '');
        const box = document.getElementById('f-mat-comm');
        if (!box) return;

        if (type !== 'INC') { box.innerHTML = ''; return; }

        const planLabel = pc.planName ? '&ldquo;' + esc(pc.planName) + '&rdquo;' : 'selected';
        box.innerHTML = pc.isSet
        ? `<div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:8px 10px;border-radius:8px;margin-bottom:10px;font-size:12.5px">
             Commission for <strong>${esc(pc.planName)}</strong>: <strong>₹${Number(pc.amount).toLocaleString('en-IN')}</strong> per project.</div>`
        : `<div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:8px 10px;border-radius:8px;margin-bottom:10px;font-size:12.5px">
             <strong>No commission is set for the ${planLabel} plan.</strong>
             This installer is an INC worker, so dispatch is blocked until a commission amount is added.
             Open <strong>INC Commission &rarr; Set Plan Commission</strong> to add it.</div>`;
        }

        function openMaterialForm(requestId, requestNumber) {
        Swal.fire({
        title: '📦 Material Dispatch — ' + requestNumber,
        html: `
        <div style="text-align:left;font-size:13px">
        <div id="f-mat-comm"></div>
        <label>Material Details</label>
        <textarea id="f-mat-detail" class="swal2-textarea" placeholder="Solar panels, inverter, wiring, mounts..."></textarea>
        <label>Dispatch Date *</label>
        <input id="f-mat-date" type="date" class="swal2-input" value="${today}">
        <label>Vehicle / Courier</label>
        <input id="f-mat-veh" type="text" class="swal2-input" placeholder="RJ-14-AB-1234 / DTDC AWB...">
        <label>Installer (Worker) *</label>
        <select id="f-mat-worker" class="swal2-input">${workerOptionsHtml()}</select>
        <label>Remark</label>
        <textarea id="f-mat-remark" class="swal2-textarea"></textarea>
        <label>Document (optional)</label>
        ${photoPickerHtml('f-mat-doc', '.pdf,.jpg,.jpeg,.png')}
        </div>`,
        background: '#ffffff', color: '#1f2937',
        showCancelButton: true,
        confirmButtonText: 'Dispatch',
        didOpen: () => {
        // The note depends on which installer is picked, so it is rendered on
        // open and refreshed on every change rather than baked into the HTML.
        const sel = document.getElementById('f-mat-worker');
        if (sel) sel.addEventListener('change', () => matCommNote(requestId));
        matCommNote(requestId);
        },
        preConfirm: async () => {
        // Worker assignment is mandatory — block submit until assigned.
        const w = document.getElementById('f-mat-worker').value;
        if (!w) { Swal.showValidationMessage('Please assign an installer before dispatching.'); return false; }

        const pc = planComm[requestId] || {};
        if (matWorkerType(w) === 'INC' && !pc.isSet) {
        Swal.showValidationMessage(
        'No commission is set for the ' + (pc.planName ? '"' + pc.planName + '"' : 'selected') +
        ' plan. Add the commission amount in INC Commission before dispatching to an INC installer.');
        return false;
        }

        const fd = new FormData();
        fd.append('requestId', requestId);
        fd.append('materialDetails', document.getElementById('f-mat-detail').value);
        fd.append('dispatchDate', document.getElementById('f-mat-date').value);
        fd.append('vehicleDetails', document.getElementById('f-mat-veh').value);
        fd.append('remark', document.getElementById('f-mat-remark').value);
        fd.append('workerId', w);
        const file = pickedFile('f-mat-doc');
        if (file) fd.append('dispatchDoc', file);
        return await postForm('/SolarPanelAdmin/Operations/SubmitMaterialDispatch', fd);
        }
        }).then(r => {
