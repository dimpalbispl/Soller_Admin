                  onclick="document.getElementById('f-dcr-gal').click()">🖼️ Gallery</button>
        </div>
        <input id="f-dcr-cam" type="file" accept="image/*" capture="environment" style="display:none">
        <input id="f-dcr-gal" type="file" accept=".pdf,.jpg,.jpeg,.png" multiple style="display:none">
        <div id="f-dcr-list" style="font-size:12px;color:#6b7280">No file chosen (0 / 2)</div>
