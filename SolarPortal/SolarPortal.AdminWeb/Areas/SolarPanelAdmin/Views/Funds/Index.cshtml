@using SolarPortal.Domain.Entities
@{
    ViewData["Title"] = "Add Fund";

    var history  = (List<Payment>)(ViewBag.History ?? new List<Payment>());
    var requests = (Dictionary<int, SolarRequest>)(ViewBag.Requests ?? new Dictionary<int, SolarRequest>());
    var filter   = (ViewBag.Filter as string) ?? "all";
    var myId     = (ViewBag.MyId as string) ?? "";

    // Deliberately NOT called "page" — Razor parses a bare @page as the page directive.
    var pageNo     = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var total      = (int)(ViewBag.TotalCount ?? 0);
    var pageSize   = (int)(ViewBag.PageSize ?? 10);

    var cntAll      = (int)(ViewBag.CountAll ?? 0);
    var cntPending  = (int)(ViewBag.CountPending ?? 0);
    var cntVerified = (int)(ViewBag.CountVerified ?? 0);
    var cntRejected = (int)(ViewBag.CountRejected ?? 0);

    var firstOnPage = total == 0 ? 0 : ((pageNo - 1) * pageSize) + 1;
    var lastOnPage  = System.Math.Min(pageNo * pageSize, total);
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>Add Fund</span></div>
        <div class="ph-title">Add Fund</div>
        <div class="ph-sub">Record the money — it is credited once you verify it in Payment Verification.</div>
    </div>

    @* Money added here is not credited on save, so say it up front rather than
       letting an admin discover it when the project total does not move. *@
    <div class="card" style="margin-bottom:14px;border-left:4px solid var(--sun)">
        <div style="padding:12px 14px;font-size:13px">
            A fund added here is <strong>not credited yet</strong>. It appears as a
            <strong>Pending</strong> row in <strong>Payment Verification</strong> — verify it
            there and the member gets the fund, reject it and it never counts. Until then it
            does not count toward the project total and nothing in the workflow moves.
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="ct"><span class="ct-dot"></span>Fund Details</div>
        <form id="addFundForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            @* Member ID first — that is what an admin has to hand. The name and
               project are fetched from it, so there is no long project dropdown to
               scroll and no chance of picking the row above the one intended. *@
            <div class="fr3">
                <div class="fg">
                    <label>Member ID *</label>
                    <div style="display:flex;gap:8px">
                        <input type="text" id="fundMemberId" placeholder="e.g. SADHNATEST05"
                               autocomplete="off" style="flex:1" />
                        <button type="button" class="btn btn-s btn-sm" id="btnFindMember">🔍 Find</button>
                    </div>
                    <input type="hidden" name="solarRequestId" id="fundRequestId" />
                    <div id="fundLookupMsg" style="font-size:11.5px;margin-top:4px"></div>
                </div>
                <div class="fg">
                    <label>Amount (₹) *</label>
                    <input type="number" name="amount" id="fundAmount" step="0.01" min="1" required placeholder="e.g. 20000" />
                </div>
                <div class="fg">
                    <label>UTR / Transaction No. *</label>
                    @* Checked as it is typed - a clash used to appear only after the
                       whole form was filled in and saved. *@
                    <input type="text" name="utrNumber" id="fundUtr" required autocomplete="off"
                           placeholder="Bank UTR / reference" />
                    <div id="fundUtrMsg" style="font-size:11.5px;margin-top:4px"></div>
                </div>
            </div>

            @* Filled in by the lookup. Everything below stays disabled until a
               member resolves, so a fund can never be saved against nobody. *@
            <div id="fundMemberCard" style="display:none;margin-bottom:12px"></div>

            <div class="fr3">
                <div class="fg">
                    <label>Payment Date</label>
                    <input type="date" name="paymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="fg">
                    <label>Reference No.</label>
                    <input type="text" name="referenceNumber" placeholder="Optional" />
                </div>
                <div class="fg">
                    <label>Receipt (Camera / Gallery)</label>
                    @* Point 5: camera and gallery offered separately — a phone handed
                       a plain file input often shows only the gallery. *@
                    <div style="display:flex;gap:8px;margin-bottom:4px">
                        <button type="button" class="btn btn-s btn-sm" onclick="document.getElementById('fundReceiptCam').click()">📷 Camera</button>
                        <button type="button" class="btn btn-s btn-sm" onclick="document.getElementById('fundReceiptGal').click()">🖼️ Gallery</button>
                    </div>
                    <input type="file" id="fundReceiptCam" accept="image/*" capture="environment" style="display:none" />
                    <input type="file" id="fundReceiptGal" accept="image/*,.pdf" style="display:none" />
                    <div id="fundReceiptName" style="font-size:11px;color:var(--text3)">No file chosen</div>
                </div>
            </div>

            <div class="fg">
                <label>Notes</label>
                <textarea name="notes" rows="2" placeholder="Why this fund is being added"></textarea>
            </div>

            <button type="submit" class="btn btn-p" id="btnAddFund" disabled>
                💰 Add Fund &amp; Send for Verification
            </button>
            <span id="fundBlockedHint" style="font-size:12px;color:var(--text3);margin-left:8px">
                Find a member first.
            </span>
        </form>
    </div>

    @* Fund transfer history — "yahan se kab kab fund transfer hua". Paged so a long
       trail never turns this into an endless page. *@
    <div class="card">
        <div class="ct"><span class="ct-dot"></span>Fund Transfer History (@total)</div>

        <div style="display:flex;gap:8px;padding:12px 14px;flex-wrap:wrap;align-items:center">
            <a class="btn btn-sm @(filter == "all" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-filter="all">📋 All (@cntAll)</a>
            <a class="btn btn-sm @(filter == "pending" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-filter="pending">⏳ Pending (@cntPending)</a>
            <a class="btn btn-sm @(filter == "verified" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-filter="verified">✅ Verified (@cntVerified)</a>
            <a class="btn btn-sm @(filter == "rejected" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-filter="rejected">❌ Rejected (@cntRejected)</a>
        </div>

        @if (!history.Any())
        {
            <div style="padding:20px;color:var(--text3);font-size:13px">
                Nothing here yet. Every fund added from this page (or from the Add Fund button on
                Payment Verification) is listed here with its date, amount and status.
            </div>
        }
        else
        {
            <div class="tbl-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Added On</th>
                            <th>Request</th>
                            <th>Member</th>
                            <th>Amount</th>
                            <th>UTR</th>
                            <th>Added By</th>
                            <th>Receipt</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in history)
                        {
                            requests.TryGetValue(p.SolarRequestId, out var req);
                            var memberName = req == null
                                ? "—"
                                : (string.IsNullOrWhiteSpace(req.MemberFullName) ? req.ApplicantName : req.MemberFullName);
                            var addedByMe = string.Equals(p.FundAddedBy, myId, StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td style="white-space:nowrap">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="td-b">@(req?.RequestNumber ?? $"#{p.SolarRequestId}")</td>
                                <td>
                                    @memberName
                                    @if (req != null)
                                    {
                                        <div class="cell-sub">@req.UserId</div>
                                    }
                                </td>
                                <td class="td-b">₹@p.Amount.ToString("N0")</td>
                                <td>@p.UTRNumber</td>
                                <td style="font-size:12px">@(addedByMe ? "You" : p.FundAddedBy)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(p.ReceiptImagePath))
                                    {
                                        <a href="javascript:void(0)" onclick="openFileModal('@p.ReceiptImagePath')" style="color:var(--sun)">📄 View</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (p.IsVerified)
                                    {
                                        <span class="sts sts-act">✅ Verified</span>
                                        <div class="cell-sub">@((p.FundApprovedAt ?? p.VerifiedAt)?.ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</div>
                                    }
                                    else if (p.Status == SolarPortal.Domain.Enums.PaymentStatus.Rejected)
                                    {
                                        <span class="sts sts-rej">❌ Rejected</span>
                                        <div class="cell-sub">@p.FundRejectionReason</div>
                                    }
                                    else
                                    {
                                        <span class="sts sts-disp">⏳ Awaiting verification</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination — page numbers carry the active filter so paging never
               silently drops it. *@
            <div style="display:flex;gap:8px;padding:12px 14px;align-items:center;flex-wrap:wrap">
                <span style="font-size:12px;color:var(--text3)">
                    Showing @firstOnPage–@lastOnPage of @total
                </span>
                <div style="margin-left:auto;display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                    @if (pageNo > 1)
                    {
                        <a class="btn btn-sm btn-s" asp-action="Index" asp-route-filter="@filter" asp-route-page="@(pageNo - 1)">‹ Prev</a>
                    }
                    else
                    {
                        <span class="btn btn-sm btn-s" style="opacity:.45;pointer-events:none">‹ Prev</span>
                    }
                    <span style="font-size:12px;color:var(--text2)">Page @pageNo of @totalPages</span>
                    @if (pageNo < totalPages)
                    {
                        <a class="btn btn-sm btn-s" asp-action="Index" asp-route-filter="@filter" asp-route-page="@(pageNo + 1)">Next ›</a>
                    }
                    else
                    {
                        <span class="btn btn-sm btn-s" style="opacity:.45;pointer-events:none">Next ›</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_FileModal")

@section Scripts {
<script>
    const esc = s => (s == null ? '' : String(s))
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const msgBox   = document.getElementById('fundLookupMsg');
    const cardBox  = document.getElementById('fundMemberCard');
    const reqIdBox = document.getElementById('fundRequestId');
    const submitBtn= document.getElementById('btnAddFund');
    const hint     = document.getElementById('fundBlockedHint');
    const utrBox   = document.getElementById('fundUtr');
    const utrMsg   = document.getElementById('fundUtrMsg');

    // Save is allowed only when a project is resolved AND the typed UTR is free.
    let utrDuplicate = false;

    function syncSubmit(label) {
        const hasProject = !!reqIdBox.value;
        submitBtn.disabled = !hasProject || utrDuplicate;
        if (!hasProject) {
            hint.textContent = 'Find a member first.';
            hint.style.color = 'var(--text3)';
        } else if (utrDuplicate) {
            hint.textContent = 'This UTR is already used on this request.';
            hint.style.color = '#b91c1c';
        } else {
            hint.textContent = label || hint.dataset.label || '';
            hint.style.color = 'var(--text2)';
        }
    }

    function setProject(id, label) {
        reqIdBox.value = id || '';
        if (label) { hint.dataset.label = label; }
        if (!id) { hint.dataset.label = ''; }
        syncSubmit(label);
        // The same UTR can be free on one request and taken on another, so a
        // changed project re-asks the question.
        checkUtr();
    }

    // ── Live UTR duplicate check ──────────────────────────────────────────
    // Debounced so a fast typist does not fire a request per keystroke; the
    // sequence number drops answers that come back after a newer one.
    let utrTimer = null, utrSeq = 0;

    function showUtr(text, color) {
        utrMsg.textContent = text || '';
        utrMsg.style.color = color || 'var(--text3)';
    }

    async function runUtrCheck() {
        const utr = utrBox.value.trim();
        const reqId = reqIdBox.value;

        if (!utr || !reqId) { utrDuplicate = false; showUtr(''); syncSubmit(); return; }

        const seq = ++utrSeq;
        showUtr('Checking…', 'var(--text3)');

        try {
            const r = await fetch('@Url.Action("CheckUtr")?solarRequestId=' + encodeURIComponent(reqId)
                                  + '&utr=' + encodeURIComponent(utr));
            const d = await r.json();
            if (seq !== utrSeq) return;          // a newer keystroke already won
            utrDuplicate = !!d.duplicate;
            showUtr(utrDuplicate ? '⚠ ' + d.message : '✓ UTR is free', utrDuplicate ? '#b91c1c' : '#15803d');
        } catch (e) {
            if (seq !== utrSeq) return;
            // Never block on a network hiccup — the save re-checks server-side anyway.
            utrDuplicate = false;
            showUtr('Could not check this UTR right now.', 'var(--text3)');
        }
        syncSubmit();
    }

    function checkUtr() {
        clearTimeout(utrTimer);
        utrTimer = setTimeout(runUtrCheck, 350);
    }

    utrBox.addEventListener('input', checkUtr);
    utrBox.addEventListener('change', runUtrCheck);

    function clearLookup() {
        setProject('', '');
        cardBox.style.display = 'none';
        cardBox.innerHTML = '';
        msgBox.textContent = '';
    }

    document.getElementById('fundMemberId').addEventListener('input', clearLookup);

    async function findMember() {
        const id = document.getElementById('fundMemberId').value.trim();
        clearLookup();
        if (!id) { msgBox.textContent = 'Enter a Member ID.'; msgBox.style.color = '#b91c1c'; return; }

        msgBox.textContent = 'Searching…';
        msgBox.style.color = 'var(--text3)';

        let d;
        try {
            const r = await fetch('@Url.Action("Lookup")?memberId=' + encodeURIComponent(id));
            d = await r.json();
        } catch (e) {
            msgBox.textContent = 'Could not reach the server.';
            msgBox.style.color = '#b91c1c';
            return;
        }

        if (!d.found) {
            msgBox.textContent = d.message || 'Not found.';
            msgBox.style.color = '#b91c1c';
            return;
        }

        msgBox.textContent = '';

        const rows = d.requests || [];
        const header =
            `<div style="border:1px solid #bbf7d0;background:#f0fdf4;border-radius:10px;padding:12px">
               <div style="font-size:11px;color:#15803d;text-transform:uppercase;letter-spacing:.4px">Member</div>
               <div style="font-weight:700;font-size:16px;color:#166534">${esc(d.name)}</div>
               <div style="font-size:12px;color:#166534">${esc(d.memberId)}${d.mobile ? ' · ' + esc(d.mobile) : ''}${d.city ? ' · ' + esc(d.city) : ''}</div>`;

        // One live project resolves straight away; several are listed so the admin
        // says which, rather than the page silently choosing the newest.
        let body;
        if (rows.length === 1) {
            const p = rows[0];
            setProject(p.id, `Adding to ${p.requestNumber}`);
            body =
                `<div style="margin-top:10px;padding-top:10px;border-top:1px solid #bbf7d0;font-size:12.5px;color:#166534">
                   <strong>${esc(p.requestNumber)}</strong> · ${esc(p.plan || '')}<br>
                   Total ₹${Number(p.total).toLocaleString('en-IN')} ·
                   Paid ₹${Number(p.paid).toLocaleString('en-IN')} ·
                   <strong>Due ₹${Number(p.due).toLocaleString('en-IN')}</strong>
                   <span style="color:#6b7280"> · ${esc(p.stage)}</span>
                 </div>`;
        } else {
            body =
                `<div style="margin-top:10px;padding-top:10px;border-top:1px solid #bbf7d0">
                   <div style="font-size:12px;color:#166534;margin-bottom:6px">
                     This member has ${rows.length} projects — choose which one the money is for:
                   </div>
                   ${rows.map(p => `
                     <label style="display:block;font-size:12.5px;color:#166534;padding:4px 0;cursor:pointer">
                       <input type="radio" name="pickReq" value="${p.id}"
                              data-label="Adding to ${esc(p.requestNumber)}" style="width:auto;margin-right:6px">
                       <strong>${esc(p.requestNumber)}</strong> · ${esc(p.plan || '')} ·
                       Due ₹${Number(p.due).toLocaleString('en-IN')}
                       <span style="color:#6b7280"> · ${esc(p.stage)}</span>
                     </label>`).join('')}
                 </div>`;
        }

        cardBox.innerHTML = header + body + '</div>';
        cardBox.style.display = 'block';

        cardBox.querySelectorAll('input[name="pickReq"]').forEach(function (rb) {
            rb.addEventListener('change', function () { setProject(this.value, this.dataset.label); });
        });
    }

    document.getElementById('btnFindMember').addEventListener('click', findMember);
    document.getElementById('fundMemberId').addEventListener('keydown', function (e) {
        // Enter should look up, not submit a form that has no project yet.
        if (e.key === 'Enter') { e.preventDefault(); findMember(); }
    });

    // Camera / Gallery — last one used wins so the upload is never ambiguous.
    function fundPick(which) {
        var cam = document.getElementById('fundReceiptCam');
        var gal = document.getElementById('fundReceiptGal');
        var other = which === 'cam' ? gal : cam;
        if (other) other.value = '';
        var f = (which === 'cam' ? cam : gal).files[0];
        document.getElementById('fundReceiptName').textContent =
            f ? (which === 'cam' ? '📷 ' : '🖼️ ') + f.name : 'No file chosen';
    }
    document.getElementById('fundReceiptCam').addEventListener('change', function () { fundPick('cam'); });
    document.getElementById('fundReceiptGal').addEventListener('change', function () { fundPick('gal'); });

    document.getElementById('addFundForm').addEventListener('submit', function (e) {
        e.preventDefault();
        if (!reqIdBox.value) { Swal.fire('Pick a member', 'Find a Member ID first.', 'warning'); return; }
        if (utrDuplicate) {
            Swal.fire('Duplicate UTR', 'This UTR is already used on this request. Enter a different one.', 'warning');
            return;
        }

        var btn = submitBtn;
        var fd = new FormData(this);

        var cam = document.getElementById('fundReceiptCam').files[0];
        var gal = document.getElementById('fundReceiptGal').files[0];
        var file = cam || gal;
        if (file) fd.append('receiptImage', file);

        btn.disabled = true; btn.textContent = 'Saving…';
        fetch('@Url.Action("Add")', { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) {
                    Swal.fire('Sent for verification', d.message, 'success').then(function () { location.reload(); });
                } else {
                    Swal.fire('Could not add fund', d.message || 'Failed', 'error');
                    btn.textContent = '💰 Add Fund & Send for Verification'; syncSubmit();
                }
            })
            .catch(function () {
                Swal.fire('Error', 'Could not reach the server.', 'error');
                btn.disabled = false; btn.textContent = '💰 Add Fund & Send for Verification';
            });
    });
</script>
}
