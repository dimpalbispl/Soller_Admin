@model IEnumerable<SolarPortal.Domain.Entities.Payment>
@{
    ViewData["Title"] = "Payment Verification";
    var filter = ViewBag.Filter as string ?? "all";
    var requests = ViewBag.Requests as Dictionary<int, SolarPortal.Domain.Entities.SolarRequest>
                   ?? new Dictionary<int, SolarPortal.Domain.Entities.SolarRequest>();
    var paidMap = (Dictionary<int, decimal>)(ViewBag.PaidMap ?? new Dictionary<int, decimal>());
    // Point 1: paidMap already INCLUDES this, so every due on the page is correct.
    // It is carried separately only so a row can explain where the extra money came
    // from - "Paid 30,000" against 10,100 of payment rows otherwise reads as a bug.
    var depositMap = (Dictionary<int, decimal>)(ViewBag.DepositMap ?? new Dictionary<int, decimal>());
}

<div class="page-header" style="padding:16px">
    <h2>Payment Verification</h2>
    <p class="text-muted">Verify user-submitted payments. ₹20,000 cumulative minimum required to advance.</p>
</div>

<div class="container-fluid">
    <div class="mb-3" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <div>
            <a class="btn @(filter == "all" ? "btn-primary" : "btn-outline-primary")" asp-route-filter="all">All</a>
            <a class="btn @(filter == "pending" ? "btn-warning" : "btn-outline-warning")" asp-route-filter="pending">Pending</a>
            <a class="btn @(filter == "verified" ? "btn-success" : "btn-outline-success")" asp-route-filter="verified">Verified</a>
            <a class="btn @(filter == "rejected" ? "btn-danger" : "btn-outline-danger")" asp-route-filter="rejected">Rejected</a>
        </div>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
            ➕ Add Fund (needs approval)
        </button>
    </div>

    <!-- Admin Add-Payment Modal -->
    <div class="modal fade" id="addPaymentModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="adminAddPaymentForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Add Fund on User's Behalf</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        @* Point 7 turned this into step 1 of two. It used to credit
                           immediately; now it queues. Saying so here stops an admin
                           wondering why the project total did not move. *@
                        <div class="alert alert-warning" style="font-size:13px">
                            This is <strong>step 1 of 2</strong>. The money is recorded but
                            <strong>not credited</strong> until a <strong>different</strong> admin
                            approves it under <strong>Approve Fund</strong>.
                        </div>
                        <div class="alert alert-info" style="font-size:13px">
                            <strong>Admin entry</strong> — bypasses the ₹20,000 minimum and the project-total cap.
                            Payment is auto-verified.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Solar Request <span class="text-danger">*</span></label>
                                <select class="form-select" name="solarRequestId" id="adminPaySelectReq" required>
                                    <option value="">-- pick a request --</option>
                                    @foreach (var kv in requests)
                                    {
                                        var paid = paidMap.TryGetValue(kv.Key, out var pv) ? pv : 0m;
                                        var due  = System.Math.Max(0, kv.Value.PlanAmount - paid);
                                        <option value="@kv.Key"
                                                data-total="@kv.Value.PlanAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-paid="@paid.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-due="@due.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-applicant="@kv.Value.ApplicantName"
                                                data-reqno="@kv.Value.RequestNumber">
                                            @kv.Value.RequestNumber — @kv.Value.ApplicantName (₹@kv.Value.PlanAmount.ToString("N0"))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Amount (₹) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="1" class="form-control" name="amount" id="adminPayAmount" required />
                                <small id="adminPayAmountHint" class="form-text text-muted">Pick a request to see paid / due info.</small>
                            </div>

                            <!-- Live summary panel: appears once a request is picked -->
                            <div class="col-12" id="adminPayReqSummary" style="display:none">
                                <div class="card" style="background:#f0fdf4;border-left:4px solid #16a34a;padding:14px;margin:0">
                                    <div class="row g-2" style="font-size:13px">
                                        <div class="col-md-3">
                                            <div style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.04em">Request</div>
                                            <div style="font-weight:700" id="apSumReq">—</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.04em">Project Amount</div>
                                            <div style="font-weight:700;color:#0d9488" id="apSumTotal">₹0</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.04em">Already Paid</div>
                                            <div style="font-weight:700;color:#16a34a" id="apSumPaid">₹0</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.04em">Remaining Due</div>
                                            <div style="font-weight:700;color:#dc2626" id="apSumDue">₹0</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">UTR / Transaction No. <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="utrNumber" required maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Reference Number</label>
                                <input type="text" class="form-control" name="referenceNumber" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Payment Date</label>
                                <input type="date" class="form-control" name="paymentDate"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Receipt (Image / PDF)</label>
                                @* Point 5: Camera / Gallery — see wwwroot/js/photo-picker.js *@
                                <input type="file" class="form-control" name="receiptImage" accept="image/*,.pdf" data-photo-picker />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" name="notes" rows="2" placeholder="Optional remarks"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Save Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @{
        // Distinct requests visible in this filtered list
        var distinctReqs = Model.Select(m => m.SolarRequestId).Distinct().ToList();
        decimal sumProjectAmt = 0m;
        decimal sumPaidAcrossReqs = 0m;
        foreach (var rid in distinctReqs)
        {
            if (requests.TryGetValue(rid, out var rr)) sumProjectAmt += rr.PlanAmount;
            if (paidMap.TryGetValue(rid, out var pv))  sumPaidAcrossReqs += pv;
        }
        var sumDue = System.Math.Max(0, sumProjectAmt - sumPaidAcrossReqs);
        var sumThisPage = Model.Sum(m => m.Amount);
        var sumVerifiedThisPage = Model.Where(m => m.IsVerified).Sum(m => m.Amount);
    }

    <!-- Summary cards -->
    <div class="g4 mb-3" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:16px">
        <div style="background:linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);color:white;padding:20px;border-radius:8px;box-shadow:0 4px 12px rgba(59,130,246,0.15)">
            <div style="font-size:13px;opacity:0.9;font-weight:500">PAYMENTS VISIBLE</div>
            <div style="font-size:28px;font-weight:700;margin:8px 0">@Model.Count()</div>
            <div style="font-size:12px;opacity:0.85">₹@sumThisPage.ToString("N0") on this page</div>
        </div>
        <div style="background:linear-gradient(135deg, #10b981 0%, #065f46 100%);color:white;padding:20px;border-radius:8px;box-shadow:0 4px 12px rgba(16,185,129,0.15)">
            <div style="font-size:13px;opacity:0.9;font-weight:500">VERIFIED AMOUNT</div>
            <div style="font-size:28px;font-weight:700;margin:8px 0">₹@sumVerifiedThisPage.ToString("N0")</div>
            <div style="font-size:12px;opacity:0.85">Confirmed on this page</div>
        </div>
        <div style="background:linear-gradient(135deg, #f59e0b 0%, #b45309 100%);color:white;padding:20px;border-radius:8px;box-shadow:0 4px 12px rgba(245,158,11,0.15)">
            <div style="font-size:13px;opacity:0.9;font-weight:500">PROJECT TOTAL</div>
            <div style="font-size:28px;font-weight:700;margin:8px 0">₹@sumProjectAmt.ToString("N0")</div>
            <div style="font-size:12px;opacity:0.85">@distinctReqs.Count request(s)</div>
        </div>
        <div style="background:linear-gradient(135deg, #ef4444 0%, #991b1b 100%);color:white;padding:20px;border-radius:8px;box-shadow:0 4px 12px rgba(239,68,68,0.15)">
            <div style="font-size:13px;opacity:0.9;font-weight:500">OUTSTANDING DUE</div>
            <div style="font-size:28px;font-weight:700;margin:8px 0">₹@sumDue.ToString("N0")</div>
            <div style="font-size:12px;opacity:0.85">Across visible requests</div>
        </div>
    </div>

    @* Report filter — Member ID / City / State / Request date. *@
    @{
        ViewData["FilterTableId"] = "paymentsTable";
        ViewData["FilterPlaceholder"] = "Search by Member ID, name, mobile, request #, UTR, receipt #...";
        ViewData["FilterDateLabel"] = "Request Date";
    }
    @await Html.PartialAsync("_ReportFilterToolbar")

    @* ===== Payments list (card layout) =====
       Pehle yahan 20-column ka table tha jise hamesha horizontally scroll karna
       padta tha. Ab har payment ek card hai: upar 6 scannable fields, aur baaki
       saari detail (receipt #, UTR, city/state, amounts, dates) "Details" par
       expand hoti hai. Kuch bhi hataya nahi gaya — sirf chhupa hai jab tak chahiye
       na ho.

       Table ki jagah CSS grid isliye, kyunki table ke saath header aur body ke
       columns align nahi ho rahe the; grid mein header strip aur card dono ek hi
       `--pv-cols` template share karte hain, to alignment kabhi tut nahi sakta. *@
    <style>
        .pv-list, .pv-head { --pv-cols: 34px 1.5fr 1.9fr 1.05fr 1.25fr 1fr 1.05fr; }

        .pv-head {
            display: grid; grid-template-columns: var(--pv-cols); gap: 14px;
            padding: 11px 16px; background: #f9fafb;
            border: 1px solid #e5e7eb; border-bottom: 0;
            border-radius: 8px 8px 0 0;
            font-size: 11px; font-weight: 600; color: #6b7280;
            text-transform: uppercase; letter-spacing: .4px;
        }
        .pv-list { border: 1px solid #e5e7eb; border-radius: 0 0 8px 8px; background: #fff; overflow: hidden; }
        .pv-card { border-bottom: 1px solid #f3f4f6; }
        .pv-card:last-child { border-bottom: 0; }
        .pv-card:hover { background: #fcfdfe; }

        .pv-main {
            display: grid; grid-template-columns: var(--pv-cols); gap: 14px;
            padding: 12px 16px; align-items: start;
        }

        .pv-toggle {
            width: 24px; height: 24px; padding: 0; line-height: 1; font-size: 11px;
            border: 1px solid #e5e7eb; background: #fff; border-radius: 6px;
            color: #6b7280; cursor: pointer; transition: transform .15s, background .15s;
        }
        .pv-toggle:hover { background: #f3f4f6; }
        .pv-toggle[aria-expanded="true"] {
            transform: rotate(90deg); background: #ecfdf5; color: #059669; border-color: #a7f3d0;
        }

        /* Collapse class se hide karte hain, inline display se nahi — report filter
           toolbar inline display set karta hai, to dono bina takrae saath chalte hain. */
        .pv-detail.is-collapsed { display: none; }
        .pv-detail {
            background: #f9fafb; border-top: 1px dashed #e5e7eb;
            padding: 14px 16px 16px 54px;
        }
        .pv-detail-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 12px 18px;
        }
        .pdl { font-size: 10px; text-transform: uppercase; letter-spacing: .4px; color: #9ca3af; font-weight: 600; margin-bottom: 2px; }
        .pdv { font-size: 12.5px; color: #1f2937; word-break: break-word; }

        .pv-prog { height: 5px; background: #e5e7eb; border-radius: 3px; overflow: hidden; margin: 5px 0 3px; }
        .pv-prog > i { display: block; height: 100%; background: #10b981; border-radius: 3px; }
        /* Pagination. Page se bahar wale cards ko class se chhupate hain aur
           !important lagate hain, kyunki filter toolbar inline `display` set karta
           hai — bina !important ke inline value class ko haraa deti aur chhupe hue
           card wapas dikh jaate. */
        .pv-card.pv-page-hidden { display: none !important; }

        .pv-pager {
            display: flex; justify-content: space-between; align-items: center;
            gap: 12px; flex-wrap: wrap; margin-top: 12px;
            font-size: 12.5px; color: #6b7280;
        }
        .pv-pager-btns { display: flex; gap: 6px; flex-wrap: wrap; }
        .pv-pg {
            min-width: 32px; height: 32px; padding: 0 10px;
            border: 1px solid #e5e7eb; background: #fff; border-radius: 6px;
            color: #374151; font-size: 12.5px; cursor: pointer;
        }
        .pv-pg:hover:not(:disabled) { background: #f3f4f6; }
        .pv-pg.active { background: #10b981; border-color: #10b981; color: #fff; font-weight: 600; }
        .pv-pg:disabled { opacity: .45; cursor: default; }
        .pv-pg-gap { align-self: center; color: #9ca3af; padding: 0 2px; }

        /* Chhoti screen: grid ek column mein khul jaata hai aur header strip
           bemaani ho jaati hai, to use hata dete hain. */
        @@media (max-width: 1100px) {
            .pv-head { display: none; }
            .pv-main { grid-template-columns: 34px 1fr; row-gap: 8px; }
            .pv-detail { padding-left: 16px; }
        }
    </style>

    <div class="pv-head">
        <span></span>
        <span>Member</span>
        <span>Request / Plan</span>
        <span style="text-align:right">This Payment</span>
        <span>Payment Progress</span>
        <span>Status</span>
        <span style="text-align:center">Actions</span>
    </div>

    <div id="paymentsTable" class="pv-list">
    @foreach (var p in Model)
    {
        requests.TryGetValue(p.SolarRequestId, out var req);
        var paidTotal = paidMap.TryGetValue(p.SolarRequestId, out var pv) ? pv : 0m;
        var rowDeposit = depositMap.TryGetValue(p.SolarRequestId, out var dv) ? dv : 0m;
        var projectAmt = req?.PlanAmount ?? 0m;
        var due = System.Math.Max(0, projectAmt - paidTotal);
        var paidPct = projectAmt > 0 ? (int)System.Math.Min(100, (double)(paidTotal / projectAmt * 100)) : 0;
        var isAdminEntry = !string.IsNullOrEmpty(p.Notes) && p.Notes.Contains("[ADMIN ENTRY");
        var isRejected = p.Status == SolarPortal.Domain.Enums.PaymentStatus.Rejected;
        var memberName = req == null ? "" :
            (string.IsNullOrWhiteSpace(req.MemberFullName) ? req.ApplicantName : req.MemberFullName);
        // Date filter runs on the request date. Payments whose request row isn't
        // loaded fall back to the payment date so they stay filterable.
        var rowDate = (req?.CreatedAt ?? p.PaymentDate).ToLocalTime().ToString("yyyy-MM-dd");
        // ===== Receipt URL normalization =====
        string? receiptUrl = null;
        if (!string.IsNullOrEmpty(p.ReceiptImagePath))
        {
            var rel = p.ReceiptImagePath.Replace("\\", "/").TrimStart('/');
            if (rel.StartsWith("wwwroot/", StringComparison.OrdinalIgnoreCase))
                rel = rel.Substring("wwwroot/".Length);
            receiptUrl = "/" + rel;
        }
        var receiptIsPdf = receiptUrl != null && receiptUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

        <div class="pv-card"
             data-search="@($"{p.UserId} {memberName} {req?.MobileNumber} {req?.City} {req?.State} {req?.RequestNumber} {p.UTRNumber} {p.ReceiptNumber}".ToLower())"
             data-mid="@p.UserId"
             data-city="@req?.City"
             data-state="@req?.State"
             data-date="@rowDate">

            <div class="pv-main">
                <div>
                    <button type="button" class="pv-toggle" data-target="pd-@p.Id"
                            aria-expanded="false" title="Show all details">&#9654;</button>
                </div>

                <div>
                    <div style="font-weight:600;color:#1f2937;font-size:13px">@(string.IsNullOrWhiteSpace(memberName) ? "—" : memberName)</div>
                    <div style="margin-top:4px">
                        <code style="font-size:10px;color:#0d9488;background:#f0fdfa;padding:2px 6px;border-radius:3px">@p.UserId</code>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(req?.MobileNumber))
                    {
                        <div style="margin-top:3px">
                            <a href="tel:@req.MobileNumber" style="color:#6b7280;font-size:11px;text-decoration:none">@req.MobileNumber</a>
                        </div>
                    }
                </div>

                <div>
                    <div style="font-weight:600;color:#1f2937;font-size:12px;margin-bottom:3px">@req?.RequestNumber</div>
                    @if (req != null)
                    {
                        <partial name="_PlanCell" model="req" />
                    }
                </div>

                <div style="text-align:right">
                    <div style="color:#059669;font-weight:700;font-size:14px">&#8377;@p.Amount.ToString("N0")</div>
                    <div style="font-size:11px;color:#9ca3af;margin-top:2px">@p.PaymentDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                    <div style="font-size:11px;color:#9ca3af">@p.PaymentMethod</div>
                </div>

                <div>
                    <div style="font-size:11.5px;color:#4b5563">
                        <strong style="color:#0d9488">&#8377;@paidTotal.ToString("N0")</strong>
                        <span style="color:#9ca3af"> / &#8377;@projectAmt.ToString("N0")</span>
                    </div>
                    <div class="pv-prog"><i style="width:@paidPct%"></i></div>
                    @* Name this money. Admins were reading it as outstanding and
                       chasing members for an amount already paid. *@
                    @if (rowDeposit > 0)
                    {
                        <div style="font-size:11px;color:#0d9488;font-weight:600"
                             title="Paid into the legacy cPanel for the order that activated this ID - it is NOT outstanding">
                            &#10004; &#8377;@rowDeposit.ToString("N0") already paid on active ID
                        </div>
                        <div style="font-size:10.5px;color:#6b7280">
                            already adjusted below &#8212; do not ask the member for it
                        </div>
                    }
                    @if (due > 0)
                    {
                        <div style="font-size:11px;color:#dc2626">Due &#8377;@due.ToString("N0")</div>
                    }
                    else if (projectAmt > 0)
                    {
                        <div style="font-size:11px;color:#16a34a">&#10003; Fully paid</div>
                    }
                </div>

                <div>
                    @if (p.IsVerified)
                    {
                        <span style="display:inline-block;background:#dcfce7;color:#15803d;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:600">&#10003; Verified</span>
                    }
                    else if (isRejected)
                    {
                        <span style="display:inline-block;background:#fee2e2;color:#991b1b;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:600">&#10005; Rejected</span>
                    }
                    else
                    {
                        <span style="display:inline-block;background:#fef3c7;color:#92400e;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:600">&#8987; Pending</span>
                    }
                    <div style="margin-top:4px">
                        <span style="display:inline-block;background:@(isAdminEntry ? "#dbeafe" : "#e5e7eb");color:@(isAdminEntry ? "#0369a1" : "#374151");padding:2px 7px;border-radius:4px;font-size:10px;font-weight:500">
                            @(isAdminEntry ? "Admin entry" : "User")
                        </span>
                    </div>
                </div>

                <div style="text-align:center">
                    @if (!p.IsVerified && !isRejected)
                    {
                        <button class="btn btn-sm btn-verify" data-id="@p.Id" style="padding:6px 10px;font-size:11px;background:#10b981;border:0;color:white;border-radius:4px;cursor:pointer;font-weight:500">Verify</button>
                        <button class="btn btn-sm btn-reject" data-id="@p.Id" style="padding:6px 10px;font-size:11px;background:#ef4444;border:0;color:white;border-radius:4px;cursor:pointer;font-weight:500;margin-top:4px">Reject</button>
                    }
                    else
                    {
                        <small style="color:#9ca3af">Locked</small>
                    }
                </div>
            </div>

            @* Detail panel — jaan-boojh kar iske paas data-search nahi hai, taaki
               report filter na ise gine na toggle kare. Filter chhoote hi sabhi khule
               panel band ho jaate hain (collapseAllDetails, Scripts section mein). *@
            <div id="pd-@p.Id" class="pv-detail is-collapsed">
                <div class="pv-detail-grid">
                    <div>
                        <div class="pdl">Receipt #</div>
                        <div class="pdv">@(string.IsNullOrWhiteSpace(p.ReceiptNumber) ? "—" : p.ReceiptNumber)</div>
                    </div>
                    <div>
                        <div class="pdl">UTR / Reference</div>
                        <div class="pdv"><code style="background:#f3f4f6;padding:3px 7px;border-radius:4px;font-size:11px;color:#4b5563">@(string.IsNullOrWhiteSpace(p.UTRNumber) ? "—" : p.UTRNumber)</code></div>
                    </div>
                    <div>
                        <div class="pdl">Payment Method</div>
                        <div class="pdv">@p.PaymentMethod</div>
                    </div>
                    <div>
                        <div class="pdl">Payment Date</div>
                        <div class="pdv">@p.PaymentDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                    </div>
                    <div>
                        <div class="pdl">Request Date</div>
                        <div class="pdv">@(req != null ? req.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") : "—")</div>
                    </div>
                    <div>
                        <div class="pdl">City</div>
                        <div class="pdv" title="@req?.Address">@(string.IsNullOrWhiteSpace(req?.City) ? "—" : req.City)</div>
                    </div>
                    <div>
                        <div class="pdl">State</div>
                        <div class="pdv">@(string.IsNullOrWhiteSpace(req?.State) ? "—" : req.State)</div>
                    </div>
                    <div>
                        <div class="pdl">Project Amount</div>
                        <div class="pdv" style="color:#16a34a;font-weight:600">&#8377;@projectAmt.ToString("N0")</div>
                    </div>
                    <div>
                        <div class="pdl">Paid (payments + already-paid deposit)</div>
                        <div class="pdv" style="color:#0d9488;font-weight:600">&#8377;@paidTotal.ToString("N0")</div>
                    </div>
                    <div>
                        <div class="pdl">Outstanding Due</div>
                        <div class="pdv" style="color:@(due > 0 ? "#dc2626" : "#16a34a");font-weight:600">&#8377;@due.ToString("N0")</div>
                    </div>
                    <div>
                        <div class="pdl">Uploaded By</div>
                        <div class="pdv">@(isAdminEntry ? "Admin entry" : "User")</div>
                    </div>
                    <div>
                        <div class="pdl">Receipt</div>
                        <div class="pdv">
                            @if (receiptUrl != null)
                            {
                                <a href="javascript:void(0)" class="receipt-preview"
                                   data-url="@receiptUrl" data-pdf="@(receiptIsPdf ? "1" : "0")"
                                   data-utr="@p.UTRNumber"
                                   style="color:#0d9488;text-decoration:none;font-weight:500">@(receiptIsPdf ? "📄 View PDF" : "🖼️ View Image")</a>
                            }
                            else { <span style="color:#9ca3af">—</span> }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div style="padding:20px;text-align:center;color:#9ca3af;font-size:13px">No payments.</div>
    }
    </div>

    @* Pagination — client-side, kyunki filter toolbar bhi client-side hai. Server-side
       karte to filter sirf current page par lagta aur "28 shown of 28" jhooth bolta. *@
    <div id="pvPager" class="pv-pager">
        <div class="pv-pager-info" id="pvPagerInfo"></div>
        <div class="pv-pager-btns" id="pvPagerBtns"></div>
    </div>
</div>

@Html.AntiForgeryToken()

@* === Receipt preview modal ===
   Replaces the plain target="_blank" link. Opens images inline and embeds PDFs
   via <object>, with a fallback "open in new tab" link. *@
<div class="modal fade" id="receiptPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="receiptPreviewTitle">Receipt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" id="receiptPreviewBody" style="min-height:400px">
                <!-- filled by JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const token = $('input[name="__RequestVerificationToken"]').val();
// === Row detail expander ===
// 20 columns ki jagah 6 dikhte hain; baaki har row ke neeche expand hote hain.
function collapseAllDetails() {
    document.querySelectorAll('.pv-detail').forEach(function (d) { d.classList.add('is-collapsed'); });
    document.querySelectorAll('.pv-toggle').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
}
document.querySelectorAll('.pv-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
        var row = document.getElementById(btn.dataset.target);
        if (!row) return;
        var willOpen = row.classList.contains('is-collapsed');
        row.classList.toggle('is-collapsed', !willOpen);
        btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });
});
// Detail rows carry no data-search, so the report filter can't hide them. If the
// admin filters while a row is open, that orphan panel would linger under an
// unrelated row -- collapse everything whenever a filter field is touched.
(function () {
    var bar = document.querySelector('.report-filter');
    if (!bar) return;
    bar.addEventListener('input', collapseAllDetails);
    bar.addEventListener('change', collapseAllDetails);
})();

// === Pagination ===
// Filter aur pagination dono client-side hain, aur order maayne rakhta hai:
// pehle filter decide karta hai kaun-se cards match karte hain (inline display),
// phir pagination un match karne walon mein se current page dikhata hai (class).
(function () {
    var PAGE_SIZE = 10;
    var page = 1;
    var list = document.getElementById('paymentsTable');
    var info = document.getElementById('pvPagerInfo');
    var btns = document.getElementById('pvPagerBtns');
    var wrap = document.getElementById('pvPager');
    if (!list || !info || !btns || !wrap) return;

    var all = Array.prototype.slice.call(list.querySelectorAll('.pv-card'));
    if (!all.length) { wrap.style.display = 'none'; return; }

    // Filter ne jinhe chhupaya nahi -- unhi par pagination lagti hai.
    function matching() {
        return all.filter(function (c) { return c.style.display !== 'none'; });
    }

    function render() {
        var cards = matching();
        var pages = Math.max(1, Math.ceil(cards.length / PAGE_SIZE));
        if (page > pages) page = pages;
        if (page < 1) page = 1;

        var from = (page - 1) * PAGE_SIZE;
        var to = Math.min(from + PAGE_SIZE, cards.length);

        all.forEach(function (c) { c.classList.add('pv-page-hidden'); });
        cards.slice(from, to).forEach(function (c) { c.classList.remove('pv-page-hidden'); });

        info.textContent = cards.length
            ? 'Showing ' + (from + 1) + '-' + to + ' of ' + cards.length + ' payments'
            : 'No payments match the current filter';

        btns.innerHTML = '';
        if (pages <= 1) return;

        function btn(label, target, opts) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'pv-pg' + (opts && opts.active ? ' active' : '');
            b.textContent = label;
            if (opts && opts.disabled) { b.disabled = true; }
            else {
                b.addEventListener('click', function () {
                    page = target;
                    collapseAllDetails();
                    render();
                    list.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }
            btns.appendChild(b);
        }
        function gap() {
            var s = document.createElement('span');
            s.className = 'pv-pg-gap';
            s.textContent = '...';
            btns.appendChild(s);
        }

        btn('Prev', page - 1, { disabled: page === 1 });
        // Bahut saare pages par sirf pehla, aakhri aur current ke aas-paas wale.
        var shown = [];
        for (var i = 1; i <= pages; i++) {
            if (i === 1 || i === pages || Math.abs(i - page) <= 1) { shown.push(i); }
        }
        shown.forEach(function (n, idx) {
            if (idx > 0 && n - shown[idx - 1] > 1) { gap(); }
            btn(String(n), n, { active: n === page });
        });
        btn('Next', page + 1, { disabled: page === pages });
    }

    // Filter badalte hi page 1 par wapas -- warna user page 3 par hota aur filter
    // ke baad sirf 1 page bachta, to khaali screen dikhti. Ye listener container
    // par hai, isliye toolbar ke apne input handlers ke BAAD chalta hai (bubbling).
    var filterBar = document.querySelector('.report-filter');
    if (filterBar) {
        var reset = function () { page = 1; render(); };
        filterBar.addEventListener('input', reset);
        filterBar.addEventListener('change', reset);
    }

    render();
})();

// Helper: disable both action buttons on the row, show inline spinner
function lockRow(btn, label) {
    const $row = $(btn).closest('.pv-card');   // list ab table nahi, cards hain
    $row.find('.btn-verify, .btn-reject').prop('disabled', true).addClass('disabled');
    $(btn).html(`<span class="spinner-border spinner-border-sm"></span> ${label}`);
}

$('.btn-verify').on('click', function () {
    const id = $(this).data('id');
    if (!confirm('Verify this payment? This action cannot be undone.')) return;
    lockRow(this, 'Verifying...');
    // NOTE: the global ajaxSuccess handler (_Toasts) already shows r.message as a
    // toast. Do NOT alert() here or the "Payment verified…" message appears twice.
    $.post('@Url.Action("Verify")', { id: id, __RequestVerificationToken: token }, function (r) {
        // Give the toast a moment to display, then refresh so totals/status update.
        setTimeout(function () { location.reload(); }, 1500);
    }).fail(() => { location.reload(); });   // global ajaxError shows the error toast
});

$('.btn-reject').on('click', function () {
    const id = $(this).data('id');
    const reason = prompt('Reason for rejection? (required)');
    if (reason === null) return;
    if (!reason.trim()) { alert('A reason is required.'); return; }
    lockRow(this, 'Rejecting...');
    // Global toast (_Toasts) shows r.message; don't alert() or it shows twice.
    $.post('@Url.Action("Reject")', { id: id, reason: reason, __RequestVerificationToken: token }, function (r) {
        setTimeout(function () { location.reload(); }, 1500);
    }).fail(() => { location.reload(); });
});

// === Receipt preview ===
// The stored URL (/uploads/payments/abc.jpg) points at the USER panel's
// wwwroot, which the admin app can't serve directly. Route it through the
// admin FileController instead — that resolves the file from whichever
// panel's wwwroot actually has it and streams it back inline.
function adminFileSrc(storedUrl) {
    var p = (storedUrl || '').replace(/\\/g, '/');
    return '/SolarPanelAdmin/File/View?path=' + encodeURIComponent(p);
}

$(document).on('click', '.receipt-preview', function () {
    const rawUrl = $(this).data('url');
    const url    = adminFileSrc(rawUrl);
    const isPdf  = String($(this).data('pdf')) === '1';
    const utr    = $(this).data('utr') || '';
    $('#receiptPreviewTitle').text('Receipt' + (utr ? ' — UTR ' + utr : ''));
    const $body = $('#receiptPreviewBody').empty();
    if (isPdf) {
        $body.append(
            `<iframe src="${url}" width="100%" height="500" style="border:0;background:#fff"></iframe>`);
    } else {
        $body.append(
            `<img src="${url}" alt="Receipt"
                  style="max-width:100%;max-height:550px;border:1px solid #ddd;border-radius:4px"
                  onerror="this.parentNode.innerHTML='<div style=\\'padding:40px;color:#888\\'>⚠ Receipt file not found on the server.</div>'" />`);
    }
    new bootstrap.Modal(document.getElementById('receiptPreviewModal')).show();
});

// Admin Add Payment modal submit
// Admin Add Payment modal: live summary when a request is picked
(function () {
    const sel  = document.getElementById('adminPaySelectReq');
    const box  = document.getElementById('adminPayReqSummary');
    const amt  = document.getElementById('adminPayAmount');
    const hint = document.getElementById('adminPayAmountHint');
    if (!sel || !box) return;

    function fmt(n) { return '₹' + Number(n || 0).toLocaleString('en-IN'); }

    sel.addEventListener('change', function () {
        const opt = sel.options[sel.selectedIndex];
        if (!opt || !opt.value) { box.style.display = 'none'; return; }

        const total = parseFloat(opt.dataset.total || '0');
        const paid  = parseFloat(opt.dataset.paid  || '0');
        const due   = parseFloat(opt.dataset.due   || '0');
        const reqNo = opt.dataset.reqno || '';
        const app   = opt.dataset.applicant || '';

        document.getElementById('apSumReq').textContent  = `${reqNo} — ${app}`;
        document.getElementById('apSumTotal').textContent = fmt(total);
        document.getElementById('apSumPaid').textContent  = fmt(paid);
        document.getElementById('apSumDue').textContent   = fmt(due);
        box.style.display = '';

        // Pre-fill the amount with the remaining due as a helpful default.
        // Admin can override (this endpoint bypasses caps anyway).
        if (amt && (!amt.value || parseFloat(amt.value) === 0)) {
            amt.value = due > 0 ? due : '';
        }
        if (hint) {
            hint.textContent = due > 0
                ? `Suggested: ₹${due.toLocaleString('en-IN')} (remaining due). Admin can enter any amount — caps don't apply.`
                : 'This project is fully paid. You can still record an over-payment if needed.';
        }
    });
})();

$('#adminAddPaymentForm').on('submit', function (e) {
    e.preventDefault();
    const fd = new FormData(this);
    fetch('@Url.Action("AddByAdmin")', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(d => {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: d.success ? 'success' : 'error',
                    title: d.success ? 'Saved' : 'Failed',
                    text: d.message || '',
                    background: '#ffffff', color: '#1f2937', confirmButtonColor: '#16a34a'
                }).then(() => { if (d.success) location.reload(); });
            } else {
                alert(d.message || (d.success ? 'Saved' : 'Failed'));
                if (d.success) location.reload();
            }
        })
        .catch(err => alert('Network error: ' + err.message));
});
</script>
}
