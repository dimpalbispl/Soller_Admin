@using SolarPortal.Application.Interfaces.Services
@{
    ViewData["Title"] = "User Permissions";
    var admins = (List<AdminUserRow>)(ViewBag.Admins ?? new List<AdminUserRow>());
    var restricted = (HashSet<string>)(ViewBag.RestrictedUsers ?? new HashSet<string>());
    var menus = (IReadOnlyList<AdminMenus.Item>)ViewBag.Menus;
    var selected = ViewBag.SelectedUser as string;
    var current = (IReadOnlyList<MenuPermission>)(ViewBag.Current ?? new List<MenuPermission>());

    var viewSet = current.Where(c => c.CanView).Select(c => c.MenuKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var editSet = current.Where(c => c.CanEdit).Select(c => c.MenuKey).ToHashSet(StringComparer.OrdinalIgnoreCase);

    var picked = admins.FirstOrDefault(a => string.Equals(a.UserName, selected, StringComparison.OrdinalIgnoreCase));
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>User Permissions</span></div>
        <div class="ph-title">🔑 User Permissions</div>
        <div class="ph-sub">Choose an admin, then tick the menus they may open.</div>
    </div>

    @* Two rules people get wrong, said before they hit them rather than after. *@
    <div class="card" style="margin-bottom:14px;border-left:4px solid var(--sun)">
        <div style="padding:12px 14px;font-size:13px;line-height:1.7">
            • An admin with <strong>nothing ticked keeps full access</strong> — permissions are opt-in.
              Tick at least one menu to restrict someone; untick everything to give full access back.<br />
            • You cannot change your <strong>own</strong> access here — another admin has to.<br />
            • Only <strong>active</strong> accounts from m_usermaster are listed.
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="ct"><span class="ct-dot"></span>Select Admin</div>
        <form method="get" asp-action="Permissions">
            <div class="fr3">
                <div class="fg">
                    <label>Admin User (@admins.Count active)</label>
                    <select name="user" onchange="this.form.submit()">
                        <option value="">— Select an admin —</option>
                        @foreach (var a in admins)
                        {
                            var isRestricted = restricted.Contains(a.UserName);
                            @* GroupId decides this behind the scenes, but the group
                               number itself means nothing to whoever reads this list. *@
                            var acc = a.GroupId == 1 ? "full access" : (isRestricted ? "restricted" : "full access");
                            <option value="@a.UserName" selected="@(string.Equals(a.UserName, selected, StringComparison.OrdinalIgnoreCase))">
                                @a.UserName — @acc
                            </option>
                        }
                    </select>
                </div>
                <div class="fg">
                    <label>&nbsp;</label>
                    <div style="font-size:12px;color:var(--text3);padding-top:8px">
                        @if (picked != null)
                        {
                            <text>@(string.IsNullOrWhiteSpace(picked.Email) ? "no e-mail on file" : picked.Email)</text>
                        }
                        else
                        {
                            <text>Pick an admin to see their menus.</text>
                        }
                    </div>
                </div>
                <div class="fg"></div>
            </div>
        </form>
    </div>

    @if (picked != null)
    {
        @* The grid applies to every admin now - no account gets a dead-end screen.
           The one exception is YOUR OWN account: restricting yourself out of this
           page would leave nobody able to undo it. *@
        @if (string.Equals(picked.UserName, ViewBag.MyId as string, StringComparison.OrdinalIgnoreCase))
        {
            @* Showing an editable grid here would be a lie - the filter lets main
               admins through whatever the grid says. *@
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>@picked.UserName</div>
                <div style="padding:20px;font-size:13.5px">
                    🔒 <strong>This is your own account.</strong>
                    You cannot change your own menus here — locking yourself out of this
                    page would leave nobody able to undo it.
                    <div style="margin-top:8px;color:var(--text3);font-size:12.5px">
                        Ask another admin to change your access.
                    </div>
                </div>
            </div>
        }
        else
        {
            <form asp-action="SavePermissions" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userName" value="@picked.UserName" />

                <div class="card">
                    <div class="ct">
                        <span class="ct-dot"></span>Menus for <strong>@picked.UserName</strong>
                        <span style="font-size:11.5px;color:var(--text3);margin-left:8px">
                            @(restricted.Contains(picked.UserName)
                                ? $"{viewSet.Count} of {menus.Count} menus allowed"
                                : "currently unrestricted — nothing ticked")
                        </span>
                    </div>
                    <div style="padding:10px 14px;display:flex;gap:8px;flex-wrap:wrap">
                        <button type="button" class="btn btn-s btn-sm" onclick="permAll(true)">Select all</button>
                        <button type="button" class="btn btn-s btn-sm" onclick="permAll(false)">Clear all</button>
                    </div>
                    <div class="tbl-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Section</th>
                                    <th>Menu</th>
                                    <th style="width:110px">Can open</th>
                                    <th style="width:110px">Can change</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var group in menus.GroupBy(m => m.Group))
                            {
                                var first = true;
                                foreach (var m in group)
                                {
                                    <tr>
                                        <td style="color:var(--text3);font-size:12px">@(first ? group.Key : "")</td>
                                        <td class="td-b">@m.Label</td>
                                        <td>
                                            <input type="checkbox" class="perm-view" name="view" value="@m.Key"
                                                   @(viewSet.Contains(m.Key) ? "checked" : "") />
                                        </td>
                                        <td>
                                            @* "Can change" implies "can open" - the server forces it,
                                               and the JS below keeps the grid honest about that. *@
                                            <input type="checkbox" class="perm-edit" name="edit" value="@m.Key"
                                                   @(editSet.Contains(m.Key) ? "checked" : "") />
                                        </td>
                                    </tr>
                                    first = false;
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                    <div style="padding:14px">
                        <button type="submit" class="btn btn-p">💾 Save Permissions</button>
                        <a class="btn btn-s" asp-action="Permissions">Cancel</a>
                    </div>
                </div>
            </form>
        }
    }
</div>

@section Scripts {
<script>
    function permAll(on) {
        document.querySelectorAll('.perm-view').forEach(function (c) { c.checked = on; });
        if (!on) document.querySelectorAll('.perm-edit').forEach(function (c) { c.checked = false; });
    }

    // Ticking "Can change" ticks "Can open" too, so the grid shows what the
    // server will actually store.
    document.querySelectorAll('.perm-edit').forEach(function (edit) {
        edit.addEventListener('change', function () {
            if (!this.checked) return;
            var row = this.closest('tr');
            var view = row && row.querySelector('.perm-view');
            if (view) view.checked = true;
        });
    });
</script>
}
