@using SolarPortal.Domain.Entities
@using SolarPortal.Domain.Enums
@model IEnumerable<ExtraPaymentRefund>
@{
    ViewData["Title"] = "Fund Transfer";
    var status   = (ViewBag.Status as string) ?? "all";
    var vtypes   = ViewBag.VoucherTypes as List<SolarPortal.Application.Interfaces.Services.SolarWalletOption>
                   ?? new List<SolarPortal.Application.Interfaces.Services.SolarWalletOption>();
    var pendingCount  = (int)(ViewBag.PendingCount ?? 0);
    var approvedCount = (int)(ViewBag.ApprovedCount ?? 0);
    var rejectedCount = (int)(ViewBag.RejectedCount ?? 0);

    string Pill(ApprovalStatus s) => s switch
    {
        ApprovalStatus.Approved => "sts-act",
        ApprovalStatus.Rejected => "sts-rej",
        _ => "sts-pen"
    };
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>Fund Transfer</span></div>
        <div class="ph-title">💸 Fund Transfer</div>
        <div class="ph-sub">
            Money a member paid over and above their project total — <strong>credited</strong> back to
            their wallet, or <strong>debited</strong> out of it when something has to be taken back.
            Raising an entry moves nothing: it reaches the ledger only when it is
            <strong>approved</strong>, and carries the project it belongs to.
        </div>
    </div>

    <!-- ── Raise a refund ─────────────────────────────────────────────── -->
    <div class="card" style="margin-bottom:14px">
        <div class="ct"><span class="ct-dot"></span>Raise a Fund Transfer</div>
        <form id="refundForm">
            @Html.AntiForgeryToken()

            @* Which way the money moves. Credit pays the member back, Debit takes it
               out again — both land in the same ledger, in the shape that ledger
               already uses for each. *@
            <div class="fg" style="margin-bottom:12px">
                <label>Entry Type *</label>
                <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;margin:0">
                        <input type="radio" name="entryType" value="C" checked style="width:auto" />
                        <span>⬆️ <strong>Credit</strong> — refund into the member's wallet</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;margin:0">
                        <input type="radio" name="entryType" value="D" style="width:auto" />
                        <span>⬇️ <strong>Debit</strong> — deduct from the member's wallet</span>
                    </label>
                </div>
            </div>

            <div class="fr3">
                <div class="fg">
                    <label>Member ID *</label>
                    <div style="display:flex;gap:8px">
                        <input type="text" id="refMemberId" placeholder="e.g. TESTSUNIL" autocomplete="off" style="flex:1" />
                        <button type="button" class="btn btn-s btn-sm" id="btnRefFind">🔍 Find</button>
                    </div>
                    <input type="hidden" name="memberIdNo" id="refMemberIdNo" />
                    <input type="hidden" name="solarRequestId" id="refRequestId" />
                    <div id="refLookupMsg" style="font-size:11.5px;margin-top:4px"></div>
                </div>
                <div class="fg">
                    <label>Voucher Type (Wallet) *</label>
                    <select name="voucherTypeId" id="refVoucherType">
                        @foreach (var v in vtypes)
                        {
                            <option value="@v.Acid">@v.WalletName</option>
                        }
                    </select>
                    @if (!vtypes.Any())
                    {
                        <div style="font-size:11.5px;color:#b91c1c;margin-top:4px">
                            No wallet found in SolarVouchertype — a refund cannot be posted until one exists.
                        </div>
                    }
                </div>
                <div class="fg">
                    <label>Amount (₹) *</label>
                    <input type="number" step="0.01" min="1" name="amount" id="refAmount" placeholder="e.g. 5000" required />
                    <div id="refAmountHint" style="font-size:11.5px;color:var(--text3);margin-top:4px">Find a member first.</div>
                </div>
            </div>

            @* Filled by the lookup: which project the money came in on, and how much
               of it is actually extra. *@
            <div id="refMemberCard" style="display:none;margin-bottom:12px"></div>

            <div class="fg">
                <label>Remark</label>
                <textarea name="remark" rows="2" placeholder="Why this refund is being given"></textarea>
            </div>

            <button type="submit" class="btn btn-p" id="btnRefSubmit" disabled>💸 Raise Request</button>
            <span id="refBlockedHint" style="font-size:12px;color:var(--text3);margin-left:8px">Find a member first.</span>
        </form>
    </div>

    <!-- ── History / decisions ────────────────────────────────────────── -->
    <div class="card">
        <div class="ct"><span class="ct-dot"></span>Fund Transfer Requests (@Model.Count())</div>

        <div style="display:flex;gap:8px;padding:12px 14px;flex-wrap:wrap">
            <a class="btn btn-sm @(status == "all" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-status="all">📋 All</a>
            <a class="btn btn-sm @(status == "pending" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-status="pending">⏳ Pending (@pendingCount)</a>
            <a class="btn btn-sm @(status == "approved" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-status="approved">✅ Approved (@approvedCount)</a>
            <a class="btn btn-sm @(status == "rejected" ? "btn-p" : "btn-s")" asp-action="Index" asp-route-status="rejected">❌ Rejected (@rejectedCount)</a>
        </div>

        @if (!Model.Any())
        {
            <div style="padding:20px;color:var(--text3);font-size:13px">
                Nothing here yet. A refund or debit raised above appears in this list until it is approved or rejected.
            </div>
        }
        else
        {
            ViewData["FilterTableId"] = "refundTable";
            ViewData["FilterPlaceholder"] = "Search by member ID, name, request #, wallet...";
            ViewData["FilterDateLabel"] = "Requested";
            ViewData["FilterShowCity"] = false;
            ViewData["FilterShowState"] = false;
            ViewData["FilterPageSize"] = 10;

            <partial name="_ReportFilterToolbar" />

            <div class="tbl-wrap">
                <table id="refundTable">
                    <thead>
                        <tr>
                            <th>Requested</th>
                            <th>Request #</th>
                            <th>Member</th>
                            <th>Wallet</th>
                            <th>Type</th>
                            <th style="text-align:right">Amount</th>
                            <th>Remark</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var when = (r.RequestedAt ?? r.CreatedAt).ToLocalTime();
                            var pending = r.Status == ApprovalStatus.Pending;
                            <tr data-search="@($"{r.MemberIdNo} {r.MemberName} {r.RequestNumber} {r.VoucherTypeName} {r.Status}".ToLower())"
                                data-mid="@r.MemberIdNo"
                                data-date="@when.ToString("yyyy-MM-dd")">
                                <td style="white-space:nowrap">@when.ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="td-b">@(string.IsNullOrWhiteSpace(r.RequestNumber) ? "— (no project)" : r.RequestNumber)</td>
                                <td>
                                    @r.MemberName
                                    <div class="cell-sub">@r.MemberIdNo</div>
                                </td>
                                <td>@r.VoucherTypeName</td>
                                <td>
                                    @if (r.IsCredit)
                                    {
                                        <span class="sts sts-act">⬆️ Credit</span>
                                    }
                                    else
                                    {
                                        <span class="sts sts-rej">⬇️ Debit</span>
                                    }
                                </td>
                                <td class="td-b" style="text-align:right;color:@(r.IsCredit ? "#15803d" : "#b91c1c")">
                                    @(r.IsCredit ? "+" : "−")₹@r.Amount.ToString("N0")
                                </td>
                                <td style="max-width:220px">@r.Remark</td>
                                <td>
                                    <span class="sts @Pill(r.Status)">@r.Status</span>
                                    @if (r.Status == ApprovalStatus.Approved && r.PostedAt.HasValue)
                                    {
                                        <div class="cell-sub">Credited @r.PostedAt.Value.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                                        <div class="cell-sub">@r.VoucherRefNo</div>
                                    }
                                    else if (r.Status == ApprovalStatus.Rejected && !string.IsNullOrWhiteSpace(r.RejectionReason))
                                    {
                                        <div class="cell-sub" style="color:#b91c1c">@r.RejectionReason</div>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    @if (pending)
                                    {
                                        <button class="btn btn-p btn-sm btn-ref-approve" data-id="@r.Id" data-amt="@r.Amount.ToString("N0")">✅ Approve</button>
                                        <button class="btn btn-s btn-sm btn-ref-reject" data-id="@r.Id">❌ Reject</button>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:12px">Decided</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    const esc = s => (s == null ? '' : String(s))
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const token    = document.querySelector('#refundForm input[name="__RequestVerificationToken"]').value;
    const msgBox   = document.getElementById('refLookupMsg');
    const cardBox  = document.getElementById('refMemberCard');
    const reqIdBox = document.getElementById('refRequestId');
    const midBox   = document.getElementById('refMemberIdNo');
    const submitBtn= document.getElementById('btnRefSubmit');
    const hint     = document.getElementById('refBlockedHint');
    const amtHint  = document.getElementById('refAmountHint');

    function setProject(id, label, extra) {
        reqIdBox.value = id || '';
        submitBtn.disabled = !id;
        hint.textContent = id ? (label || '') : 'Find a member first.';
        hint.style.color = id ? 'var(--text2)' : 'var(--text3)';
        // Say what is actually extra on that project, so the amount is not a guess.
        if (id && typeof extra === 'number') {
            amtHint.textContent = extra > 0
                ? 'Extra paid on this project: ₹' + extra.toLocaleString('en-IN')
                : 'This project has no extra payment on record — refund only if you are sure.';
            amtHint.style.color = extra > 0 ? '#15803d' : '#b45309';
        }
    }

    function clearLookup() {
        setProject('', '');
        midBox.value = '';
        cardBox.style.display = 'none';
        cardBox.innerHTML = '';
        msgBox.textContent = '';
        amtHint.textContent = 'Find a member first.';
        amtHint.style.color = 'var(--text3)';
    }

    document.getElementById('refMemberId').addEventListener('input', clearLookup);

    async function findMember() {
        const id = document.getElementById('refMemberId').value.trim();
        clearLookup();
        if (!id) { msgBox.textContent = 'Enter a Member ID.'; msgBox.style.color = '#b91c1c'; return; }

        msgBox.textContent = 'Searching…';
        msgBox.style.color = 'var(--text3)';

        let d;
        try {
            const r = await fetch('@Url.Action("Lookup")?memberId=' + encodeURIComponent(id));
            d = await r.json();
        } catch (e) {
            msgBox.textContent = 'Could not reach the server.';
            msgBox.style.color = '#b91c1c';
            return;
        }

        if (!d.found) {
            msgBox.textContent = d.message || 'Not found.';
            msgBox.style.color = '#b91c1c';
            return;
        }

        msgBox.textContent = '';
        midBox.value = d.memberId;

        const rows = d.requests || [];
        let html =
            '<div style="border:1px solid #bbf7d0;background:#f0fdf4;border-radius:10px;padding:12px">' +
              '<div style="font-size:11px;color:#15803d;text-transform:uppercase;letter-spacing:.4px">Member</div>' +
              '<div style="font-weight:700;font-size:16px;color:#166534">' + esc(d.name) + '</div>' +
              '<div style="font-size:12px;color:#166534">' + esc(d.memberId) + (d.mobile ? ' · ' + esc(d.mobile) : '') + '</div>';

        // No solar request: the transfer goes straight to the member's wallet.
        if (!rows.length) {
            html += '<div style="margin-top:10px;padding-top:10px;border-top:1px solid #bbf7d0;font-size:12px;color:#166534">' +
                    'No solar project for this member — the entry goes straight to their wallet.</div></div>';
            cardBox.innerHTML = html;
            cardBox.style.display = 'block';
            submitBtn.disabled = false;
            hint.textContent = 'Transfer to ' + d.memberId + ' (no project)';
            hint.style.color = 'var(--text2)';
            amtHint.textContent = 'Any amount.';
            amtHint.style.color = 'var(--text3)';
            return;
        }

        html +=
              '<div style="margin-top:10px;padding-top:10px;border-top:1px solid #bbf7d0">' +
                '<div style="font-size:12px;color:#166534;margin-bottom:6px">Choose the project the extra money was paid on:</div>';

        rows.forEach(function (p, i) {
            html +=
                '<label style="display:block;font-size:12.5px;color:#166534;padding:4px 0;cursor:pointer">' +
                  '<input type="radio" name="pickReq" value="' + p.id + '"' + (rows.length === 1 ? ' checked' : '') +
                         ' data-extra="' + p.extra + '" data-label="Refunding on ' + esc(p.requestNumber) + '" style="width:auto;margin-right:6px">' +
                  '<strong>' + esc(p.requestNumber) + '</strong> · ' + esc(p.plan || '') +
                  ' · Total ₹' + Number(p.total).toLocaleString('en-IN') +
                  ' · Paid ₹' + Number(p.paid).toLocaleString('en-IN') +
                  (Number(p.extra) > 0
                      ? ' · <strong style="color:#b45309">Extra ₹' + Number(p.extra).toLocaleString('en-IN') + '</strong>'
                      : '') +
                '</label>';
        });

        html += '</div></div>';
        cardBox.innerHTML = html;
        cardBox.style.display = 'block';

        cardBox.querySelectorAll('input[name="pickReq"]').forEach(function (rb) {
            rb.addEventListener('change', function () {
                setProject(this.value, this.dataset.label, parseFloat(this.dataset.extra || '0'));
            });
        });

        if (rows.length === 1) {
            setProject(rows[0].id, 'Refunding on ' + rows[0].requestNumber, Number(rows[0].extra));
        }
    }

    document.getElementById('btnRefFind').addEventListener('click', findMember);
    document.getElementById('refMemberId').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); findMember(); }
    });

    document.getElementById('refundForm').addEventListener('submit', function (e) {
        e.preventDefault();
        if (!midBox.value) { Swal.fire('Find a member', 'Enter a Member ID and press Find first.', 'warning'); return; }
        // A member with projects must say which one; a member with none needs no project.
        if (!reqIdBox.value && cardBox.querySelector('input[name="pickReq"]')) {
            Swal.fire('Pick a project', 'Choose the project this entry is for.', 'warning'); return;
        }

        const btn = submitBtn;
        btn.disabled = true; btn.textContent = 'Saving…';
        const fd = new FormData(this);
        fetch('@Url.Action("Create")', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    Swal.fire('Request raised', d.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Could not raise request', d.message || 'Failed', 'error');
                    btn.disabled = false; btn.textContent = '💸 Raise Request';
                }
            })
            .catch(() => {
                Swal.fire('Error', 'Could not reach the server.', 'error');
                btn.disabled = false; btn.textContent = '💸 Raise Request';
            });
    });

    function post(url, data, btn, resetHtml) {
        data.append('__RequestVerificationToken', token);
        btn.disabled = true;
        fetch(url, { method: 'POST', body: data })
            .then(r => r.json())
            .then(d => {
                if (d.success) { Swal.fire('Done', d.message, 'success').then(() => location.reload()); }
                else { Swal.fire('Error', d.message || 'Failed', 'error'); btn.disabled = false; btn.innerHTML = resetHtml; }
            })
            .catch(() => { Swal.fire('Error', 'Could not reach the server.', 'error'); btn.disabled = false; btn.innerHTML = resetHtml; });
    }

    document.querySelectorAll('.btn-ref-approve').forEach(function (b) {
        b.addEventListener('click', function () {
            const btn = this, id = this.dataset.id, amt = this.dataset.amt;
            Swal.fire({
                title: 'Approve this entry?',
                text: '₹' + amt + ' will be posted to the member\'s wallet in the direction shown. This cannot be undone.',
                icon: 'question', showCancelButton: true, confirmButtonText: 'Yes, post it'
            }).then(function (res) {
                if (!res.isConfirmed) return;
                const fd = new FormData(); fd.append('id', id);
                post('@Url.Action("Approve")', fd, btn, '✅ Approve');
            });
        });
    });

    document.querySelectorAll('.btn-ref-reject').forEach(function (b) {
        b.addEventListener('click', function () {
            const btn = this, id = this.dataset.id;
            Swal.fire({
                title: 'Reject this entry',
                input: 'text', inputLabel: 'Reason', inputPlaceholder: 'Why is this entry refused?',
                showCancelButton: true, confirmButtonText: 'Reject'
            }).then(function (res) {
                if (!res.isConfirmed) return;
                const reason = (res.value || '').trim();
                if (!reason) { Swal.fire('Reason needed', 'Please give a rejection reason.', 'warning'); return; }
                const fd = new FormData(); fd.append('id', id); fd.append('reason', reason);
                post('@Url.Action("Reject")', fd, btn, '❌ Reject');
            });
        });
    });
</script>
}
