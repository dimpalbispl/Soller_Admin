@model IEnumerable<SolarPortal.Domain.Entities.SolarRequest>
@using SolarPortal.Domain.Entities
@{
    ViewData["Title"] = ViewBag.Title;
    var pmFilter = (ViewBag.Filter as string) ?? "all";
    var userDict = (Dictionary<string, ApplicationUser>)(ViewBag.UserStatuses ?? new Dictionary<string, ApplicationUser>());
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">🛡️ Admin / <span>PM Surya Ghar</span></div>
        <div class="ph-title">PM Surya Ghar Verification</div>
        <div class="ph-sub">Requests awaiting PM Surya Ghar document verification</div>
    </div>

    @* 4-tab status filter — Pending / Approved / Rejected / All. *@
    @await Html.PartialAsync("_StatusTabs", (object)pmFilter)

    @if (Model.Any())
    {
        @* Report filter — Member ID / City / State / Request date. *@
        
        ViewData["FilterTableId"] = "pmTable";
        ViewData["FilterPlaceholder"] = "Search by Member ID, name, mobile, request #...";
        ViewData["FilterDateLabel"] = "Request Date";

        <partial name="_ReportFilterToolbar" />

        <div class="card">
            <div class="ct"><span class="ct-dot"></span>PM Surya Ghar Queue (@Model.Count())</div>
            <div class="tbl-wrap">
                <table id="pmTable">
                    <thead>
                        <tr>
                            <th>Request #</th>
                            <th>Member ID</th>
                            <th>Member Name</th>
                            <th>Plan</th>
                            <th>City / State</th>
                            <th>Connection</th>
                            <th>Request Date</th>
                            @* Point 9: who is holding this case, so two admins don't both open it. *@
                            <th>Accepted By</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model)
                    {
                        var user = userDict.ContainsKey(r.UserId) ? userDict[r.UserId] : null;
                        var isActive = user?.IsActive ?? false;
                        var memberName = string.IsNullOrWhiteSpace(r.MemberFullName) ? r.ApplicantName : r.MemberFullName;

                        <tr data-search="@($"{r.UserId} {memberName} {r.MobileNumber} {r.City} {r.State} {r.RequestNumber}".ToLower())"
                            data-mid="@r.UserId"
                            data-city="@r.City"
                            data-state="@r.State"
                            data-date="@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")">
                            <td class="td-b">@r.RequestNumber</td>
                            <td>
                                <span class="mid-code">@r.UserId</span>
                                <div>
                                    <span class="mini-pill @(isActive ? "pill-active" : "pill-inactive")">
                                        @(isActive ? "✓ Active" : "✗ Inactive")
                                    </span>
                                </div>
                            </td>
                            <td>
                                @memberName
                                <div class="cell-sub">@r.MobileNumber</div>
                            </td>
                            @* Shared cell — same markup as every other report, and it
                               also resolves the With-Activation product name. *@
                            <td><partial name="_PlanCell" model="r" /></td>
                            <td>@r.City<div class="cell-sub">@r.State</div></td>
                            <td><span class="badge bg-info">@r.ConnectionType</span></td>
                            <td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                @if (r.IsPmSuryaAccepted)
                                {
                                    <span class="mini-pill pill-active">🔒 @(r.PmSuryaAcceptedByName ?? r.PmSuryaAcceptedBy)</span>
                                    <div class="cell-sub">@r.PmSuryaAcceptedAt?.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size:12px">— Not accepted —</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-p btn-sm" asp-action="Details" asp-route-id="@r.Id">Review</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="empty-state">
                <div class="es-icon">📋</div>
                <div class="es-title">No requests in this list</div>
                <div class="es-sub">No requests pending PM Surya Ghar verification.</div>
            </div>
        </div>
    }
</div>
