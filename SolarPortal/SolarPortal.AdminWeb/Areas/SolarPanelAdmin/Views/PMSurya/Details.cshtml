@{
    ViewData["Title"] = "PM Surya Ghar Review";
    var req = (SolarPortal.Domain.Entities.SolarRequest)ViewBag.Request;
    var docs = (IEnumerable<SolarPortal.Application.DTOs.PMDocumentDto>)ViewBag.Documents;
}

<div class="page-header" style="padding:16px">
    <h2>PM Surya Ghar — @req.RequestNumber</h2>
    <p class="text-muted">
        <strong>Member ID:</strong> <code>@req.UserId</code> ·
        @(string.IsNullOrWhiteSpace(req.MemberFullName) ? req.ApplicantName : req.MemberFullName) ·
        @req.MobileNumber · @req.Email · @req.City, @req.State
    </p>
</div>

<div class="container-fluid">
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">Uploaded Documents</div>
                <div class="card-body">
                    @if (!docs.Any())
                    {
                        <p class="text-muted">No documents uploaded yet.</p>
                    }
                    <table class="table">
                        <thead>
                            <tr><th>Type</th><th>Uploaded By</th><th>File</th><th>Status</th><th>Remarks</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var d in docs)
                        {
                            // Admin-uploaded doc types (approval doc / photo / signature) are
                            // produced by the admin during PM Surya approval. Everything else
                            // (Aadhar, PAN, light bill, GPS photo, applicant photo/sign, …) is
                            // uploaded by the user. Show a badge so it's clear who submitted each file.
                            var adminUploaded =
                                d.DocumentType == SolarPortal.Domain.Enums.DocumentType.PMApprovalDocument ||
                                d.DocumentType == SolarPortal.Domain.Enums.DocumentType.PMApprovalPhoto ||
                                d.DocumentType == SolarPortal.Domain.Enums.DocumentType.PMApprovalSignature;
                            // Only the admin's own PM approval document can be deleted here —
                            // the back-end DeleteApprovalDocument rejects every other type, so
                            // the button must not appear on user-uploaded rows.
                            var canDelete =
                                d.DocumentType == SolarPortal.Domain.Enums.DocumentType.PMApprovalDocument;
                            <tr id="row-@d.Id">
                                <td>@d.DocumentType</td>
                                <td>
                                    @if (adminUploaded)
                                    {
                                        <span class="badge bg-primary">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">User</span>
                                    }
                                </td>
                                <td><a href="javascript:void(0)" onclick="openFileModal('@d.FilePath')" style="color:#0d9488">@d.FileName</a></td>
                                <td>
                                    <span class="badge bg-@(d.Status == SolarPortal.Domain.Enums.ApprovalStatus.Approved ? "success" : d.Status == SolarPortal.Domain.Enums.ApprovalStatus.Rejected ? "danger" : "warning")">
                                        @d.Status
                                    </span>
                                </td>
                                <td>@d.Remarks</td>
                                <td style="white-space:nowrap">
                                    @* Admin can flip a user document's verdict at ANY time and at any
                                       project stage. Earlier these buttons only appeared while the doc
                                       was Pending, so once approved there was no way to send it back —
                                       and the user had no way to replace a wrong file.

                                       Rejecting does NOT move the project: PMDocumentService only
                                       changes the document status, and the user panel gates uploads on
                                       "stage >= PMSurvey", so the user can re-upload from whatever stage
                                       the project is currently at. Their re-upload arrives as a new
                                       Pending row which is approved here individually. *@
                                    @if (!adminUploaded)
                                    {
                                        if (d.Status == SolarPortal.Domain.Enums.ApprovalStatus.Pending)
                                        {
                                            <button class="btn btn-sm btn-success btn-approve" data-id="@d.Id">Approve</button>
                                            <button class="btn btn-sm btn-danger btn-reject" data-id="@d.Id">Reject</button>
                                        }
                                        else if (d.Status == SolarPortal.Domain.Enums.ApprovalStatus.Approved)
                                        {
                                            @* Approved can still be sent back — admin may spot a problem later. *@
                                            <button class="btn btn-sm btn-danger btn-reject" data-id="@d.Id">Reject</button>
                                        }
                                        else
                                        {
                                            @* Rejected: deliberately NO Approve button. The file that was
                                               rejected is the wrong one, so approving it would undo the
                                               rejection on the same bad document. The user must re-upload
                                               from their panel, which arrives as a fresh Pending row that
                                               gets its own Approve / Reject. *@
                                            <span class="text-muted" style="font-size:12px">Waiting for user re-upload</span>
                                        }
                                    }
                                    @if (canDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger btn-delete-doc"
                                                data-id="@d.Id" data-name="@d.FileName"
                                                title="Delete this approval document — you can upload a new one afterwards">
                                            🗑️ Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            @{
                // Per spec: "Approve All" card sirf tab hide hona chahiye jab request
                // actually PMSurvey se AAGE badh chuki ho.
                //
                // Pehle yeh flag tab bhi true ho jaata tha jab saare uploaded documents
                // Approved the. Matlab admin documents ek-ek karke approve karta tha, aur
                // aakhri doc approve hote hi yeh card gayab — PM Surya Ghar ID ka field
                // aur approval-document upload dono chhup jaate the, jabki request abhi
                // bhi PMSurvey par hi khadi thi aur ID kabhi save hui hi nahi thi.
                //
                // Document status batch-complete ka signal nahi hai; stage advance hi
                // asli signal hai.
                var stage = req.CurrentStage;
                var alreadyApproved =
                    stage == SolarPortal.Domain.Enums.ProjectStatus.MeterDispatch ||
                    stage == SolarPortal.Domain.Enums.ProjectStatus.SiteSurvey ||
                    stage == SolarPortal.Domain.Enums.ProjectStatus.MaterialDispatch ||
                    stage == SolarPortal.Domain.Enums.ProjectStatus.Installation ||
                    stage == SolarPortal.Domain.Enums.ProjectStatus.DCRUpdate ||
                    stage == SolarPortal.Domain.Enums.ProjectStatus.Completed;

                // Progress hints shown inside the Approve & Advance card.
                var pendingDocCount  = docs.Count(d => d.Status == SolarPortal.Domain.Enums.ApprovalStatus.Pending);
                var rejectedDocCount = docs.Count(d => d.Status == SolarPortal.Domain.Enums.ApprovalStatus.Rejected);
                var hasApprovalDoc   = docs.Any(d => d.DocumentType == SolarPortal.Domain.Enums.DocumentType.PMApprovalDocument);
            }

            @if (alreadyApproved)
            {
                <div class="card border-success">
                    <div class="card-header bg-success text-white">✓ Already Approved</div>
                    <div class="card-body">
                        <p class="mb-2">
                            PM Surya Ghar verification is <strong>complete</strong>.
                            Project has advanced to <strong>@stage.ToString().Replace("_", " ")</strong>.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(req.PmSuryaApplicationNo))
                        {
                            <p class="mb-2"><strong>PM Surya Ghar ID:</strong> <code>@req.PmSuryaApplicationNo</code></p>
                        }
                        <p class="text-muted small mb-2">
                            Approval is locked, but you can still manage the approval document(s) below.
                        </p>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">← Back to PM Surya list</a>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header bg-success text-white">Approve &amp; Advance</div>
                    <div class="card-body">
                        <p>
                            Verify all documents, then enter the PM Surya Ghar ID <strong>and</strong> attach the
                            approval document(s) the user can download. <strong>Both are required</strong> — the
                            project cannot move to the next stage without them. Approval opens
                            <strong>Meter Dispatch</strong> &amp; <strong>Site Survey</strong> together.
                            The user's mobile and email are shown at the top for quick contact.
                        </p>

                        @* Document-status hint. Approving docs one-by-one no longer hides this
                           card, so the admin needs to see at a glance where the batch stands. *@
                        @if (rejectedDocCount > 0)
                        {
                            <div class="alert alert-warning py-2 small mb-2">
                                @rejectedDocCount document(s) rejected — the user must re-upload before final approval.
                            </div>
                        }
                        else if (pendingDocCount > 0)
                        {
                            <div class="alert alert-info py-2 small mb-2">
                                @pendingDocCount document(s) still pending review.
                            </div>
                        }
                        else if (docs.Any())
                        {
                            <div class="alert alert-success py-2 small mb-2">
                                ✓ All documents approved. Enter the PM Surya Ghar ID and attach the approval document to finish.
                            </div>
                        }

                        <label class="form-label mb-1">PM Surya Ghar ID No. <span class="text-danger">*</span></label>
                        <input id="pmAppNo" class="form-control mb-2" placeholder="e.g., RJ-PMSG-2026-000123" value="@(req.PmSuryaApplicationNo ?? "")" />
                        <label class="form-label mb-1">Approval Document(s) — user downloadable <span class="text-danger">*</span></label>
                        <input id="approvalDocs" type="file" class="form-control mb-1" multiple accept=".pdf,.png,.jpg,.jpeg" />
                        @if (hasApprovalDoc)
                        {
                            <p class="text-muted small mb-2">An approval document is already attached — leave this empty to keep it.</p>
                        }
                        <textarea id="advanceNotes" class="form-control mb-2" placeholder="Optional notes"></textarea>
                        <button id="btnAdvance" class="btn btn-success w-100">Approve All &amp; Open Meter Dispatch + Site Survey</button>
                    </div>
                </div>
            }

            @* Admin approval documents can be replaced at ANY time — before or after
               final approval. Delete removes the row and its file; upload adds new
               ones, already Approved (admin ka apna upload hai, review ki zaroorat nahi). *@
            @{
                var approvalDocs = docs
                    .Where(d => d.DocumentType == SolarPortal.Domain.Enums.DocumentType.PMApprovalDocument)
                    .ToList();
            }
            <div class="card mt-3">
                <div class="card-header bg-primary text-white">📎 Admin Approval Document(s)</div>
                <div class="card-body">
                    @if (!approvalDocs.Any())
                    {
                        <p class="text-muted small mb-2">No approval document uploaded yet.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var d in approvalDocs)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <a href="javascript:void(0)" onclick="openFileModal('@d.FilePath')" style="color:#0d9488">@d.FileName</a>
                                    <button class="btn btn-sm btn-outline-danger btn-delete-doc"
                                            data-id="@d.Id" data-name="@d.FileName">🗑️</button>
                                </li>
                            }
                        </ul>
                    }
                    <label class="form-label mb-1">Upload new approval document(s)</label>
                    <input id="reUploadDocs" type="file" class="form-control mb-2" multiple accept=".pdf,.png,.jpg,.jpeg" />
                    <button id="btnReUpload" class="btn btn-primary w-100">⬆ Upload</button>
                    <p class="text-muted small mt-2 mb-0">
                        Delete an existing document and upload a replacement whenever the
                        approval paperwork changes. Uploads are saved as approved.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const token = $('input[name="__RequestVerificationToken"]').val();

$('.btn-approve').on('click', function () {
    const id = $(this).data('id');
    $.post('@Url.Action("ApproveDocument")', { docId: id, __RequestVerificationToken: token }, function (r) {
        // global toast shows r.message; just reload after a short delay
        if (r.success) { setTimeout(function () { location.reload(); }, 600); }
    });
});
$('.btn-reject').on('click', function () {
    const id = $(this).data('id');
    const remarks = prompt('Rejection reason?');
    if (remarks === null) return;
    $.post('@Url.Action("RejectDocument")', { docId: id, remarks: remarks, __RequestVerificationToken: token }, function (r) {
        if (r.success) { setTimeout(function () { location.reload(); }, 600); }
    });
});

// Delete an admin-uploaded PM approval document. The file is removed from disk
// too, so this is not reversible — confirm first.
$(document).on('click', '.btn-delete-doc', function () {
    const $btn = $(this);
    const id   = $btn.data('id');
    const name = $btn.data('name') || 'this document';
    if (!confirm('Delete "' + name + '"?\n\nThe file will be removed permanently. You can upload a new approval document afterwards.')) return;
    $btn.prop('disabled', true).text('Deleting…');
    $.post('@Url.Action("DeleteApprovalDocument")', { docId: id, __RequestVerificationToken: token }, function (r) {
        // global ajaxSuccess handler already toasts r.message
        if (r.success) { setTimeout(function () { location.reload(); }, 600); }
        else { $btn.prop('disabled', false).html('🗑️ Delete'); }
    }).fail(function () { $btn.prop('disabled', false).html('🗑️ Delete'); });
});

// Upload (or re-upload) admin approval documents — allowed even after the
// request has already been approved and advanced.
$('#btnReUpload').on('click', function () {
    const files = document.getElementById('reUploadDocs').files;
    if (!files || files.length === 0) { alert('Please choose at least one file to upload.'); return; }

    const $btn = $(this).prop('disabled', true).text('Uploading…');
    const fd = new FormData();
    fd.append('requestId', @req.Id);
    fd.append('__RequestVerificationToken', token);
    for (var i = 0; i < files.length; i++) { fd.append('files', files[i]); }

    $.ajax({
        url: '@Url.Action("UploadApprovalDocument")',
        type: 'POST',
        data: fd,
        processData: false,
        contentType: false
    }).done(function (r) {
        if (r.success) { setTimeout(function () { location.reload(); }, 600); }
        else { $btn.prop('disabled', false).text('⬆ Upload'); }
    }).fail(function () {
        $btn.prop('disabled', false).text('⬆ Upload');
    });
});

$('#btnAdvance').on('click', function () {
    // Front-end mirror of the server-side gate in ApproveAndAdvance — fail fast
    // with a pointer at the offending field instead of a round-trip toast.
    var pmId = ($('#pmAppNo').val() || '').trim();
    if (!pmId) {
        alert('PM Surya Ghar ID No. is required before approval.');
        $('#pmAppNo').focus();
        return;
    }

    var files = document.getElementById('approvalDocs').files;
    var hasExistingApprovalDoc = @(docs.Any(d => d.DocumentType == SolarPortal.Domain.Enums.DocumentType.PMApprovalDocument) ? "true" : "false");
    if ((!files || files.length === 0) && !hasExistingApprovalDoc) {
        alert('Attach at least one PM Surya Ghar approval document before approval.');
        document.getElementById('approvalDocs').focus();
        return;
    }

    if (!confirm('Approve all PM Surya Ghar docs and open Meter Dispatch + Site Survey?')) return;
    $(this).prop('disabled', true).text('Approving…');

    var fd = new FormData();
    fd.append('requestId', @req.Id);
    fd.append('notes', $('#advanceNotes').val());
    fd.append('pmSuryaApplicationNo', pmId);
    fd.append('__RequestVerificationToken', token);
    for (var i = 0; i < files.length; i++) { fd.append('approvalDocs', files[i]); }

    $.ajax({
        url: '@Url.Action("ApproveAndAdvance")',
        type: 'POST',
        data: fd,
        processData: false,
        contentType: false
    }).done(function (r) {
        // NOTE: the global ajaxSuccess handler in _Toasts.cshtml already shows
        // r.message (success/error). Do NOT alert() here or it shows twice.
        if (r.success) {
            setTimeout(function () { window.location.href = '@Url.Action("Index")'; }, 600);
        } else {
            $('#btnAdvance').prop('disabled', false).text('Approve All & Open Meter Dispatch + Site Survey');
        }
    }).fail(function () {
        // global ajaxError handler shows the error toast
        $('#btnAdvance').prop('disabled', false).text('Approve All & Open Meter Dispatch + Site Survey');
    });
});
</script>
}

@* In-page file preview modal (no new tab) *@
@await Html.PartialAsync("_FileModal")
