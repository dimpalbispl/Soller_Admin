  // Where the USER panel writes its uploads on THIS machine.
  //
  // The two panels are separate apps with separate wwwroot folders, so a member's
  // receipt / PM Surya document does not sit under the admin's own wwwroot. The
  // admin app probes a few relative layouts to find the user panel, but those
  // probes assume the two repos sit next to each other — they no longer do, so
  // startup logged "SharedUploadsPath not configured and no candidate folder
  // found" and every View / Download of a member's file fell through to the remote
  // UserPanelBaseUrl, which has no local file — hence "download nahi ho raha".
  //
  // Pointing this at the user panel's uploads folder makes both resolve from disk.
  // Development-only: the deployed appsettings on the server carries its own path.
  "SharedUploadsPath": "\\\\localhost\\Sadhna\\SolerGithub\\Solar\\SolarPortal\\SolarPortal.Web\\wwwroot\\uploads"
}
