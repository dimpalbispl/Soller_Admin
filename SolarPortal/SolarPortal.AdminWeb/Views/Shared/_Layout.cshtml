@using Microsoft.AspNetCore.Identity
@using SolarPortal.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var isInstaller = User.IsInRole("Installer");
    var roleLabel = isAdmin ? "Admin" : isInstaller ? "Installer" : "User";
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Solar Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    @*
       Bootstrap CSS — try the local libman-installed copy first. If that
       fails to load (e.g. libman restore wasn't run after deploy), the CDN
       fallback in the next line takes over. This keeps the admin design
       identical whether wwwroot/lib is present or not.
    *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          onerror="this.onerror=null;this.href='https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css'" />
    <link rel="stylesheet" href="~/css/solar-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-role="@roleLabel">

    <!-- TOP BAR -->
    <div class="topbar">
        <div class="brand">
            @* Phone only: the sidebar is hidden below 768px, so this opens it as a drawer. *@
            <button type="button" class="menu-toggle" aria-label="Open menu" aria-controls="app-sidebar" aria-expanded="false" onclick="toggleSidebar()">☰</button>
            <div class="brand-logo">☀️</div>
            <span class="brand-name">SOLAR PORTAL</span>
            <span class="brand-role">@roleLabel.ToUpper()</span>
        </div>
        <div class="top-right">
            <span class="top-user">@user?.FullName</span>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="top-btn" aria-label="Logout">⬅<span class="top-btn-text"> Logout</span></button>
            </form>
        </div>
    </div>

    <!-- LAYOUT -->
    <div class="app-layout">

        <div class="sidebar-backdrop" onclick="toggleSidebar(false)"></div>

        <!-- SIDEBAR -->
        <div class="sidebar" id="app-sidebar">
            <partial name="~/Views/Shared/_AdminSidebar.cshtml" />
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    <!-- MOBILE NAV -->
    <div class="mob-nav">
        <div class="mob-nav-inner">
            <div class="mni" onclick="location.href='@Url.Action("Index","Dashboard",new{area="SolarPanelAdmin"})'">
                <span class="mi2">📊</span><span class="ml2">Dashboard</span>
            </div>
            <div class="mni" onclick="location.href='@Url.Action("Index","Projects",new{area="SolarPanelAdmin"})'">
                <span class="mi2">🏗️</span><span class="ml2">Projects</span>
            </div>
            <div class="mni" onclick="location.href='@Url.Action("Index","PMSurya",new{area="SolarPanelAdmin"})'">
                <span class="mi2">📋</span><span class="ml2">PM Surya</span>
            </div>
            <div class="mni" onclick="location.href='@Url.Action("Index","Workers",new{area="SolarPanelAdmin"})'">
                <span class="mi2">👷</span><span class="ml2">Workers</span>
            </div>
            <div class="mni" onclick="toggleSidebar()">
                <span class="mi2">☰</span><span class="ml2">Menu</span>
            </div>
        </div>
    </div>

    <script>
        // Mobile drawer for the sidebar. Above 768px the sidebar is always shown
        // and the .open class has no effect.
        function toggleSidebar(force) {
            var sb = document.getElementById('app-sidebar');
            var open = typeof force === 'boolean' ? force : !sb.classList.contains('open');
            sb.classList.toggle('open', open);
            document.body.classList.toggle('sidebar-open', open);
            var btn = document.querySelector('.menu-toggle');
            if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') toggleSidebar(false);
        });
        // Picking a menu item navigates away; close the drawer so Back does not
        // return to a page with it still covering the screen.
        document.getElementById('app-sidebar').addEventListener('click', function (e) {
            if (e.target.closest('a')) toggleSidebar(false);
        });
    </script>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.5/sweetalert2.all.min.js"></script>
    @*
       Bootstrap JS bundle — local first, CDN fallback. The fallback is what
       keeps modals, dropdowns, tooltips etc. working when wwwroot/lib was
       stripped from a deployment zip (libman restore is the proper fix).
    *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            onerror="this.onerror=null;var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js';document.head.appendChild(s);"></script>
    <script src="~/js/solar-portal.js" asp-append-version="true"></script>
    @* Change request point 5: gives every file input marked data-photo-picker a
       Camera and a Gallery button. Loaded before the page's own scripts so a
       view can call enhancePhotoPickers() on markup it injects later. *@
    <script src="~/js/photo-picker.js" asp-append-version="true"></script>
    @* photo-picker's Camera button only reaches a phone's camera — on a desktop the
       `capture` attribute is ignored, so an admin at a PC could not photograph a
       document at all. camera-capture.js opens the webcam there instead; mark an
       input with data-camera (or call openCameraFor(input)) to get that button. *@
    <script src="~/js/camera-capture.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Reskin the SweetAlert modals to match the light theme
        if (typeof Swal !== 'undefined') {
            const _origFire = Swal.fire.bind(Swal);
            Swal.fire = function (opts, ...rest) {
                if (typeof opts === 'object' && opts !== null) {
                    opts.background = opts.background || '#ffffff';
                    opts.color      = opts.color      || '#1f2937';
                }
                return _origFire(opts, ...rest);
            };
        }
    </script>
    <partial name="_Toasts" />
</body>
</html>
