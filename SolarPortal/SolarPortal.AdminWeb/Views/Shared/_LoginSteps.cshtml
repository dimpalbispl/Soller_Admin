@*
    Step indicator for the admin sign-in wizard.
    Pass the current step number (1-4) as the model.

    It exists so the admin can see that a code is coming BEFORE they are asked
    for one — a bare OTP box with no context reads as an error page.
*@
@model int
@{
    var steps = new[] { "User ID", "Password + OTP" };
}
<div style="display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:22px;flex-wrap:wrap">
    @for (var i = 0; i < steps.Length; i++)
    {
        var n = i + 1;
        var done = n < Model;
        var here = n == Model;
        var bg = done ? "#10b981" : here ? "#047857" : "#e5e7eb";
        var fg = done || here ? "#ffffff" : "#9ca3af";

        <div style="display:flex;align-items:center;gap:6px">
            <div style="width:26px;height:26px;border-radius:50%;background:@bg;color:@fg;
                        display:flex;align-items:center;justify-content:center;
                        font-size:12px;font-weight:700;flex:none">
                @(done ? "✓" : n.ToString())
            </div>
            <span style="font-size:11.5px;font-weight:@(here ? "700" : "500");
                         color:@(here ? "#047857" : done ? "#059669" : "#9ca3af")">@steps[i]</span>
        </div>
        if (n < steps.Length)
        {
            <div style="width:18px;height:2px;background:@(done ? "#10b981" : "#e5e7eb")"></div>
        }
    }
</div>
