        <a class="sb-item @IsActive("Workers")" asp-area="SolarPanelAdmin" asp-controller="Workers" asp-action="Index">
            <span class="sbi">👷</span>Installers (INC)
        </a>
    }
</div>
<div class="sb-section">
    <div class="sb-label">Management</div>
    @if (Can("Commission"))
    {
        <a class="sb-item @IsActive("Commission")" asp-area="SolarPanelAdmin" asp-controller="Commission" asp-action="Index">
            <span class="sbi">📈</span>INC Commission
        </a>
    }
    @if (Can("Inc.Connections"))
    {
        <a class="sb-item @IsActiveAction("Inc","Connections")" asp-area="SolarPanelAdmin" asp-controller="Inc" asp-action="Connections">
            <span class="sbi">🔌</span>INC Connections
        </a>
    }
    @* Change request point 8: KYC of commission (INC) workers, approved here.
       JOB workers are salaried and are never asked for KYC. *@
    @if (Can("Inc.Kyc"))
    {
        <a class="sb-item @IsActiveAction("Inc","Kyc")" asp-area="SolarPanelAdmin" asp-controller="Inc" asp-action="Kyc">
            <span class="sbi">🪪</span>INC KYC
        </a>
    }
    @if (Can("Inc.Withdrawals"))
    {
        <a class="sb-item @IsActiveAction("Inc","Withdrawals")" asp-area="SolarPanelAdmin" asp-controller="Inc" asp-action="Withdrawals">
            <span class="sbi">🏦</span>INC Withdrawals
        </a>
    }
    @* admin -> user permission: who can open which menu. *@
    @if (Can("AdminAccess.Permissions"))
    {
        <a class="sb-item @IsActiveAction("AdminAccess", "Permissions")" asp-area="SolarPanelAdmin" asp-controller="AdminAccess" asp-action="Permissions">
            <span class="sbi">🔑</span>User Permissions
        </a>
    }
    @* Settings link hidden per spec: "Settings menu hide karo."
       The controller/route still exists for direct access by SuperAdmin if needed. *@
</div>
