@model SolarPortal.AdminWeb.ViewModels.AdminUserIdViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-logo">
        <div class="brand-logo-lg">☀️</div>
        <h1 class="auth-title">SOLAR PORTAL</h1>
        <p class="auth-sub">Step 1 of 2 — enter your User ID</p>
    </div>

    <partial name="_LoginSteps" model="1" />

    <form asp-action="Login" method="post" id="loginForm">
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size:12px;margin-bottom:8px"></div>

        <div class="fg">
            <label asp-for="UserName">User ID</label>
            <input asp-for="UserName" type="text" placeholder="Your admin User ID"
                   autocomplete="username" autofocus />
            <span asp-validation-for="UserName" class="text-danger" style="font-size:11px"></span>
        </div>

        <button type="submit" class="btn btn-p btn-full" style="margin-top:4px">
            Next →
        </button>
    </form>

    <div style="text-align:center;margin-top:16px">
        <a asp-action="ForgotPassword" style="font-size:12px;color:var(--sun)">Forgot password?</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
